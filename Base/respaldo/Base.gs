}

// PF283 (26-oct-2026): progreso por tanda en las cadenas de _ejecutarPorTandas. Un paso que puede necesitar varias tandas (hojas derivadas, /players, reenumeración)
// anota su avance con _anotarProgresoPaso_(texto, acumulado) justo antes de devolver false; el motor lo guarda en <ID>_PROGRESO_PASO y en la tanda siguiente dice
// si AVANZÓ o hubo SIN AVANCE. Al empezar cada tanda el motor escribe una línea «ESTADO al empezar» (paso por empezar o en curso). [→ Contexto_Base_Web.md §PF283]
var PROGRESO_PASO_ = null;
function _anotarProgresoPaso_(texto, acumulado) {
  PROGRESO_PASO_ = { texto: String(texto || ''), acum: Number(acumulado) };
}

// PF285 (27-oct-2026): ayuda genérica del detalle de avance de un paso (regla 0.10 de la skill), con el mismo patrón de _reenumProgreso_() (47_Migraciones.gs).
// Escribe dos líneas en el registro (acumulado de un total con porcentaje, tandas anteriores y lo que falta; y lo hecho en esta tanda) y anota el avance para el motor.
// Se llama justo antes de devolver false. etiqueta: tag del registro (sin corchetes); nombre: qué se cuenta; previas: hecho en tandas anteriores; estaTanda: hecho en esta; unidad: p. ej. 'hojas'. [→ Contexto_Base_Web.md §PF285]
function _logProgresoPaso_(etiqueta, nombre, previas, estaTanda, total, unidad) {
  var acum = previas + estaTanda;
  var pct = total > 0 ? Math.round(acum * 100 / total) : 100;
  Logger.log('[' + etiqueta + ']   ' + nombre + ': acumulado ' + acum + ' de ' + total + ' ' + unidad + ' (' + pct + ' %); en tandas anteriores: ' + previas + '; faltan ' + Math.max(total - acum, 0) + '.');
  Logger.log('[' + etiqueta + ']   ' + nombre + ': en esta tanda: ' + estaTanda + ' ' + unidad + '.');
  _anotarProgresoPaso_(nombre + ': ' + acum + ' de ' + total + ' ' + unidad, acum);
}

function _logEstadoTanda_(id, paso, total, reintento, tandasPaso, progPrevio, nombresPasos) {
  var etiq = '[' + id + '] ';
  var nombre = (nombresPasos && nombresPasos[paso]) ? ': ' + nombresPasos[paso] : '';
  if (paso === 0 && !reintento) {
    Logger.log(etiq + 'ESTADO al empezar: cadena nueva. Ningún paso cerrado; paso 1/' + total + ' POR EMPEZAR' + nombre + '.');
  } else if (reintento) {
    Logger.log(etiq + 'ESTADO al empezar: pasos cerrados ' + paso + '/' + total + '; paso ' + (paso + 1) + '/' + total + ' EN CURSO' + nombre +
      ' (la tanda anterior lo dejó incompleto; esta es la tanda ' + (tandasPaso + 1) + ' de este paso).' +
      (progPrevio && progPrevio.texto ? ' Progreso guardado al cierre de la tanda anterior: ' + progPrevio.texto + '.' : ' Ese paso no informa su avance interno.'));
  } else {
    Logger.log(etiq + 'ESTADO al empezar: pasos cerrados ' + paso + '/' + total + '; paso ' + (paso + 1) + '/' + total + ' POR EMPEZAR' + nombre +
      ' (la tanda anterior cerró el paso ' + paso + ' y se quedó sin tiempo).');
  }
}

function _logAvanceTanda_(id, paso, total, tandaDelPaso, progPrevio, prog) {
  var etiq = '[' + id + ']   Avance del paso ' + (paso + 1) + '/' + total + ' (tanda ' + tandaDelPaso + ' de este paso): ';
  if (!prog || !prog.texto) {
    Logger.log(etiq + 'este paso no informa su avance interno, así que no se puede saber si avanzó respecto a la tanda anterior; revisa las líneas del paso más arriba.');
    return;
  }
  if (!progPrevio || progPrevio.acum === null || progPrevio.acum === undefined || isNaN(Number(progPrevio.acum)) || isNaN(prog.acum)) {
    Logger.log(etiq + 'al cierre: ' + prog.texto + '. (Sin tanda anterior comparable de este paso.)');
    return;
  }
  var previo = Number(progPrevio.acum);
  if (prog.acum > previo) {
    Logger.log(etiq + 'AVANZÓ. Tanda anterior: ' + progPrevio.texto + '. Ahora: ' + prog.texto + '.');
  } else if (prog.acum === previo) {
    Logger.log(etiq + 'SIN AVANCE respecto a la tanda anterior (sigue en: ' + prog.texto + '). Si se repite en la tanda siguiente, hay algo que impide avanzar.');
  } else {
    Logger.log(etiq + 'RETROCEDIÓ. Tanda anterior: ' + progPrevio.texto + '. Ahora: ' + prog.texto + '.');
  }
}

/**
 * _ejecutarPorTandas(idEjecucion, pasos, presupuestoMs, props) [→ Contexto_Base_Web.md §B135]
 */
var INICIO_TANDA_MS_ = 0; // PF263: instante en que empezó la ejecución actual de _ejecutarPorTandas(); lo usa _reenumSinTiempo_() (47_Migraciones.gs) para repartir los 6 min entre los pasos de una misma tanda
function _ejecutarPorTandas(idEjecucion, pasos, presupuestoMs, nombreHandlerContinuacion, nombresPasos) {
  INICIO_TANDA_MS_ = Date.now();
  var props = PropertiesService.getScriptProperties();

  // VENTANA DE GUERRA PROTEGIDA (05-oct-2026): una continuacion programada antes de la ventana no debe [→ Contexto_Base_Web.md §B136]
  // PF260: una cadena que NO es la reenumeración se descarta mientras haya reenumeración en curso; y la reenumeración NUNCA se aborta por la ventana de guerra
  // (abortar borraba REENUM_PASO y obligaba a empezar de cero, sumando el delta dos veces).
  if (idEjecucion !== 'REENUM' && _reenumeracionEnCurso_()) {
    Logger.log('[' + idEjecucion + '] DESCARTADA: hay una reenumeración de temporadas en curso. La próxima corrida normal empieza de cero cuando termine.');
    props.deleteProperty(idEjecucion + '_PASO');
    props.deleteProperty(idEjecucion + '_REINTENTO');
    props.deleteProperty(idEjecucion + '_SIN_API');
    props.deleteProperty(idEjecucion + '_SIN_API_TS');
    _borrarTriggersDeContinuacion(nombreHandlerContinuacion);
    return false;
  }
  if (idEjecucion !== 'REENUM' && CFG.VENTANA_GUERRA_BLOQUEAR_OTROS && _estadoVentanaGuerra_().protegida) {
    Logger.log('[' + idEjecucion + '] ABORTADA: la ventana de guerra protegida (4:00-5:00 a.m. Lima, mas ' +
      CFG.VENTANA_GUERRA_PRE_MARGEN_MIN + ' min previos) esta activa. Se descarta el avance y la continuacion ' +
      'pendiente; la proxima corrida normal empieza de cero despues de las 5:00 a.m.');
    props.deleteProperty(idEjecucion + '_PASO');
    props.deleteProperty(idEjecucion + '_REINTENTO');
    props.deleteProperty(idEjecucion + '_SIN_API');
    props.deleteProperty(idEjecucion + '_SIN_API_TS');
    _borrarTriggersDeContinuacion(nombreHandlerContinuacion);
    _liberarLockSiNoEsRunGuerra_();
    return false;
  }

  var inicioTanda = Date.now();
  var paso = parseInt(props.getProperty(idEjecucion + '_PASO') || '0', 10);
  var reintentoMismoPaso = props.getProperty(idEjecucion + '_REINTENTO') === '1';

  // PF286 punto 14: si se subió una versión nueva de Base con la lista de pasos cambiada mientras la cadena estaba a medias, el número guardado ya no
  // apunta al mismo paso. Junto al número se guarda el nombre del paso pendiente (<ID>_PASO_NOMBRE); si no coincide con el de la lista actual, se sigue en el
  // paso con ese nombre, o se descarta el avance si ya no existe. Una cadena iniciada antes de esta versión no trae nombre guardado y sigue como siempre.
  // REENUM queda fuera: se retoma desde un índice que se puede fijar a mano y nunca se aborta (PF260).
  if (idEjecucion !== 'REENUM' && (paso > 0 || reintentoMismoPaso)) {
    var marcaGuardada = props.getProperty(idEjecucion + '_PASO_NOMBRE');
    var marcaActual = _marcaDePasoDeCadena_(pasos, nombresPasos, paso);
    if (marcaGuardada !== null && marcaGuardada !== marcaActual) {
      var pasoNuevo = _buscarPasoDeCadenaPorMarca_(nombresPasos, marcaGuardada, paso);
      if (pasoNuevo < 0) {
        Logger.log('[' + idEjecucion + '] DESCARTADA: la lista de pasos cambió y el paso que quedaba pendiente' +
          (marcaGuardada.charAt(0) === '#' ? '' : ' («' + marcaGuardada + '»)') + ' ya no está. Se descarta el avance y la continuación pendiente; la próxima corrida normal empieza de cero.');
        props.deleteProperty(idEjecucion + '_PASO');
        props.deleteProperty(idEjecucion + '_PASO_NOMBRE');
        props.deleteProperty(idEjecucion + '_REINTENTO');
        props.deleteProperty(idEjecucion + '_TANDAS_PASO');
        props.deleteProperty(idEjecucion + '_PROGRESO_PASO');
        props.deleteProperty(idEjecucion + '_SIN_API');
        props.deleteProperty(idEjecucion + '_SIN_API_TS');
        _borrarTriggersDeContinuacion(nombreHandlerContinuacion);
        _liberarLockSiNoEsRunGuerra_();
        return false;
      }
      Logger.log('[' + idEjecucion + '] La lista de pasos cambió desde la tanda anterior: el paso pendiente «' + marcaGuardada + '» pasó del lugar ' + (paso + 1) +
        ' al ' + (pasoNuevo + 1) + ' de ' + pasos.length + '. Se retoma ahí.');
      paso = pasoNuevo;
      props.setProperty(idEjecucion + '_PASO', String(paso));
    }
  }

  // PF283: contador de tandas del paso en curso y progreso que dejó la tanda anterior.
  var tandasPaso = parseInt(props.getProperty(idEjecucion + '_TANDAS_PASO') || '0', 10);
  var progPrevio = null;
  try { progPrevio = JSON.parse(props.getProperty(idEjecucion + '_PROGRESO_PASO') || 'null'); } catch (eProgPrevio) { progPrevio = null; }
  if (paso === 0 && !reintentoMismoPaso) { // cadena nueva: no heredar contadores de una cadena que se abortó
    tandasPaso = 0;
    progPrevio = null;
    props.deleteProperty(idEjecucion + '_TANDAS_PASO');
    props.deleteProperty(idEjecucion + '_PROGRESO_PASO');
  }
  if (progPrevio && progPrevio.paso !== paso) progPrevio = null;
  _logEstadoTanda_(idEjecucion, paso, pasos.length, reintentoMismoPaso, tandasPaso, progPrevio, nombresPasos);

  // IMPORTANTE: CACHE_CLAN_DATA es una variable global en memoria (no se [→ Contexto_Base_Web.md §B137]
  // PF091 (17-oct-2026): en una cadena PROGRAMADA (bandera <ID>_SIN_API) el cache se reconstruye del checkpoint aunque el paso se
  // reintente o sea el 0 (runUpdateProgramado: su primer paso, _fetchAllClanData(), pediria la API si el checkpoint tiene mas de 45 min).
  var cadenaSinApi = props.getProperty(idEjecucion + '_SIN_API') === '1';
  if (((paso > 0 && !reintentoMismoPaso) || cadenaSinApi) &&
      (typeof CACHE_CLAN_DATA === 'undefined' || CACHE_CLAN_DATA === null)) {
    // CAMBIO (05-oct-2026): si la cadena es de una version PROGRAMADA (bandera <ID>_SIN_API = 1), el cache se [→ Contexto_Base_Web.md §B138]
    if (props.getProperty(idEjecucion + '_SIN_API') === '1') {
      Logger.log('[' + idEjecucion + '] Reanudando en el paso ' + (paso + 1) + ' (version programada): se reconstruye el cache de clanes desde el checkpoint de Drive, SIN API.');
      if (!_fetchClanesBasicoSinApi()) {
        Logger.log('[' + idEjecucion + '] ABORTADA: ya no hay un checkpoint de clanes utilizable para reanudar sin API. ' +
          'Se descarta el avance; la proxima corrida programada empieza de cero.');
        props.deleteProperty(idEjecucion + '_PASO');
        props.deleteProperty(idEjecucion + '_REINTENTO');
        props.deleteProperty(idEjecucion + '_SIN_API');
        props.deleteProperty(idEjecucion + '_SIN_API_TS');
        _borrarTriggersDeContinuacion(nombreHandlerContinuacion);
        _liberarLockSiNoEsRunGuerra_();
        return false;
      }
    } else {
      Logger.log('[' + idEjecucion + '] Reanudando en el paso ' + (paso + 1) + ': cache de clanes vacío (ejecución nueva), se reconstruye la parte básica antes de continuar.');
      capturarApiClanes_(CFG.CLANES_PROGRESO_MAX_EDAD_MS, 'tandas');
    }
  }

  // PF274 (25-oct-2026): internamente `paso` es el ÍNDICE (desde 0) y es lo que se guarda en <ID>_PASO; en los textos del registro se muestra el NÚMERO (paso + 1),
  // así «paso 29/29» es el último. Tras completar el paso `paso` (índice), quedan hechos `paso` pasos. [→ Contexto_Base_Web.md §PF274]
  while (paso < pasos.length) {
  Logger.log('[' + idEjecucion + '] Ejecutando paso ' + (paso + 1) + '/' + pasos.length +
    (nombresPasos && nombresPasos[paso] ? ': ' + nombresPasos[paso] : ''));
  PROGRESO_PASO_ = null;
  var resultado = pasos[paso]();

    if (resultado === false) {
      Logger.log('[' + idEjecucion + '] Paso ' + (paso + 1) + '/' + pasos.length + ' quedó incompleto (presupuesto interno agotado). ' +
                 'Se reintenta el MISMO paso en la próxima continuación, retomando el progreso ya guardado.');
      tandasPaso++;
      _logAvanceTanda_(idEjecucion, paso, pasos.length, tandasPaso, progPrevio, PROGRESO_PASO_);
      props.setProperty(idEjecucion + '_TANDAS_PASO', String(tandasPaso));
      props.setProperty(idEjecucion + '_PROGRESO_PASO', JSON.stringify({ paso: paso, texto: PROGRESO_PASO_ ? PROGRESO_PASO_.texto : '', acum: PROGRESO_PASO_ ? PROGRESO_PASO_.acum : null }));
      _guardarPasoDeCadena_(props, idEjecucion, paso, pasos, nombresPasos);
      props.setProperty(idEjecucion + '_REINTENTO', '1');
      _refrescarLockEjecucion(idEjecucion);
      _programarContinuacion(nombreHandlerContinuacion);
      return false;
    }

    if (tandasPaso > 0) Logger.log('[' + idEjecucion + '] Paso ' + (paso + 1) + '/' + pasos.length + ' COMPLETO tras ' + (tandasPaso + 1) + ' tandas.');
    tandasPaso = 0;
    progPrevio = null;
    props.deleteProperty(idEjecucion + '_TANDAS_PASO');
    props.deleteProperty(idEjecucion + '_PROGRESO_PASO');
    props.deleteProperty(idEjecucion + '_REINTENTO');
    paso++;
    _guardarPasoDeCadena_(props, idEjecucion, paso, pasos, nombresPasos);
    _refrescarLockEjecucion(idEjecucion);

    if (paso < pasos.length && (Date.now() - inicioTanda) > presupuestoMs) {
      Logger.log('[' + idEjecucion + '] Presupuesto de tiempo agotado tras completar el paso ' + paso + '/' + pasos.length + '. Queda: paso ' + (paso + 1) + '/' + pasos.length + ' POR EMPEZAR. Se programa continuación automática en 10s.');
      _programarContinuacion(nombreHandlerContinuacion);
      return false;
    }
  }

  props.deleteProperty(idEjecucion + '_PASO');
  props.deleteProperty(idEjecucion + '_PASO_NOMBRE');
  props.deleteProperty(idEjecucion + '_REINTENTO');
  props.deleteProperty(idEjecucion + '_TANDAS_PASO');
  props.deleteProperty(idEjecucion + '_PROGRESO_PASO');
  _borrarTriggersDeContinuacion(nombreHandlerContinuacion);
  return true;
}

// PF286 punto 14: ayudas de _ejecutarPorTandas() para reconocer el paso pendiente aunque la lista de pasos cambie entre tandas (la pareja principal-continuación no aplica: no son continuaciones).

// Marca que identifica el paso en la posición `paso`: su nombre; si la cadena no tiene nombres, la cantidad de pasos de la lista (empieza con «#»).
function _marcaDePasoDeCadena_(pasos, nombresPasos, paso) {
  if (nombresPasos && nombresPasos[paso]) return String(nombresPasos[paso]);
  return '#' + pasos.length;
}

// Guarda el índice del paso pendiente y su marca. Si ya no queda ningún paso pendiente, borra la marca.
function _guardarPasoDeCadena_(props, idEjecucion, paso, pasos, nombresPasos) {
  props.setProperty(idEjecucion + '_PASO', String(paso));
  if (paso < pasos.length) props.setProperty(idEjecucion + '_PASO_NOMBRE', _marcaDePasoDeCadena_(pasos, nombresPasos, paso));
  else props.deleteProperty(idEjecucion + '_PASO_NOMBRE');
}

// Índice, en la lista actual, del paso con esa marca (si hay varios con el mismo nombre, el más cercano a `cercaDe`). -1 si no está o si la marca es solo una cantidad.
function _buscarPasoDeCadenaPorMarca_(nombresPasos, marca, cercaDe) {
  if (!nombresPasos || !marca || marca.charAt(0) === '#') return -1;
  var mejor = -1;
  for (var i = 0; i < nombresPasos.length; i++) {
    if (String(nombresPasos[i]) !== marca) continue;
    if (mejor < 0 || Math.abs(i - cercaDe) < Math.abs(mejor - cercaDe)) mejor = i;
  }
  return mejor;
}

function onEditTrigger(e) {
  if (!e || !e.range) return;

  var sh     = e.source.getActiveSheet();
  var shName = sh.getName();
  var col    = e.range.getColumn();
  var row    = e.range.getRow();

  if (row < 2) return;

  // FIX (05-ago-2026): estas 3 comparaciones usaban DC.COMENTARIO (55), [→ Contexto_Base_Web.md §B139]
  if (shName === CFG.SHEETS.DIRECTORIO && col === IC.COMENTARIO) {
    moverComentarioFila(sh, row);
  }

  if (shName === CFG.SHEETS.DIRECTORIO && col === IC.RAZON) {
    sincronizarRazonHaciaVetados(sh, row);
  }

  // FIX (25-ago-2026): antes col === 10 (número mágico). Vetados.Razón [→ Contexto_Base_Web.md §B140]
  if (shName === CFG.SHEETS.VETADOS && col === VC.RAZON) {
    sincronizarRazonHaciaDirectorio(sh, row);
  }

  // Admin/Cat_disp (12/07/2026): Directorio y Administradores ya NO [→ Contexto_Base_Web.md §B141]
  var esEdicionAdminCatDisp =
    (shName === CFG.SHEETS.DIRECTORIO && col === IC.ADMIN) ||
    (shName === CFG.SHEETS.ADMINISTRADORES && (col === AC.ADMIN || col === AC.CAT_DISP));
  if (esEdicionAdminCatDisp) {
    sincronizarEdicionAdminCatDisp(sh, row);
  }
}

