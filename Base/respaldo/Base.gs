      var promDesc = blqDesc ? _getPromediosCRParaJugador(tag, filaDescenso.semanas, ctxReal, porTagDescenso, blqDesc) : null;
      // FIX (16-sep-2026, pedido del usuario): Barcos/Miembro activo/ [→ Contexto_Base_Web.md §26B073]
