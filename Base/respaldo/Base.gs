function _leerArenaCSV() {
  var headersDefault = ['N°', 'ID', 'Name', 'RawName', 'Nombre', 'Nombre_2'];
  var csvText = _loadCSVFromDrive('Backup_Arena.csv');
  if (!csvText) return { headers: headersDefault, rows: [] };

