// ----- CurrentRiverRace por días: capturas de Drive y días del jugador -----

/**
 * Punto de entrada para las demás funciones: ataques y fame por día de UN jugador en una semana, según CurrentRiverRace.
 * totA y totF = totales de la semana (null si no se conocen). Devuelve { ataques, fameAcum, inicio, notas, hayCapturas }.
 */
function _crrDiasDeJugador_(temporada, semana, tag, totA, totF) {
  var caps = _crrCapturasDeSemana_(temporada, semana)[String(tag || '').trim()];
  var r = _crrResolverJugador_(caps || null, totA, totF);
  r.hayCapturas = !!caps;
  return r;
}

/**
 * Lee los JSON de CurrentRiverRace de una semana en los clanes Terna (CurrentRiverRace/<clan>/T-xx/S-xx) y devuelve
 * { tag: { J: [captura], ... } } (ver _crrCapturasDesdeArchivos_). Se guarda en memoria por ejecución. Solo lee.
 * Solo mira la carpeta de la semana: un archivo que siga suelto en la carpeta del clan (sin mover) no se lee.
 */
function _crrCapturasDeSemana_(temporada, semana) {
  var clave = Number(temporada) + '|' + Number(semana);
  if (_CRR_CACHE_SEMANA_[clave]) return _CRR_CACHE_SEMANA_[clave];
  var archivos = [];
  var nT = 'T-' + _pad2_(temporada), nS = 'S-' + _pad2_(semana);
  Object.keys(_SUBCARPETAS_CLAN_POR_ENDPOINT_CURRENTRIVERRACE_).forEach(function (k) {
    try {
      var carpetaClan = DriveApp.getFolderById(_SUBCARPETAS_CLAN_POR_ENDPOINT_CURRENTRIVERRACE_[k]);
      var cT = _crrSubcarpeta_(carpetaClan, nT);
      var cS = cT ? _crrSubcarpeta_(cT, nS) : null;
      if (!cS) return;
      var it = cS.getFiles();
      while (it.hasNext()) {
        var f = it.next();
        var nombre = f.getName();
        if (!_crrParsearNombre_(nombre)) continue;
        try { archivos.push({ nombre: nombre, datos: JSON.parse(f.getBlob().getDataAsString()) }); }
        catch (eJson) { Logger.log('[CRR] No se pudo leer ' + nombre + ': ' + eJson.message); }
      }
    } catch (eClan) {
      Logger.log('[CRR] No se pudo leer la carpeta de ' + k + ' (' + nT + ' ' + nS + '): ' + eClan.message);
    }
  });
  _CRR_CACHE_SEMANA_[clave] = _crrCapturasDesdeArchivos_(archivos);
  return _CRR_CACHE_SEMANA_[clave];
}

function _crrSubcarpeta_(padre, nombre) {
  var it = padre.getFoldersByName(nombre);
  return it.hasNext() ? it.next() : null;
}

/**
 * archivos = [{ nombre, datos }] con datos = JSON de /currentriverrace ya convertido en objeto.
 * Devuelve { tag: { J: [captura, ...], V: [...], S: [...], D: [...] } } con captura = { fame, usados, hoy }.
 * Un jugador puede tener dos capturas el mismo día si estuvo en dos clanes.
 */
function _crrCapturasDesdeArchivos_(archivos) {
  var porTag = {};
  (archivos || []).forEach(function (a) {
    var p = _crrParsearNombre_(a && a.nombre);
    var part = a && a.datos && a.datos.clan && a.datos.clan.participants;
    if (!p || !part) return;
    part.forEach(function (j) {
      var tag = String((j && j.tag) || '').trim();
      if (!tag) return;
      if (!porTag[tag]) porTag[tag] = {};
      if (!porTag[tag][p.letra]) porTag[tag][p.letra] = [];
      porTag[tag][p.letra].push({ fame: Number(j.fame) || 0, usados: Number(j.decksUsed) || 0, hoy: Number(j.decksUsedToday) || 0 });
    });
  });
  return porTag;
}

/** Nombre del archivo -> { temporada, semana, periodIndex, letra, off } o null. Ej.: 'T-03  S-02 P.I-11-V 17-07-2026 11.35 - Clan - currentriverrace.json'. Los días de entrenamiento (L, M, X) devuelven null. */
function _crrParsearNombre_(nombre) {
  var m = /^T-(\d+)\s+S-(\d+) P\.I-(\d+)-([LMXJVSD]) /.exec(String(nombre || ''));
  if (!m) return null;
  var off = CRR_DIAS_LETRAS.indexOf(m[4]);
  if (off < 0) return null;
  return { temporada: Number(m[1]), semana: Number(m[2]), periodIndex: Number(m[3]), letra: m[4], off: off };
}

/**
 * porDia = { J: [captura], V: [...], S: [...], D: [...] } de UN jugador (o null/{} si no hay capturas).
 * totA / totF = ataques y fame de toda la semana (null si no se conocen).
 * Devuelve { ataques: [J,V,S,D], fameAcum: [J,V,S,D], inicio: [J,V,S,D], notas: [] }; null = «sin dato».
 */
function _crrResolverJugador_(porDia, totA, totF) {
  var c = porDia || {};
  var L = CRR_DIAS_LETRAS;
  var inicio = [undefined, undefined, undefined, undefined];   // undefined = no hay captura; null = capturas que no se ponen de acuerdo
  var notas = [];
  var i, j;
  for (i = 0; i < 4; i++) {
    var lista = c[L.charAt(i)] || [];
    var vistos = {}, n = 0, v = null;
    for (j = 0; j < lista.length; j++) {
      var s = lista[j].usados - lista[j].hoy;
      if (!vistos[s]) { vistos[s] = true; n++; v = s; }
    }
    if (n > 1) { notas.push('inicio ' + L.charAt(i) + ' incoherente'); inicio[i] = null; }
    else if (n === 1) inicio[i] = v;
  }
  for (i = 0; i < 3; i++) {
    var lista2 = c[L.charAt(i)] || [];
    var completo = lista2.some(function (x) { return x.hoy === 4; });
    if ((inicio[i + 1] === undefined || inicio[i + 1] === null) && inicio[i] !== undefined && inicio[i] !== null && completo) inicio[i + 1] = inicio[i] + 4;
  }
  if (inicio[0] === undefined) inicio[0] = ((c.J && c.J.length) || (c.V && c.V.length)) ? 0 : null;

  var ataques = [null, null, null, null];
  for (i = 0; i < 3; i++) {
    var a0 = inicio[i], a1 = inicio[i + 1];
    ataques[i] = (a0 !== undefined && a0 !== null && a1 !== undefined && a1 !== null) ? a1 - a0 : null;
  }
  ataques[3] = (totA !== null && totA !== undefined && inicio[3] !== undefined && inicio[3] !== null) ? totA - inicio[3] : null;

  var fameAcum = [null, null, null, null];
  for (i = 0; i < 3; i++) {
    var v2 = null;
    (c[L.charAt(i)] || []).forEach(function (x) { if (x.hoy === 4) v2 = x.fame; });
    if (v2 === null) (c[L.charAt(i + 1)] || []).forEach(function (x) { if (x.hoy === 0) v2 = x.fame; });
    fameAcum[i] = v2;
  }
  if (totF !== null && totF !== undefined) fameAcum[3] = totF;

  return { ataques: ataques, fameAcum: fameAcum, inicio: inicio.map(function (x) { return x === undefined ? null : x; }), notas: notas };
}

/** fameAcum [J,V,S,D] (null = sin dato) -> fame por día; un día queda en null si falta su acumulado o el del día anterior. */
function _crrFameDia_(fameAcum) {
  var out = [], prev = 0;
  for (var i = 0; i < 4; i++) {
    if (fameAcum[i] === null || fameAcum[i] === undefined) { out.push(null); prev = null; continue; }
    out.push(prev === null ? null : fameAcum[i] - prev);
    prev = fameAcum[i];
  }
  return out;
}

// ----- CurrentRiverRace por días: usos de otras cadenas (cierre y totales) -----

/**
 * Para la corrección al cerrar el día (17_GuerraSheet.gs, §PF139): ataques de AYER y fame acumulada al cierre de ayer de un jugador, según
 * CurrentRiverRace. ctx = el contexto del clan (temporada propia y sectionIndex); offAyer = 0..2 (jueves a sábado). No se pasan totales
 * semanales (no se conocen aquí), así que el domingo nunca se resuelve por esta vía. Devuelve { ataquesAyer, fameAcumAyer } (null = sin dato)
 * o null si no hay capturas, si estas se contradicen o si falla la lectura de Drive. Solo lee.
 */
function _crrAyerParaCierre_(tag, ctx, offAyer) {
  try {
    if (!(offAyer >= 0 && offAyer <= 2)) return null;
    var temp = Number(ctx && ctx.temporada), sem = Number(ctx && ctx.sectionIndex) + 1;
    if (!(temp > 0) || !(sem > 0)) return null;
    var r = _crrDiasDeJugador_(temp, sem, tag, null, null);
    if (!r.hayCapturas || (r.notas && r.notas.length)) return null;
    var a = r.ataques[offAyer], f = r.fameAcum[offAyer];
    return { ataquesAyer: (a === undefined ? null : a), fameAcumAyer: (f === undefined ? null : f) };
  } catch (e) {
    Logger.log('[CRR] No se pudo consultar CurrentRiverRace para cerrar el dia (' + tag + '): ' + e.message);
    return null;
  }
}

/**
 * Para AplicarTotalesSemana_Historial (48_Herramientas_Debug.gs, §PF139): comprueba unos totales semanales (ataques y fame) contra CurrentRiverRace.
 * Devuelve null si no hay capturas, si se contradicen o si no hay ningun dato del domingo; si no, { ataquesDomingo, fameDomingo, conflicto }, con
 * conflicto = '' si todo es posible o el motivo si algun dia saldria imposible con esos totales (ataques de un dia fuera de 0 a 4, o fame de un dia
 * fuera de 0 a 900, ver _fameEsPosibleDia_()). Solo lee; no escribe nada.
 */
function _crrDomingoParaTotales_(temporada, semana, tag, totA, totF) {
  try {
    var r = _crrDiasDeJugador_(temporada, semana, tag, totA, totF);
    if (!r.hayCapturas || (r.notas && r.notas.length)) return null;
    var fd = _crrFameDia_(r.fameAcum);
    var out = { ataquesDomingo: r.ataques[3], fameDomingo: fd[3], conflicto: '' };
    if (out.ataquesDomingo === null && out.fameDomingo === null) return null;
    var nombres = ['jueves', 'viernes', 'sabado', 'domingo'];
    for (var i = 0; i < 4 && !out.conflicto; i++) {
      if (r.ataques[i] !== null && (r.ataques[i] < 0 || r.ataques[i] > 4)) out.conflicto = 'CurrentRiverRace: ' + r.ataques[i] + ' ataque(s) el ' + nombres[i];
      else if (fd[i] !== null && (fd[i] < 0 || fd[i] > 900)) out.conflicto = 'CurrentRiverRace: fame ' + fd[i] + ' el ' + nombres[i];
    }
    return out;
  } catch (e) {
    Logger.log('[CRR] No se pudo comprobar los totales (' + tag + '): ' + e.message);
    return null;
  }
}


// --- ARCHIVO: 57_ReconstruirSemanaPorDias.gs ---
/**
 * 57_ReconstruirSemanaPorDias.gs
 *
 * Reconstruye, por jugador y clan, los ataques, barcos y fame de CADA día de una semana de guerra (jueves a domingo) en
 * Backup_Guerra.csv a partir de lo registrado, del total semanal de RoyaleAPI y, si existe, de CurrentRiverRace.
 * Reemplaza a la escritura de «AplicarTotalesSemana_Historial» (que solo ponía el total en la última fila). Contexto_Base_Web.md §PF139.
 *
 * Entradas (Drive):
 *   aplicarTotalesSemanaDesdeHistorialInforme() -> SOLO INFORMA: CSV de series y CSV del plan. No escribe nada en el Backup.
 *   aplicarTotalesSemanaDesdeHistorialAplicar() -> respaldo previo, escribe, y verifica releyendo el CSV.
 *   (las dos llaman a _totSemanaPorDias_(aplicar); sus nombres se mantienen y están en 48_Herramientas_Debug.gs)
 *
 * El modelo (decisiones de la usuaria, 21-oct-2026):
 *  - Cada día es una terna (ataques, barcos, fame) de la tabla de fame (_fameTablaDia_()). No se editan por separado.
 *  - El acumulado de la semana al final del domingo es el total CERRADO de RoyaleAPI (los JSON que ya lee completarDomingoDesdeJsonRoyaleApi; una semana sin cerrar no se toca).
 *  - Cada fila registrada es un acumulado al momento de registrarla. Si el registro fue temprano, le faltan ataques o medallas: el verdadero
 *    acumulado de ese día es MAYOR que el registrado. Si no, es igual. Se sabe cuál es el caso por las diferencias:
 *    AtaquesSemana - AtaquesHoy de una fila = ataques hechos hasta el día anterior (jueves = viernes, y así).
 *  - Una fila puede traer el acumulado de un día POSTERIOR (el total puesto en la última fila que existía, como pasó en T3 S1 a S3): se prueba
 *    que cada fila corresponda a su día o a uno de los días siguientes hasta la próxima fila (primero lo menos desplazado).
 *  - Se buscan TODAS las combinaciones de ternas de los cuatro días que cumplan eso y sumen el total. Con una sola, es definitiva
 *    («Solución única»). Con varias, se elige la que menos cambia lo registrado y, a igualdad, la que reparte de domingo a jueves
 *    («Solución estimada»). Los días con la misma terna en todas las soluciones se marcan «única» aunque la semana sea ambigua.
 *  - CurrentRiverRace (módulo 56), si hay, fija los ataques y la fame de cada día que tenga dato. Si con eso no hay solución, se avisa
 *    y se reparte sin él (misma decisión de las tandas anteriores de §PF139).
 *  - Se corrigen las filas existentes que no coinciden y se CREAN las que faltan (Origen 'Reconstruido - Solución ...').
 *  - Si ningún reparto cumple los registros y el total, no se escribe y la serie queda en el informe y en Revision_Guerra.csv.
 * Reutiliza de 55_Reparar_DiasConExceso.gs la agrupación, la creación de filas, la aplicación del plan y la verificación.
 *
 * Pasadas (21-oct-2026, Contexto_Base_Web.md §PF139, tanda 5): en Apps Script no alcanza el tiempo para todas las series en una corrida. Se recorre por
 * semanas; al pasar RS_MS_LIMITE se corta al empezar otra semana y el avance queda en la propiedad RS_CURSOR_INFORME o RS_CURSOR_APLICAR. Se vuelve a
 * correr la misma función hasta que el log diga TERMINADO. Lo leído de los JSON queda 6 horas en Cache_TotalesSemana_Objetivos.csv.
 * totalesSemanaPorDiasReiniciar() borra el avance y esa caché.
 */

// ORDEN DE ESTE ARCHIVO (regla 0.9 de la skill; 28-oct-2026): primero las constantes y variables globales; luego, por partes:
//  Parte 1 — Funciones que se corren a mano
//    - Reinicio del avance y de la caché de totales (las dos que aplican la reconstrucción, aplicarTotalesSemanaDesdeHistorialInforme() y aplicarTotalesSemanaDesdeHistorialAplicar(), están en 48_Herramientas_Debug.gs)
//  Parte 2 — Funciones que no se corren a mano
//    - Entrada (Drive): _totSemanaPorDias_, que llaman las dos funciones de 48_Herramientas_Debug.gs
//    - Totales objetivo de cada semana (JSON de RoyaleAPI y su caché)
//    - Series que no se tocan y clave de semana
//    - Plan del reparto por día (planificar, resolver por niveles y comparar soluciones)
//    - Avance entre corridas
// Dentro de cada tema, en el orden en que se espera ejecutarlas. Al reordenar no se cambió el código de ninguna función.

var RS_MAX_FILAS = 2500;     // tope de filas a modificar + crear en una escritura (si se pasa, no se escribe nada)
var RS_MS_LIMITE = 240000;   // tiempo máximo desde que empieza la corrida (ms) para EMPEZAR otra semana; lo que falte se hace en la corrida siguiente (queda margen para escribir y verificar)
var RS_CACHE_ARCHIVO = 'Cache_TotalesSemana_Objetivos.csv';   // totales cerrados leidos de los JSON de RoyaleAPI (se reutilizan para no releer 231 archivos en cada corrida)
var RS_CACHE_MS = 6 * 3600 * 1000;   // vigencia de ese archivo (6 horas)
var RS_CURSOR_PROP = 'RS_CURSOR_';   // propiedad del script: ultima semana ya recorrida (sufijo INFORME o APLICAR)

var RS_NIVELES = [
  { nombre: 'estricto con AtaquesHoy y CurrentRiverRace', estricto: true, hoy: true, crr: true },
  { nombre: 'estricto con AtaquesHoy', estricto: true, hoy: true, crr: false },
  { nombre: 'estricto sin AtaquesHoy', estricto: true, hoy: false, crr: false },
  { nombre: 'relajado con AtaquesHoy', estricto: false, hoy: true, crr: false },
  { nombre: 'relajado sin AtaquesHoy', estricto: false, hoy: false, crr: false }
];

var _rsCatalogo_ = null;

// =============================================================================
// PARTE 1 — FUNCIONES QUE SE CORREN A MANO
// =============================================================================

// ---------------------------------------------------------------------------------------------------------------
// REINICIO DEL AVANCE Y DE LA CACHÉ DE TOTALES
// ---------------------------------------------------------------------------------------------------------------

/** Borra el avance de las dos funciones y el archivo de totales leidos de los JSON: la proxima corrida empieza desde cero y relee los JSON. */
function totalesSemanaPorDiasReiniciar() {
  var p = PropertiesService.getScriptProperties();
  p.deleteProperty(RS_CURSOR_PROP + 'INFORME'); p.deleteProperty(RS_CURSOR_PROP + 'APLICAR');
  try { if (_csvBuscarArchivo_(RS_CACHE_ARCHIVO)) _saveCSVToDrive(RS_CACHE_ARCHIVO, 'Creado\n'); } catch (e) { Logger.log('[Semana por dias] No se pudo vaciar ' + RS_CACHE_ARCHIVO + ': ' + e.message); }
  Logger.log('[Semana por dias] Avance borrado. La proxima corrida empieza desde la primera semana y vuelve a leer los JSON de RoyaleAPI.');
}

// =============================================================================
// PARTE 2 — FUNCIONES QUE NO SE CORREN A MANO
// =============================================================================

// ---------------------------------------------------------------------------------------------------------------
// ENTRADA (Drive)
// ---------------------------------------------------------------------------------------------------------------

function _totSemanaPorDias_(aplicar) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) { Logger.log('[Semana por dias] Hay otra ejecucion en curso; se cancela para no pisar datos. Reintentar en unos minutos.'); return; }
  try {
    var t0 = Date.now();
    var marca = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH.mm.ss');
    var csvText = _loadCSVFromDrive('Backup_Guerra.csv');
    if (!csvText) { Logger.log('[Semana por dias] No se encontro Backup_Guerra.csv; no se hace nada.'); return; }
    var parsed = _parseCSV(csvText);
    if (!parsed || parsed.length < 2) { Logger.log('[Semana por dias] Backup_Guerra.csv esta vacio; no se hace nada.'); return; }
    var encabezado = parsed[0], filas = parsed.slice(1);
    for (var a = 0; a < filas.length; a++) { while (filas[a].length < GUERRA_TOTAL_COLS) filas[a].push(''); }
    var copiaAntes = filas.map(function (r) { return r.slice(); });

    var objetivos = _rsObjetivos(filas, _rsClavesHoja());
    if (!objetivos) { Logger.log('[Semana por dias] ABORT: se agoto el tiempo leyendo los JSON de RoyaleAPI. No se escribio nada.'); return; }
    var tipoCursor = aplicar ? 'APLICAR' : 'INFORME';
    var plan = _rsPlanificar(filas, objetivos, { usarCrr: true, t0: t0, desde: _rsCursorLeer_(tipoCursor) });
    var idxDe = new Map();
    for (var q = 0; q < filas.length; q++) idxDe.set(filas[q], q);
    plan.casos.forEach(function (c) { c.ops.forEach(function (op) { if (op.existe) op.idxAntes = idxDe.get(op.fila); }); });
    var nCrear = 0, nModificar = 0, cuenta = {};
    plan.series.forEach(function (s) { nCrear += s.nCrear; nModificar += s.nMod; var k = s.clase + ' / ' + s.accion; cuenta[k] = (cuenta[k] || 0) + 1; });
    var resumenSeries = Object.keys(cuenta).sort().map(function (k) { return k + ': ' + cuenta[k]; }).join(' | ');

    var nombresCsv = [];
    var series = [['Temporada', 'Semana', 'Tag', 'Nombre', 'Clan', 'Filas existentes', 'Total RoyaleAPI ataques/barcos/fame', 'Nivel', 'Soluciones', 'Clase', 'Accion', 'Filas a modificar', 'Filas a crear', 'Notas']];
    plan.series.forEach(function (s) {
      var g = s.grupo;
      series.push([g.temporada, g.semana, g.tag, g.nombre, g.clan, s.patron, s.tot.a + '/' + s.tot.b + '/' + s.tot.f, s.nivel, s.soluciones, s.clase, s.accion, s.nMod, s.nCrear, s.notas]);
    });
    if (!aplicar && series.length > 1) {
      var nomSeries = 'AplicarTotalesSemana_Historial ' + marca + ' (informe).csv';
      _saveCSVToDrive(nomSeries, _encodeCSVInforme(series)); nombresCsv.push(nomSeries);
    }
    var detalle = [['Temporada', 'Semana', 'Tag', 'Nombre', 'Clan', 'Clase', 'Dia', 'PeriodIndex', 'Accion',
      'AtaquesHoy anterior', 'AtaquesHoy nuevo', 'AtaquesSemana anterior (acumulado)', 'AtaquesSemana nueva (acumulado)',
      'Fame del dia anterior', 'Fame del dia nueva', 'Fame anterior (acumulado)', 'Fame nueva (acumulado)',
      'Barcos del dia anterior', 'Barcos del dia nuevo', 'Barcos anterior (acumulado)', 'Barcos nuevo (acumulado)',
      'Origen anterior', 'Origen nuevo', 'Solucion']];
    plan.casos.forEach(function (c) {
      var g = c.grupo;
      c.ops.forEach(function (op) {
        var an = op.ant;
        detalle.push([g.temporada, g.semana, g.tag, g.nombre, g.clan, c.clase, EXC_DIAS_LETRAS.charAt(op.dia), (Number(g.semana) - 1) * 7 + 3 + op.dia,
          !op.existe ? 'Crear' : (op.sinCambio ? 'Sin cambio' : 'Modificar'), an ? an.hoy : '', op.nuevo.hoy, an ? an.sem : '', op.nuevo.sem,
          op.antDia ? op.antDia.f : '', op.nuevo.fameDia, an ? an.fame : '', op.nuevo.fame,
          op.antDia ? op.antDia.b : '', op.nuevo.barcosDia, an ? an.barcos : '', op.nuevo.barcos,
          an ? an.origen : '', op.nuevo.origen, op.estimadoDia ? 'estimada (varias ternas validas)' : 'unica']);
      });
    });
    var nomDetalle = 'AplicarTotalesSemana_Historial ' + marca + ' (' + (aplicar ? 'aplicado' : 'plan') + ').csv';
    if (detalle.length > 1) { _saveCSVToDrive(nomDetalle, _encodeCSVInforme(detalle)); nombresCsv.push(nomDetalle); }

    var verificacion = '', revisionTxt = '', avanzar = true;
    if (aplicar && (nCrear + nModificar) > RS_MAX_FILAS) {
      avanzar = false;
      verificacion = 'NO SE ESCRIBIO NADA: ' + (nCrear + nModificar) + ' fila(s) a modificar o crear pasan el tope de ' + RS_MAX_FILAS + '. Revisar el CSV del plan (corre primero el informe).';
    } else if (aplicar && plan.casos.length > 0) {
      _saveCSVToDrive('Backup_Guerra ANTES de aplicar TotalesSemanaDesdeHistorial ' + marca + '.csv', csvText);
      var res = _excDiasAplicarPlan(filas, plan);
      _saveCSVToDrive('Backup_Guerra.csv', _encodeCSV([encabezado].concat(filas)));
      var problemas = [];
      var despues = _loadCSVFromDrive('Backup_Guerra.csv');
      var parsedDespues = despues ? _parseCSV(despues) : null;
      if (!parsedDespues || parsedDespues.length < 2) {
        problemas.push('No se pudo releer Backup_Guerra.csv');
      } else {
        var filasDespues = parsedDespues.slice(1);
        for (var b = 0; b < filasDespues.length; b++) { while (filasDespues[b].length < GUERRA_TOTAL_COLS) filasDespues[b].push(''); }
        problemas = _excDiasVerificar(copiaAntes, filasDespues, plan, res.creadas);
      }
      if (problemas.length) avanzar = false;
      verificacion = problemas.length
        ? 'VERIFICACION FALLO (' + problemas.length + '): ' + problemas.slice(0, 5).join('; ') + '. Restaurar con el respaldo "Backup_Guerra ANTES de aplicar TotalesSemanaDesdeHistorial ' + marca + '.csv".'
        : 'Verificacion OK (' + res.modificadas + ' fila(s) modificadas, ' + res.creadas + ' creadas).';
      var entradas = [];
      plan.omitidos.forEach(function (o) {
        if (!o.alarma) return;
        entradas.push({ temporada: o.grupo.temporada, semana: o.grupo.semana, tag: o.grupo.tag, nombre: o.grupo.nombre, tipo: 'alarma',
          motivo: 'totales semanales: no se escribio', detalle: o.grupo.clan + ': ' + o.motivo });
      });
      if (entradas.length) { var rr = _registrarRevisionGuerra_(entradas); revisionTxt = 'Revision_Guerra.csv: ' + rr.nuevas + ' nuevas, ' + rr.actualizadas + ' actualizadas. '; }
    }
    var avance = '';
    if (avanzar) {
      _rsCursorGuardar_(tipoCursor, plan);
      avance = plan.semanas.length ? 'Semanas de esta pasada: ' + plan.semanas[0] + ' a ' + plan.semanas[plan.semanas.length - 1] + ' (' + plan.semanas.length + '). ' : 'No habia semanas por recorrer. ';
      avance += plan.terminado
        ? 'TERMINADO: ya se recorrieron todas las semanas; la proxima corrida empieza otra vez desde el principio. '
        : 'FALTAN ' + plan.pendientes + ' serie(s) en ' + plan.semanasPendientes + ' semana(s): vuelve a correr la misma funcion para seguir. ';
    } else {
      avance = 'El avance NO se guardo: al volver a correr se repite esta misma tanda de semanas. ';
    }
    Logger.log('[Semana por dias] ' + (aplicar ? 'APLICAR' : 'SOLO INFORMAR') + ' (' + Math.round((Date.now() - t0) / 1000) + ' s). Backup_Guerra.csv: ' + filas.length + ' filas. ' + avance +
      'Series del informe: ' + plan.series.length + ' (' + resumenSeries + '). Filas a modificar: ' + nModificar + ', a crear: ' + nCrear + '. ' + revisionTxt +
      (verificacion ? verificacion + ' ' : '') + (nombresCsv.length ? 'Detalle en Drive: ' + nombresCsv.join(' y ') + '.' : 'Nada que escribir.') +
      (aplicar ? '' : ' (No se escribio nada en el Backup ni en Guerra.)'));
  } finally {
    lock.releaseLock();
  }
}

// ---------------------------------------------------------------------------------------------------------------
// TOTALES OBJETIVO DE CADA SEMANA (JSON de RoyaleAPI y su caché de 6 horas)
// ---------------------------------------------------------------------------------------------------------------

/**
 * Objetivos = una serie (jugador, clan, temporada, semana) por cada total semanal CERRADO de los JSON de RoyaleAPI de los jugadores que aparecen en el
 * Backup (mismo origen que completarDomingoDesdeJsonRoyaleApi: _cdjCargarRegistrosJsonDrive_ y _cdjIndexarRegistrosJson_), con o sin filas en el Backup.
 * Cada objetivo trae omitir (texto) si no se puede usar: JSON sin cerrar, JSON inconsistente, sin total de barcos o serie de la hoja Guerra.
 * Devuelve null si se agotó el tiempo leyendo los JSON (no se escribe nada).
 */
function _rsObjetivos(filas, claveHoja) {
  var objetivos = _rsObjetivosDeCache_();
  if (!objetivos) {
    objetivos = _rsObjetivosDeJson_(filas);
    if (!objetivos) return null;
    _rsObjetivosGuardarCache_(objetivos);
  }
  objetivos.forEach(function (ob) {
    if (!ob.omitir && claveHoja && claveHoja[ob.clave]) ob.omitir = 'SERIE_EN_LA_HOJA_GUERRA (no se toca)';
  });
  objetivos.sort(function (a, b) {
    return (_rsClaveSem_(a.temporada, a.semana) - _rsClaveSem_(b.temporada, b.semana)) || (a.clan < b.clan ? -1 : (a.clan > b.clan ? 1 : 0)) || (a.tag < b.tag ? -1 : (a.tag > b.tag ? 1 : 0));
  });
  return objetivos;
}

/** Devuelve los objetivos guardados si tienen menos de 6 horas; si no, null (hay que leer los JSON). */
function _rsObjetivosDeCache_() {
  try {
    var txt = _loadCSVFromDrive(RS_CACHE_ARCHIVO);
    if (!txt) return null;
    var rows = _parseCSV(txt);
    if (!rows || rows.length < 2) return null;
    var creado = Number(rows[1][0]);
    if (!(creado > 0) || Date.now() - creado > RS_CACHE_MS) return null;
    var num = function (v) { return (v === '' || v === undefined || v === null) ? null : Number(v); };
    var out = [];
    for (var i = 1; i < rows.length; i++) {
      var r = rows[i];
      var ob = { temporada: Number(r[1]), semana: Number(r[2]), tag: String(r[3]), nombre: '', clan: String(r[4]),
        jsonAtaques: num(r[5]), jsonFame: num(r[6]), jsonBarcos: num(r[7]), omitir: String(r[8] || '') };
      ob.clave = tot_clave_(ob.tag, ob.temporada, ob.semana, ob.clan);
      out.push(ob);
    }
    Logger.log('[Semana por dias] Totales de los JSON tomados de ' + RS_CACHE_ARCHIVO + ' (' + out.length + ' series, de hace ' + Math.round((Date.now() - creado) / 60000) + ' min).');
    return out;
  } catch (e) { Logger.log('[Semana por dias] No se pudo leer ' + RS_CACHE_ARCHIVO + ': ' + e.message); return null; }
}

/** Lee los JSON de RoyaleAPI de Drive (lento: unos 160 s). Devuelve null si se agoto el tiempo. No aplica lo de la hoja Guerra (eso se hace despues, siempre al dia). */
function _rsObjetivosDeJson_(filas) {
  var tagsSet = {};
  filas.forEach(function (f) {
    if (String(f[GC.ETAPA - 1] || '').trim() !== 'Guerra') return;
    var tg = String(f[GC.TAG - 1] || '').trim().toUpperCase();
    if (tg) tagsSet[tg] = true;
  });
  var lectura = _cdjCargarRegistrosJsonDrive_(tagsSet, COMPLETAR_DOMINGO_JSON_PRESUPUESTO_LECTURA_MS);
  if (!lectura.ok) return null;
  var indice = _cdjIndexarRegistrosJson_(lectura.porTag), objetivos = [];
  Object.keys(indice.series).sort().forEach(function (k) {
    var p = k.split('|');
    var js = _cdjJsonDeSerie_(indice.series[k]);
    var ob = { temporada: Number(p[2]), semana: Number(p[3]), tag: tot_tag_(p[0]), nombre: '', clan: tot_clan_(p[1]),
      jsonAtaques: js.ataques, jsonFame: js.fame, jsonBarcos: js.barcos, omitir: '' };
    ob.clave = tot_clave_(ob.tag, ob.temporada, ob.semana, ob.clan);
    if (js.estado === 'json_inconsistente') ob.omitir = 'JSON_INCONSISTENTE';
    else if (js.estado !== 'ok') return;
    else if (!js.cerrado) ob.omitir = 'JSON_SIN_CERRAR';
    else if (js.barcos === null) ob.omitir = 'JSON_SIN_TOTAL_DE_BARCOS';
    objetivos.push(ob);
  });
  return objetivos;
}

/** Totales leidos de los JSON, guardados en Drive (un CSV). Sirve 6 horas: las corridas siguientes ya no releen los 231 archivos. */
function _rsObjetivosGuardarCache_(objetivos) {
  try {
    var ahora = String(Date.now());
    var filas = [['Creado', 'Temporada', 'Semana', 'Tag', 'Clan', 'Ataques', 'Fame', 'Barcos', 'Omitir']];
    objetivos.forEach(function (ob) {
      filas.push([ahora, ob.temporada, ob.semana, ob.tag, ob.clan,
        ob.jsonAtaques === null || ob.jsonAtaques === undefined ? '' : ob.jsonAtaques,
        ob.jsonFame === null || ob.jsonFame === undefined ? '' : ob.jsonFame,
        ob.jsonBarcos === null || ob.jsonBarcos === undefined ? '' : ob.jsonBarcos, ob.omitir]);
    });
    _saveCSVToDrive(RS_CACHE_ARCHIVO, _encodeCSV(filas));
  } catch (e) { Logger.log('[Semana por dias] No se pudo guardar ' + RS_CACHE_ARCHIVO + ': ' + e.message); }
}

// ---------------------------------------------------------------------------------------------------------------
// SERIES QUE NO SE TOCAN Y CLAVE DE SEMANA
// ---------------------------------------------------------------------------------------------------------------

/** Claves (tag|temporada|semana|clan) de las series que tienen filas en la hoja Guerra (temporada vigente): esas no se tocan aqui. */
function _rsClavesHoja() {
  var set = {};
  try {
    var sh = _getSs().getSheetByName(CFG.SHEETS.GUERRA);
    if (!sh || sh.getLastRow() < 2) return set;
    var datos = sh.getRange(2, 1, sh.getLastRow() - 1, GUERRA_TOTAL_COLS).getValues();
    datos.forEach(function (f) {
      if (String(f[GC.ETAPA - 1] || '').trim() !== 'Guerra') return;
      set[tot_clave_(tot_tag_(f[GC.TAG - 1]), tot_num_(f[GC.TEMPORADA - 1]), tot_num_(f[GC.SEMANA - 1]), tot_clan_(f[GC.CLAN - 1]))] = true;
    });
  } catch (e) { Logger.log('[Semana por dias] No se pudo leer la hoja Guerra: ' + e.message); }
  return set;
}

/** Clave numerica para ordenar y comparar semanas: temporada * 1000 + semana. */
function _rsClaveSem_(temporada, semana) { return Number(temporada) * 1000 + Number(semana); }

// ---------------------------------------------------------------------------------------------------------------
// PLAN DEL REPARTO POR DÍA
// ---------------------------------------------------------------------------------------------------------------

/**
 * Planifica la escritura. NO modifica filas. objetivos = [{ temporada, semana, tag, nombre, clan, jsonAtaques, jsonFame, jsonBarcos, omitir }]
 * (omitir = motivo de texto si el Historial no confirma el total). opciones = { usarCrr, t0 }.
 * Devuelve { casos: [{ grupo, clase, estimado, ops, finalAntes }], omitidos: [{ grupo, clase, motivo, alarma }], series: [...] } (mismo formato de ops que
 * _excDiasPlanificar(), para reutilizar _excDiasAplicarPlan() y _excDiasVerificar()).
 */
function _rsPlanificar(filas, objetivos, opciones) {
  opciones = opciones || {};
  var grupos = _excDiasAgrupar(filas), porClave = {}, porSemana = {};
  Object.keys(grupos).forEach(function (k) {
    var g = grupos[k];
    porClave[tot_clave_(tot_tag_(g.tag), tot_num_(g.temporada), tot_num_(g.semana), tot_clan_(g.clan))] = g;
    var ks = g.temporada + '|' + g.semana + '|' + g.tag;
    if (!porSemana[ks]) porSemana[ks] = [];
    porSemana[ks].push(g);
  });
  var plan = { casos: [], omitidos: [], series: [], semanas: [], pendientes: 0, semanasPendientes: 0, cursor: null, terminado: true };
  var t0 = opciones.t0 || Date.now();
  var desde = Number(opciones.desde) || 0, semActual = null, parado = false, pendSet = {};

  objetivos.forEach(function (ob) {
    // Se recorre por semanas (ya vienen ordenadas): la lectura de CurrentRiverRace de cada semana se hace una sola vez. Si se acaba el tiempo
    // se corta SOLO al empezar otra semana y se guarda hasta donde se llego; la siguiente corrida sigue desde ahi.
    var ks = _rsClaveSem_(ob.temporada, ob.semana);
    if (ks <= desde) return;
    if (parado) { plan.pendientes++; pendSet[ks] = true; return; }
    if (ks !== semActual) {
      if (semActual !== null && Date.now() - t0 > RS_MS_LIMITE) { parado = true; plan.pendientes++; pendSet[ks] = true; return; }
      semActual = ks;
      plan.semanas.push('T' + ob.temporada + ' S' + ob.semana);
    }
    var clave = tot_clave_(ob.tag, ob.temporada, ob.semana, ob.clan);
    var g = porClave[clave] || { temporada: String(ob.temporada), semana: String(ob.semana), tag: ob.tag, clan: ob.clan, nombre: ob.nombre || '', dias: {} };
    var patron = Object.keys(g.dias).map(Number).sort(function (a, b) { return a - b; }).map(function (o) { return EXC_DIAS_LETRAS.charAt(o); }).join('');
    var tot = { a: ob.jsonAtaques, b: ob.jsonBarcos, f: ob.jsonFame };
    var serie = { grupo: g, ob: ob, patron: patron, tot: tot, clase: '', nivel: '', soluciones: '', accion: '', nMod: 0, nCrear: 0, notas: '' };
    plan.series.push(serie);
    var omitir = function (motivo, alarma) {
      serie.clase = 'omitida'; serie.accion = 'OMITIDA'; serie.notas = motivo;
      plan.omitidos.push({ grupo: g, clase: 'omitida', motivo: motivo, alarma: !!alarma });
    };
    if (ob.omitir) { omitir(ob.omitir, false); return; }
    if (tot.a > 16 || tot.a < 0) { omitir('total de ataques fuera de 0 a 16 (' + tot.a + ')', true); return; }

    var crr = opciones.usarCrr === false ? null : _rsCrrRestricciones(ob.temporada, ob.semana, ob.tag, tot);
    var res = _rsResolver(g.dias, tot, crr);
    if (res.nSol === 0) {
      omitir('ningun reparto de ternas cumple los registros y el total de RoyaleAPI (' + tot.a + '/' + tot.b + '/' + tot.f + ')', true);
      return;
    }
    serie.nivel = res.nivel; serie.soluciones = res.nSol;
    var notas = [];
    if (res.crrIgnorado) { notas.push('CurrentRiverRace no cuadra con los registros y el total: no se uso'); Logger.log('[Semana por dias] AVISO ' + ob.tag + ' T' + ob.temporada + ' S' + ob.semana + ': CurrentRiverRace no cuadra; se repartio sin el.'); }
    if (res.desplazadas) notas.push('fila(s) con el acumulado de un dia posterior: ' + res.desplazadas);
    if (res.nivel.indexOf('sin AtaquesHoy') >= 0) notas.push('AtaquesHoy no cuadra con los acumulados: no se uso');
    if (res.nivel.indexOf('relajado') === 0) notas.push('nivel relajado: se acepto que una fila con todos sus ataques tuviera barcos o fame mayores (revisar)');

    var reg = _excDiasRegistradoPorDia(g.dias), sol = res.mejor, cumA = 0, cumB = 0, cumF = 0, ops = [], estimado = false;
    for (var d = 0; d < 4; d++) {
      var e = sol[d];
      cumA += e.n; cumB += e.b; cumF += e.f;
      var fila = g.dias[d] || null, estDia = res.porDia[d] > 1;
      if (estDia) estimado = true;
      ops.push({ dia: d, existe: !!fila, fila: fila, estimadoDia: estDia,
        ant: fila ? { hoy: _excDiasNum(fila[GC.ATAQUES_HOY - 1]), sem: _excDiasNum(fila[GC.ATAQUES_SEM - 1]), fame: _excDiasNum(fila[GC.FAME - 1]), barcos: _excDiasNum(fila[GC.BARCOS - 1]), origen: String(fila[GC.ORIGEN - 1] || '') } : null,
        antDia: reg[d] || null,
        nuevo: { hoy: e.n, sem: cumA, fame: cumF, barcos: cumB, fameDia: e.f, barcosDia: e.b, origen: '' } });
    }
    // Comprobacion entre clanes: tope de 4 por dia y de 16 por semana sumando los demas clanes del jugador.
    var otros = (porSemana[g.temporada + '|' + g.semana + '|' + g.tag] || []).filter(function (o) { return o.clan !== g.clan; });
    var excede = '';
    ops.forEach(function (op) {
      var suma = op.nuevo.hoy;
      otros.forEach(function (o) { if (o.dias[op.dia]) suma += _excDiasNum(o.dias[op.dia][GC.ATAQUES_HOY - 1]); });
      if (suma > 4) excede = 'el dia ' + EXC_DIAS_LETRAS.charAt(op.dia) + ' quedaria con ' + suma + ' ataques sumando clanes';
    });
    var semanaOtros = 0;
    otros.forEach(function (o) { semanaOtros += _excDiasFinalDe(o.dias).a; });
    if (!excede && cumA + semanaOtros > 16) excede = 'la semana quedaria con ' + (cumA + semanaOtros) + ' ataques sumando clanes';
    if (excede) { omitir(excede, true); return; }

    ops.forEach(function (op) {
      op.nuevo.origen = _excDiasOrigenNuevo(op.existe ? op.ant.origen : '', op.existe, op.estimadoDia);
      if (op.existe && op.ant.hoy === op.nuevo.hoy && op.ant.sem === op.nuevo.sem && op.ant.fame === op.nuevo.fame && op.ant.barcos === op.nuevo.barcos) {
        op.sinCambio = true; op.nuevo.origen = op.ant.origen;
      }
      if (!op.existe) serie.nCrear++; else if (!op.sinCambio) serie.nMod++;
    });
    serie.clase = res.nSol === 1 ? 'unica' : 'estimada';
    serie.notas = notas.join('; ');
    if (serie.nMod === 0 && serie.nCrear === 0) { serie.accion = 'Sin cambios'; return; }
    serie.accion = 'Escribir';
    plan.casos.push({ grupo: g, clase: serie.clase, estimado: estimado, ops: ops, finalAntes: { a: tot.a, b: tot.b, f: tot.f } });
  });
  plan.cursor = semActual;
  plan.terminado = !parado;
  plan.semanasPendientes = Object.keys(pendSet).length;
  return plan;
}

/** Restricciones de CurrentRiverRace por día ([{ n, f }|null] x 4) o null si no hay capturas, se contradicen o no se puede leer Drive. */
function _rsCrrRestricciones(temporada, semana, tag, tot) {
  if (typeof _crrDiasDeJugador_ !== 'function') return null;
  try {
    var r = _crrDiasDeJugador_(temporada, semana, tag, tot.a, tot.f);
    if (!r || !r.hayCapturas || (r.notas && r.notas.length)) return null;
    var fd = _crrFameDia_(r.fameAcum), out = [], hay = false;
    for (var d = 0; d < 4; d++) {
      var n = (r.ataques[d] === undefined) ? null : r.ataques[d];
      var f = (fd[d] === undefined) ? null : fd[d];
      if (n === null && f === null) { out.push(null); continue; }
      out.push({ n: n, f: f }); hay = true;
    }
    return hay ? out : null;
  } catch (e) {
    Logger.log('[Semana por dias] No se pudo leer CurrentRiverRace (' + tag + '): ' + e.message + '. Se sigue sin el.');
    return null;
  }
}

/**
 * Resuelve una serie: de lo más estricto a lo más relajado, y con las filas en su día antes que desplazadas, la primera
 * forma que tenga solución. Devuelve { nSol, porDia, mejor, nivel, desplazadas, crrIgnorado } o { nSol: 0 } si no hay ninguna.
 */
function _rsResolver(dias, tot, crr) {
  var rec = _rsRegistros(dias), mp = _rsMapeos(rec);
  for (var n = 0; n < RS_NIVELES.length; n++) {
    var nivel = RS_NIVELES[n];
    if (nivel.crr && !crr) continue;
    for (var c = 0; c < mp.combos.length; c++) {
      var mapeo = { offs: mp.offs, m: mp.combos[c] };
      var res = _rsResolverNivel(tot, rec, mapeo, nivel.crr ? crr : null, nivel);
      if (res.nSol > 0) {
        var despl = [];
        mapeo.offs.forEach(function (o, i) { if (mapeo.m[i] !== o) despl.push(EXC_DIAS_LETRAS.charAt(o) + '->' + EXC_DIAS_LETRAS.charAt(mapeo.m[i])); });
        res.nivel = nivel.nombre; res.desplazadas = despl.join(' '); res.crrIgnorado = !!crr && !nivel.crr;
        return res;
      }
    }
  }
  return { nSol: 0, porDia: [0, 0, 0, 0], mejor: null, nivel: '', desplazadas: '', crrIgnorado: !!crr };
}

/** Lo registrado por día (acumulados de la fila): arreglo de 4 con { a, b, f, hoy } o null. */
function _rsRegistros(dias) {
  var rec = [null, null, null, null];
  for (var d = 0; d < 4; d++) {
    var r = dias[d];
    if (r) rec[d] = { a: _excDiasNum(r[GC.ATAQUES_SEM - 1]), b: _excDiasNum(r[GC.BARCOS - 1]), f: _excDiasNum(r[GC.FAME - 1]), hoy: _excDiasNum(r[GC.ATAQUES_HOY - 1]) };
  }
  return rec;
}

/**
 * A qué día puede corresponder cada fila registrada: a su propio día o a uno de los siguientes hasta la próxima fila.
 * Devuelve { offs: [días con fila], combos: [[día al que corresponde cada fila]] } con los menos desplazados primero.
 */
function _rsMapeos(rec) {
  var offs = [];
  for (var d = 0; d < 4; d++) if (rec[d]) offs.push(d);
  var combos = [[]];
  offs.forEach(function (d, i) {
    var hi = (i + 1 < offs.length) ? offs[i + 1] - 1 : 3;
    var nuevos = [];
    combos.forEach(function (c) { for (var m = d; m <= hi; m++) nuevos.push(c.concat([m])); });
    combos = nuevos;
  });
  var desp = function (c) { var s = 0; for (var i = 0; i < c.length; i++) s += c[i] - offs[i]; return s; };
  combos.sort(function (u, v) { return desp(u) - desp(v); });
  return { offs: offs, combos: combos };
}

/**
 * Busca todas las soluciones (t0, t1, t2, t3) de un nivel y una correspondencia fila -> día.
 *  tot = { a, b, f } total de la semana; rec = _rsRegistros(); mapeo = { offs, m: [día al que corresponde cada fila] };
 *  restr = restricciones de CurrentRiverRace por día ([{ n, f }|null] o null).
 * Devuelve { nSol, porDia: [cantidad de ternas distintas por día], mejor: [4 ternas] | null }.
 */
function _rsResolverNivel(tot, rec, mapeo, restr, nivel) {
  var cat = _rsCatalogo();
  var cand = [], sets = [], d, i;
  for (d = 0; d < 4; d++) {
    var rs = restr ? restr[d] : null, lst = [], st = {};
    for (i = 0; i < cat.lista.length; i++) {
      var e = cat.lista[i];
      if (rs && ((rs.n !== null && e.n !== rs.n) || (rs.f !== null && e.f !== rs.f))) continue;
      lst.push(e); st[e.k] = true;
    }
    cand.push(lst); sets.push(st);
  }
  var rowAt = [null, null, null, null], K = [null, null, null, tot.a];
  for (i = 0; i < mapeo.offs.length; i++) {
    var dEn = mapeo.offs[i], dMap = mapeo.m[i], r = rec[dEn];
    rowAt[dMap] = r;
    // Ataques hechos hasta el dia anterior = AtaquesSemana - AtaquesHoy (solo si la fila corresponde a su propio dia).
    if (nivel.hoy && dMap === dEn && dEn >= 1 && r.hoy <= r.a) {
      var v = r.a - r.hoy;
      if (v <= 4 * dEn && K[dEn - 1] === null) K[dEn - 1] = v;
    }
  }
  function chk(dia, a, b, f) {
    if (K[dia] !== null && a !== K[dia]) return false;
    var rr = rowAt[dia];
    if (!rr) return true;
    if (a < rr.a || b < rr.b || f < rr.f) return false;
    if (nivel.estricto && a === rr.a && (b !== rr.b || f !== rr.f)) return false;
    return true;
  }
  var vacio = { nSol: 0, porDia: [0, 0, 0, 0], mejor: null };
  if (!chk(3, tot.a, tot.b, tot.f)) return vacio;

  var nSol = 0, mejor = null, mejorCosto = Infinity, claves = [{}, {}, {}, {}];
  var l0 = cand[0], l1 = cand[1], l3 = cand[3], s2 = sets[2];
  for (var i3 = 0; i3 < l3.length; i3++) {
    var t3 = l3[i3];
    var a2 = tot.a - t3.n, b2 = tot.b - t3.b, f2 = tot.f - t3.f;           // acumulado al cierre del sabado
    if (a2 < 0 || b2 < 0 || f2 < 0 || !chk(2, a2, b2, f2)) continue;
    for (var i0 = 0; i0 < l0.length; i0++) {
      var t0 = l0[i0];
      if (t0.n > a2 || t0.b > b2 || t0.f > f2 || !chk(0, t0.n, t0.b, t0.f)) continue;
      for (var i1 = 0; i1 < l1.length; i1++) {
        var t1 = l1[i1];
        var a1 = t0.n + t1.n, b1 = t0.b + t1.b, f1 = t0.f + t1.f;           // acumulado al cierre del viernes
        if (a1 > a2 || b1 > b2 || f1 > f2 || !chk(1, a1, b1, f1)) continue;
        var k2 = (a2 - a1) + ',' + (b2 - b1) + ',' + (f2 - f1);
        if (!s2[k2]) continue;
        nSol++;
        claves[0][t0.k] = true; claves[1][t1.k] = true; claves[2][k2] = true; claves[3][t3.k] = true;
        // Costo = campos de las filas registradas que cambian.
        var costo = 0;
        for (i = 0; i < mapeo.offs.length; i++) {
          var dd = mapeo.offs[i], rg = rec[dd];
          var ca = dd === 0 ? t0.n : (dd === 1 ? a1 : (dd === 2 ? a2 : tot.a));
          var cb = dd === 0 ? t0.b : (dd === 1 ? b1 : (dd === 2 ? b2 : tot.b));
          var cf = dd === 0 ? t0.f : (dd === 1 ? f1 : (dd === 2 ? f2 : tot.f));
          costo += (ca !== rg.a ? 1 : 0) + (cb !== rg.b ? 1 : 0) + (cf !== rg.f ? 1 : 0);
        }
        if (costo > mejorCosto) continue;
        var p = k2.split(',');
        var cand4 = [t0, t1, { n: Number(p[0]), b: Number(p[1]), f: Number(p[2]), k: k2 }, t3];
        if (mejor === null || costo < mejorCosto || _rsMenor(cand4, mejor)) { mejor = cand4; mejorCosto = costo; }
      }
    }
  }
  return { nSol: nSol, porDia: claves.map(function (c) { return Object.keys(c).length; }), mejor: mejor };
}

/** Las 77 ternas posibles de un día: { lista: [{ n, b, f, k }], claves: { 'n,b,f': true } }. */
function _rsCatalogo() {
  if (_rsCatalogo_) return _rsCatalogo_;
  var o = _excDiasOpciones(), lista = [], claves = {};
  for (var i = 0; i < o.length; i++) {
    var e = { n: o[i][0], b: o[i][1], f: o[i][2], k: o[i][0] + ',' + o[i][1] + ',' + o[i][2] };
    lista.push(e); claves[e.k] = true;
  }
  _rsCatalogo_ = { lista: lista, claves: claves };
  return _rsCatalogo_;
}

/** ¿La solución a es mejor que b a igualdad de cambios? Reparte de domingo a jueves: más ataques, luego más fame, luego más barcos, mirando primero el domingo. */
function _rsMenor(a, b) {
  var d;
  for (d = 3; d >= 0; d--) if (a[d].n !== b[d].n) return a[d].n > b[d].n;
  for (d = 3; d >= 0; d--) if (a[d].f !== b[d].f) return a[d].f > b[d].f;
  for (d = 3; d >= 0; d--) if (a[d].b !== b[d].b) return a[d].b > b[d].b;
  return false;
}

// ---------------------------------------------------------------------------------------------------------------
// AVANCE ENTRE CORRIDAS (última semana recorrida)
// ---------------------------------------------------------------------------------------------------------------

/** Ultima semana ya recorrida (0 = empezar desde el principio). tipo: 'INFORME' o 'APLICAR'. */
function _rsCursorLeer_(tipo) {
  try { return Number(PropertiesService.getScriptProperties().getProperty(RS_CURSOR_PROP + tipo)) || 0; }
  catch (e) { return 0; }
}

/** Guarda hasta que semana se llego; con terminado = true (o sin semana) borra el avance y la proxima corrida empieza de nuevo. */
function _rsCursorGuardar_(tipo, plan) {
  try {
    var p = PropertiesService.getScriptProperties();
    if (plan.terminado || plan.cursor === null) p.deleteProperty(RS_CURSOR_PROP + tipo);
    else p.setProperty(RS_CURSOR_PROP + tipo, String(plan.cursor));
  } catch (e) { Logger.log('[Semana por dias] No se pudo guardar el avance: ' + e.message); }
}


// --- ARCHIVO: 58_Docs_Administracion.gs ---
// ==============================================================================
// 58_Docs_Administracion.gs
// Actualiza solo, en los Google Docs de plantillas (Bienvenida y Descripción), el bloque «Líder / Colíderes / Veteranos / Otros administradores / Otros colíderes» con los datos reales de Directorio. [→ Contexto_Base_Web.md §PF186, §PF187 y §PF188]
// ==============================================================================

// ORDEN DE ESTE ARCHIVO (regla 0.9 de la skill; 28-oct-2026): primero las constantes y variables globales; luego, por partes:
//  Parte 1 — Funciones que se corren a mano: ninguna (el bloque de administración de los Docs lo actualiza _leerEntradasEstaticasDrive, de 43_Menu_Dinamico.gs, que llama a _adminDocActualizar_)
//  Parte 2 — Funciones que no se corren a mano
//    - Punto de entrada: _adminDocActualizar_
//    - Lectura de datos (Directorio): equipo real de cada clan, copas, nombres y tag del clan
//    - Edición de los Docs de un clan, en el orden en que se aplica: grupos, búsqueda del grupo y formato del texto
//    - Elección de las cuentas que se muestran (las llama la edición del Doc de un clan)
//    - Edición del Doc de toda la familia
// Dentro de cada tema, en el orden en que se espera ejecutarlas. Al reordenar no se cambió el código de ninguna función.

// ----- Variables y constantes -----

// Categorías (en minúsculas, sin tilde) de los Docs que llevan el bloque de administración. [→ Contexto_Base_Web.md §PF186]
var ADMIN_DOC_CATEGORIAS = ['bienvenida', 'descripcion'];

// Nombres de respaldo de los clanes oficiales (tag -> nombre tal como se escribe en los Docs de Plantillas), por si ni la API ni la hoja Clan dan el nombre. [→ Contexto_Base_Web.md §PF187]
var ADMIN_DOC_NOMBRES_RESPALDO = {
  '#GCRG8L00': 'Grupo乂Terna™',
  '#GYCU9YRG': 'GrupoXTerna™2',
  '#GQQPPJGR': 'GrupoXTerna™3',
  '#GG99LCJY': 'Mini乂Ternas™'
};

// PF189 (24-oct-2026, pedido de la usuaria): cuentas que se muestran para estas personas cuando no tienen ninguna cuenta presente en el clan del Doc (se ubica a la persona por su celular, a partir de la fila de Directorio de ese tag). Si Directorio no trae el tag, se usa el nombre indicado. [→ Contexto_Base_Web.md §PF189]
var ADMIN_DOC_CUENTAS_PREFERIDAS = {
  '#2GG8PJ8GC': 'chistris',
  '#V20GJRC9Y': 'caandre',
  '#QRQULCCV8': 'ᴳ乂ᵀ ⚜️ Maikel'
};

// Caché en memoria (solo vive durante esta ejecución) del equipo leído de Directorio, para no releer la hoja por cada Doc. [→ Contexto_Base_Web.md §PF186]
var _adminDocEquipoCache_ = null;

// =============================================================================
// PARTE 2 — FUNCIONES QUE NO SE CORREN A MANO
// =============================================================================

// ----- Punto de entrada (lo llama _leerEntradasEstaticasDrive en 43_Menu_Dinamico.gs) -----

// _adminDocActualizar_(doc, categoria, clanNombre): si el Doc es de Bienvenida o Descripción, reescribe su bloque de administración; solo toca el Doc si algo cambió. [→ Contexto_Base_Web.md §PF186]
function _adminDocActualizar_(doc, categoria, clanNombre) {
  var cat = _adminDocNorm_(categoria);
  if (ADMIN_DOC_CATEGORIAS.indexOf(cat) < 0) return false;

  var equipo = _adminDocLeerEquipo_();
  if (!equipo) return false;

  var body = doc.getBody();
  var tag = _adminDocTagDeClan_(equipo, clanNombre);
  var cambio = false;
  if (tag) {
    cambio = _adminDocAplicarClan_(body, equipo, tag, clanNombre);
  } else if (cat === 'descripcion') {
    cambio = _adminDocAplicarFamilia_(body, equipo, clanNombre);
  } else {
    // PF187: antes un Doc de Bienvenida de un clan que no se reconocía por su nombre se saltaba sin dejar rastro.
    Logger.log('[AdminDoc] No se reconoció el clan "' + clanNombre + '" para su Doc de ' + categoria + ': no se tocó.');
  }
  if (cambio) {
    Logger.log('[AdminDoc] Actualizado el bloque de administración de "' + categoria + ' - ' + clanNombre + '".');
  }
  return cambio;
}

// ----- Lectura de datos (Directorio) -----

// _adminDocNorm_(s): minúsculas, sin tildes, sin espacios ni símbolos, para comparar nombres. [→ Contexto_Base_Web.md §PF186]
function _adminDocNorm_(s) {
  return String(s || '').toLowerCase()
    .replace(/[áà]/g, 'a').replace(/[éè]/g, 'e').replace(/[íì]/g, 'i').replace(/[óò]/g, 'o').replace(/[úù]/g, 'u')
    .replace(/[\s™®©]/g, '');
}

// _adminDocLeerEquipo_(): lee Directorio una vez y arma, por clan oficial, los líderes y colíderes reales, y la lista de administradores reales (Admin = Sí). Devuelve null si no hay datos confiables. [→ Contexto_Base_Web.md §PF186]
function _adminDocLeerEquipo_() {
  if (_adminDocEquipoCache_) return _adminDocEquipoCache_;
  var ss = _getSs();
  var sh = ss.getSheetByName(CFG.SHEETS.DIRECTORIO);
  if (!sh || sh.getLastRow() < 2) {
    Logger.log('[AdminDoc] Directorio sin datos: no se toca ningún Doc.');
    return null;
  }
  var data = sh.getRange(2, 1, sh.getLastRow() - 1, DIR_SHEET_COLS).getValues();
  var copasPorTag = _adminDocCopasPorTag_(ss); // PF189: copas actuales de cada cuenta (hoja Players)
  var cuentaPorTag = {}; // PF189: tag -> cuenta (cualquier estado), para ubicar las cuentas preferidas

  var porClan = {};   // tag -> { nombre, lideres: [cuenta], colideres: [cuenta] }
  var personas = {};  // clave de persona (celular o tag) -> { cuentas: [cuenta], admin: bool }
  var nombresClan = {}; // nombre normalizado -> tag
  var nombresPorTag = {}; // tag -> [todos los nombres conocidos del clan]
  // PF187 (23-oct-2026): el nombre ya no sale solo del caché de la API (que en la sincronización venía vacío y dejaba sin reconocer a los clanes 2, 3 y Mini): se suman la hoja Clan y los nombres de respaldo. [→ Contexto_Base_Web.md §PF187]
  var nombresHojaClan = _adminDocNombresDeHojaClan_(ss);
  for (var t = 0; t < CFG.TERNA_TAGS.length; t++) {
    var tg = CFG.TERNA_TAGS[t];
    porClan[tg] = { nombre: _resolverNombreClan(tg), lideres: [], colideres: [], veteranos: [] };
    var conocidos = [porClan[tg].nombre, nombresHojaClan[tg], ADMIN_DOC_NOMBRES_RESPALDO[tg]];
    nombresPorTag[tg] = [];
    for (var nc = 0; nc < conocidos.length; nc++) {
      var nomC = String(conocidos[nc] || '').trim();
      if (!nomC || nomC === tg) continue; // _resolverNombreClan devuelve el propio tag cuando no encuentra el nombre
      nombresPorTag[tg].push(nomC);
      var claveC = _adminDocNorm_(nomC);
      if (!nombresClan[claveC]) nombresClan[claveC] = tg;
    }
    if (nombresPorTag[tg].length > 0) porClan[tg].nombre = nombresPorTag[tg][0];
  }

  for (var i = 0; i < data.length; i++) {
    var f = data[i];
    var tagClan = String(f[IC.CLAN_TAG - 1] || '').trim();
    var estado = String(f[IC.ESTADO - 1] || '').trim();
    var vet = String(f[IC.VETADO - 1] || '').trim().toLowerCase();
    var esVetado = (vet === 'sí' || vet === 'si') || tagClan === CFG.VETADO_TAG;
    var nombre = String(f[IC.NOMBRE - 1] || '').trim();
    if (!nombre || esVetado) continue;

    var rango = _adminDocNorm_(f[IC.RANGO - 1]);
    var esAdmin = String(f[IC.ADMIN - 1] || '').trim() === 'Sí';
    // Persona = mismo celular (prefijo + número); sin celular, la cuenta cuenta como una persona sola.
    var cel = soloDigitos(f[IC.PREFIJO - 1]) + soloDigitos(f[IC.CELULAR - 1]);
    var clavePersona = cel || ('tag:' + String(f[IC.TAG - 1] || '').trim());
    var cuenta = {
      persona: clavePersona,
      nombre: nombre,
      tag: String(f[IC.TAG - 1] || '').trim(),
      clanTag: tagClan,
      rango: rango,
      activo: estado === 'Activo',
      copas: copasPorTag[String(f[IC.TAG - 1] || '').trim()] || 0
    };
    if (cuenta.tag) cuentaPorTag[cuenta.tag] = cuenta;

    if (!personas[clavePersona]) personas[clavePersona] = { cuentas: [], admin: false };
    personas[clavePersona].cuentas.push(cuenta);
    if (esAdmin) personas[clavePersona].admin = true;

    if (cuenta.activo && porClan[tagClan]) {
      if (rango === 'lider') porClan[tagClan].lideres.push(cuenta);
      else if (rango === 'colider') porClan[tagClan].colideres.push(cuenta);
      else if (rango === 'veterano') porClan[tagClan].veteranos.push(cuenta); // PF188: se usa para la lista «Veteranos» (solo los administradores)
    }
  }

  var hayLider = false;
  for (var tt in porClan) if (porClan[tt].lideres.length > 0) hayLider = true;
  if (!hayLider) {
    Logger.log('[AdminDoc] Directorio no trae ningún líder activo en los clanes oficiales: se asume dato incompleto y no se toca ningún Doc.');
    return null;
  }

  // PF189: persona (por celular) -> cuenta que se muestra si no tiene ninguna cuenta presente en el clan.
  var preferidas = {};
  for (var tp in ADMIN_DOC_CUENTAS_PREFERIDAS) {
    var cp = cuentaPorTag[tp];
    if (cp) {
      preferidas[cp.persona] = cp;
    } else {
      Logger.log('[AdminDoc] La cuenta indicada ' + tp + ' (' + ADMIN_DOC_CUENTAS_PREFERIDAS[tp] + ') no está en Directorio: no se puede ubicar a su persona por celular.');
    }
  }

  _adminDocEquipoCache_ = { porClan: porClan, personas: personas, nombresClan: nombresClan, nombresPorTag: nombresPorTag, preferidas: preferidas };
  return _adminDocEquipoCache_;
}

// _adminDocCopasPorTag_(ss): tag -> copas actuales según la hoja Players ({} si no se puede leer; entonces todas cuentan 0 y desempata el nombre). [→ Contexto_Base_Web.md §PF189]
function _adminDocCopasPorTag_(ss) {
  var res = {};
  try {
    var sh = ss.getSheetByName(CFG.SHEETS.PLAYERS);
    if (!sh || sh.getLastRow() < 2) return res;
    var datos = sh.getRange(2, 1, sh.getLastRow() - 1, PC.COPAS).getValues();
    for (var i = 0; i < datos.length; i++) {
      var tg = String(datos[i][PC.TAG - 1] || '').trim();
      if (tg) res[tg] = Number(datos[i][PC.COPAS - 1]) || 0;
    }
  } catch (e) {
    Logger.log('[AdminDoc] No se pudieron leer las copas de la hoja Players: ' + e.message);
  }
  return res;
}

// _adminDocNombresDeHojaClan_(ss): tag -> nombre del clan según la hoja Clan ({} si la hoja no existe o está vacía). [→ Contexto_Base_Web.md §PF187]
function _adminDocNombresDeHojaClan_(ss) {
  var res = {};
  try {
    var sh = ss.getSheetByName(CFG.SHEETS.CLAN);
    if (!sh || sh.getLastRow() < 2) return res;
    var datos = sh.getRange(2, 1, sh.getLastRow() - 1, CC.NOMBRE).getValues();
    for (var i = 0; i < datos.length; i++) {
      var tg = String(datos[i][CC.CLAN_TAG - 1] || '').trim();
      var nm = String(datos[i][CC.NOMBRE - 1] || '').trim();
      if (tg && nm && !res[tg]) res[tg] = nm;
    }
  } catch (e) {
    Logger.log('[AdminDoc] No se pudo leer los nombres de la hoja Clan: ' + e.message);
  }
  return res;
}

// _adminDocClaveAlfa_(s): solo letras, números y 乂, en minúsculas y sin tildes; sirve para comparar nombres de clan aunque cambien los símbolos o los espacios. [→ Contexto_Base_Web.md §PF187]
function _adminDocClaveAlfa_(s) {
  return _adminDocNorm_(s).replace(/[^a-z0-9乂]/g, '');
}

// _adminDocTagDeClan_(equipo, clanNombre): tag del clan oficial cuyo nombre coincide con el del Doc, o '' si es un Doc de toda la familia. Si el nombre no coincide exacto, se prueba por «mini» o por el número final (por ejemplo «…Terna™2»), y solo se acepta si hay un único clan que encaje. [→ Contexto_Base_Web.md §PF187]
function _adminDocTagDeClan_(equipo, clanNombre) {
  var exacto = equipo.nombresClan[_adminDocNorm_(clanNombre)];
  if (exacto) return exacto;

  var clave = _adminDocClaveAlfa_(clanNombre);
  if (clave.indexOf('terna') < 0) return ''; // no parece un clan Terna (por ejemplo «Familia Terna» sí lo parece, pero se descarta abajo)
  var esMini = clave.indexOf('mini') >= 0;
  var mDig = clave.match(/(\d)$/);
  if (!esMini && !mDig) return '';

  var candidatos = [];
  for (var tg in equipo.nombresPorTag) {
    var nombres = equipo.nombresPorTag[tg];
    for (var i = 0; i < nombres.length; i++) {
      var cn = _adminDocClaveAlfa_(nombres[i]);
      var encaja = esMini ? (cn.indexOf('mini') >= 0) : (cn.indexOf('mini') < 0 && new RegExp(mDig[1] + '$').test(cn));
      if (encaja) { candidatos.push(tg); break; }
    }
  }
  return candidatos.length === 1 ? candidatos[0] : '';
}

// _adminDocOrdenNombres_(cuentas): nombres únicos ordenados sin distinguir mayúsculas. [→ Contexto_Base_Web.md §PF186]
function _adminDocOrdenNombres_(cuentas) {
  var vistos = {}, lista = [];
  for (var i = 0; i < cuentas.length; i++) {
    var n = cuentas[i].nombre;
    if (!vistos[n]) { vistos[n] = true; lista.push(n); }
  }
  lista.sort(function(a, b) { return a.toLowerCase().localeCompare(b.toLowerCase(), 'es'); });
  return lista;
}

// ----- Edición de Docs de un clan (bloque Líder: / Colíderes: / Administradores:) -----

// _adminDocAplicarClan_(body, equipo, tag, clanNombre): reescribe los grupos del Doc de un clan; devuelve true si cambió algo. [→ Contexto_Base_Web.md §PF186]
function _adminDocAplicarClan_(body, equipo, tag, clanNombre) {
  var clan = equipo.porClan[tag];
  var lideres = _adminDocLineas_(clan.lideres, equipo, tag);
  if (lideres.length === 0) {
    Logger.log('[AdminDoc] "' + clanNombre + '" no tiene líder activo en Directorio: no se toca su Doc.');
    return false;
  }
  // PF187 (23-oct-2026, pedido de la usuaria): en «Administración del clan» van solo el líder y los colíderes que son administradores (Admin = Sí en Directorio, por persona); los demás colíderes van en un bloque aparte, «Otros colíderes», para que no parezcan administradores. [→ Contexto_Base_Web.md §PF187]
  var colAdmin = [], colOtros = [];
  for (var i = 0; i < clan.colideres.length; i++) {
    var cu = clan.colideres[i];
    var per = equipo.personas[cu.persona];
    if (per && per.admin) colAdmin.push(cu); else colOtros.push(cu);
  }
  var colideres = _adminDocLineas_(colAdmin, equipo, tag);
  if (colideres.length === 0) colideres = ['Sin colíderes administradores por el momento'];
  // PF188 (24-oct-2026, pedido de la usuaria): los veteranos que son administradores van en su propia lista «Veteranos»; «Otros administradores» queda para los admins que no son líder, colíder ni veterano de este clan.
  var vetAdmin = [];
  for (var v = 0; v < clan.veteranos.length; v++) {
    var cv = clan.veteranos[v];
    var pv = equipo.personas[cv.persona];
    if (pv && pv.admin) vetAdmin.push(cv);
  }
  var veteranos = _adminDocLineas_(vetAdmin, equipo, tag);
  var admins = _adminDocLineas_(_adminDocAdminsExtra_(equipo, tag), equipo, tag);
  var otros = _adminDocLineas_(colOtros, equipo, tag);

  // Orden del bloque: Líder, Colíderes, Veteranos, Otros administradores, Otros colíderes. Cada grupo nuevo se coloca tras el último de los anteriores que exista en el Doc. [→ Contexto_Base_Web.md §PF188]
  var cambio = false;
  cambio = _adminDocGrupo_(body, 'lider', lideres, null, 'Líder:') || cambio;
  cambio = _adminDocGrupo_(body, 'colideres', colideres, null, 'Colíderes:') || cambio;
  cambio = _adminDocGrupo_(body, 'veteranos', veteranos, 'colideres', 'Veteranos:') || cambio;
  var anclaAdm = _adminDocBuscarGrupo_(body, 'veteranos') ? 'veteranos' : 'colideres';
  cambio = _adminDocGrupo_(body, 'otrosadministradores', admins, anclaAdm, 'Otros administradores:') || cambio;
  var anclaOtros = _adminDocBuscarGrupo_(body, 'otrosadministradores') ? 'otrosadministradores' : anclaAdm;
  cambio = _adminDocGrupo_(body, 'otroscolideres', otros, anclaOtros, 'Otros colíderes:') || cambio;
  return cambio;
}

// _adminDocGrupo_(body, clave, nombres, despuesDe, titulo): deja el grupo con exactamente esos nombres. Si no existe y hay nombres, lo crea después del grupo «despuesDe» con el encabezado «titulo»; si existe y no hay nombres, lo quita. Devuelve true si cambió algo. [→ Contexto_Base_Web.md §PF186]
function _adminDocGrupo_(body, clave, nombres, despuesDe, titulo) {
  var g = _adminDocBuscarGrupo_(body, clave);

  if (!g) {
    if (nombres.length === 0) return false;
    var ref = _adminDocBuscarGrupo_(body, despuesDe);
    if (!ref || ref.nombres.length === 0) return false; // sin dónde anclar: no se inventa estructura
    var ultimo = ref.nombres[ref.nombres.length - 1];
    var plantillaEnc = body.getChild(ref.iEnc).asParagraph().copy();
    var plantillaNom = ultimo.par.copy();
    var pos = ultimo.i + 1;
    // Renglón en blanco antes del encabezado, igual que entre los otros grupos si lo hay.
    var previo = ref.iEnc > 0 ? body.getChild(ref.iEnc - 1) : null;
    var hayBlanco = !!previo && previo.getType() === DocumentApp.ElementType.PARAGRAPH &&
      previo.asParagraph().getText().trim() === '';
    if (hayBlanco) { body.insertParagraph(pos++, '').setAttributes(plantillaEnc.getAttributes()); }
    // La sangría (espacios al inicio) se copia de las líneas modelo, para que el grupo nuevo quede alineado con los demás. [→ Contexto_Base_Web.md §PF187]
    var prefEnc = _adminDocPrefEncabezados_(body, plantillaEnc.getText()); // PF188: todos los encabezados toman la sangría del de «Colíderes:»
    var prefNom = _adminDocPrefijo_(plantillaNom.getText());
    var enc = body.insertParagraph(pos++, plantillaEnc);
    _adminDocSetTexto_(enc, prefEnc + (titulo || 'Administradores:'));
    for (var a = 0; a < nombres.length; a++) {
      var np = body.insertParagraph(pos++, plantillaNom.copy());
      _adminDocSetTexto_(np, prefNom + '▫️ ' + nombres[a]);
    }
    return true;
  }

  // PF188: en los grupos que maneja este archivo (no en «Líder:» ni «Colíderes:», que pueden traer un emoji propio) se deja el título exacto y la misma sangría que «Colíderes:»; así «Administradores:» pasa a «Otros administradores:» y queda alineado.
  var cambioTitulo = false;
  if (nombres.length > 0 && titulo && (clave === 'veteranos' || clave === 'otrosadministradores' || clave === 'otroscolideres')) {
    var parEnc = body.getChild(g.iEnc).asParagraph();
    var tituloDeseado = _adminDocPrefEncabezados_(body, parEnc.getText()) + titulo;
    if (parEnc.getText() !== tituloDeseado) { _adminDocSetTexto_(parEnc, tituloDeseado); cambioTitulo = true; }
  }

  var actuales = g.nombres.map(function(x) { return _adminDocQuitarVineta_(x.par.getText()); });
  var nuevos = nombres.map(function(x) { return x.replace(/\s+/g, ' ').trim(); });
  if (actuales.join('\u0001') === nuevos.join('\u0001')) return cambioTitulo;

  // Quitar el grupo si ya no hay nadie que mostrar (solo se da con «Veteranos», «Otros administradores» y «Otros colíderes»).
  if (nombres.length === 0) {
    for (var q = g.nombres.length - 1; q >= 0; q--) body.removeChild(body.getChild(g.nombres[q].i));
    body.removeChild(body.getChild(g.iEnc));
    return true;
  }

  if (g.nombres.length === 0) return cambioTitulo; // el grupo no trae ninguna línea modelo: no se inventa formato

  // ¿Hay renglones en blanco entre las líneas de nombre? Se repite el mismo patrón.
  var primero = g.nombres[0], ultimoN = g.nombres[g.nombres.length - 1];
  var conBlancos = (ultimoN.i - primero.i + 1) > g.nombres.length;
  var plantilla = primero.par.copy();
  var prefN = _adminDocPrefijo_(primero.par.getText()); // sangría de la línea modelo (PF187)
  var plantillaBlanco = null;
  if (conBlancos) {
    for (var b = primero.i + 1; b < ultimoN.i; b++) {
      var hb = body.getChild(b);
      if (hb.getType() === DocumentApp.ElementType.PARAGRAPH && hb.asParagraph().getText().trim() === '') { plantillaBlanco = hb.asParagraph().copy(); break; }
    }
  }

  // Se borran todas las líneas salvo la primera (de atrás hacia delante) y se reescribe.
  for (var r = ultimoN.i; r > primero.i; r--) body.removeChild(body.getChild(r));
  _adminDocSetTexto_(primero.par, prefN + '▫️ ' + nombres[0]);
  var pos2 = primero.i + 1;
  for (var k = 1; k < nombres.length; k++) {
    if (plantillaBlanco) body.insertParagraph(pos2++, plantillaBlanco.copy());
    var nl = body.insertParagraph(pos2++, plantilla.copy());
    _adminDocSetTexto_(nl, prefN + '▫️ ' + nombres[k]);
  }
  return true;
}

// _adminDocBuscarGrupo_(body, clave): ubica en el cuerpo el párrafo encabezado del grupo y las líneas de nombre (con «▫») que le siguen. Devuelve {iEnc, nombres:[{i, par}]} o null. [→ Contexto_Base_Web.md §PF186]
function _adminDocBuscarGrupo_(body, clave) {
  var n = body.getNumChildren();
  for (var i = 0; i < n; i++) {
    var el = body.getChild(i);
    if (el.getType() !== DocumentApp.ElementType.PARAGRAPH) continue;
    if (_adminDocEncabezado_(el.asParagraph().getText()) !== clave) continue;
    var nombres = [];
    for (var j = i + 1; j < n; j++) {
      var h = body.getChild(j);
      if (h.getType() !== DocumentApp.ElementType.PARAGRAPH) break;
      var tx = h.asParagraph().getText();
      if (/^\s*[▫▪]/.test(tx)) { nombres.push({ i: j, par: h.asParagraph() }); continue; }
      if (tx.trim() === '') continue; // renglón en blanco entre nombres
      break;
    }
    return { iEnc: i, nombres: nombres };
  }
  return null;
}

// _adminDocEncabezado_(texto): 'lider', 'colideres', 'administradores' o '' según el texto de un párrafo. [→ Contexto_Base_Web.md §PF186]
function _adminDocEncabezado_(texto) {
  // Se ignoran los emojis o símbolos que haya antes de la primera letra (por ejemplo «🔹 Colíderes:»).
  var t = _adminDocNorm_(texto).replace(/^[^a-z]+/, '').replace(/:$/, '');
  if (t === 'lider') return 'lider';
  if (t === 'colideres') return 'colideres';
  // PF188: «Administradores:» (nombre anterior) y «Otros administradores:» son el mismo grupo; al reescribir se deja el título nuevo.
  if (t === 'administradores' || t === 'otrosadministradores') return 'otrosadministradores';
  if (t === 'veteranos') return 'veteranos';
  if (t === 'otroscolideres') return 'otroscolideres';
  return '';
}

// _adminDocPrefEncabezados_(body, textoPorDefecto): sangría del encabezado «Colíderes:» (o, si no está, el de «Líder:»), que es la que deben tener todos los encabezados del bloque; si no hay ninguno, la del texto dado. [→ Contexto_Base_Web.md §PF188]
function _adminDocPrefEncabezados_(body, textoPorDefecto) {
  var claves = ['colideres', 'lider'];
  for (var c = 0; c < claves.length; c++) {
    var g = _adminDocBuscarGrupo_(body, claves[c]);
    if (g) return _adminDocPrefijo_(body.getChild(g.iEnc).asParagraph().getText());
  }
  return _adminDocPrefijo_(textoPorDefecto);
}

// _adminDocPrefijo_(texto): los espacios (sangría) que hay al inicio de un párrafo, o '' si no tiene. [→ Contexto_Base_Web.md §PF187]
function _adminDocPrefijo_(texto) {
  var m = String(texto || '').match(/^[ \t ]*/);
  return m ? m[0] : '';
}

// _adminDocSetTexto_(par, texto): cambia el texto de un párrafo conservando el formato (negrita, tamaño, color…) del primer carácter que no sea espacio; así la sangría no hace perder la negrita que la usuaria haya puesto a mano. [→ Contexto_Base_Web.md §PF189]
function _adminDocSetTexto_(par, texto) {
  var t = par.editAsText();
  var previo = t.getText();
  var viejo = previo.length;
  var idx = 0;
  while (idx < viejo - 1 && /\s/.test(previo.charAt(idx))) idx++;
  var atributos = viejo > 0 ? t.getAttributes(idx) : null;
  t.insertText(0, texto);
  if (viejo > 0) t.deleteText(texto.length, texto.length + viejo - 1);
  if (atributos && texto.length > 0) t.setAttributes(0, texto.length - 1, atributos);
}

// Quita viñetas y espacios del inicio de una línea de nombre para comparar. [→ Contexto_Base_Web.md §PF186]
function _adminDocQuitarVineta_(s) {
  return String(s || '').replace(/^[\s▫▪•️\-–]+/, '').replace(/\s+/g, ' ').trim();
}

// ----- Elección de las cuentas que se muestran (una por persona) -----

// _adminDocLineas_(cuentas, equipo, tagClan): una línea por persona (mismo celular), con una sola cuenta (ver _adminDocCuentaAMostrar_). Las líneas salen ordenadas sin distinguir mayúsculas. [→ Contexto_Base_Web.md §PF189]
function _adminDocLineas_(cuentas, equipo, tagClan) {
  var vistos = {}, lineas = [];
  for (var i = 0; i < cuentas.length; i++) {
    var c = cuentas[i];
    var k = c.persona || ('tag:' + c.tag);
    if (vistos[k]) continue;
    vistos[k] = true;
    var mostrar = _adminDocCuentaAMostrar_(equipo, k, tagClan) || c;
    lineas.push(mostrar.nombre);
  }
  lineas.sort(function(a, b) { return a.toLowerCase().localeCompare(b.toLowerCase(), 'es'); });
  return lineas;
}

// _adminDocCuentaAMostrar_(equipo, personaKey, tagClan): la única cuenta que se muestra de una persona. 1.º entre las cuentas activas presentes en ese clan (con tagClan vacío, en cualquiera de los clanes oficiales), la de mayor rango y, entre las de ese rango, la de más copas; 2.º si no tiene ninguna, la cuenta indicada para esa persona (ADMIN_DOC_CUENTAS_PREFERIDAS); 3.º si tampoco, su cuenta principal (la de mayor rango). Devuelve null si no hay nada que mostrar. [→ Contexto_Base_Web.md §PF189]
function _adminDocCuentaAMostrar_(equipo, personaKey, tagClan) {
  var p = equipo.personas[personaKey];
  if (!p) return null;
  var presentes = [];
  for (var i = 0; i < p.cuentas.length; i++) {
    var c = p.cuentas[i];
    if (!c.activo) continue;
    if (tagClan ? c.clanTag === tagClan : !!equipo.porClan[c.clanTag]) presentes.push(c);
  }
  if (presentes.length > 0) return _adminDocMejorPorCopas_(presentes);
  if (equipo.preferidas && equipo.preferidas[personaKey]) return equipo.preferidas[personaKey];
  return _adminDocCuentaPrincipal_(p);
}

// _adminDocMejorPorCopas_(cuentas): primero el criterio de mayor rango (líder, colíder, veterano, miembro) y, entre las cuentas de ese rango, la que tenga más copas; si siguen empatadas, la de nombre menor. [→ Contexto_Base_Web.md §PF190]
function _adminDocMejorPorCopas_(cuentas) {
  var orden = { lider: 1, colider: 2, veterano: 3, miembro: 4 };
  var mejor = null;
  for (var i = 0; i < cuentas.length; i++) {
    var c = cuentas[i];
    if (!mejor) { mejor = c; continue; }
    var oc = orden[c.rango] || 5, om = orden[mejor.rango] || 5;
    if (oc < om) { mejor = c; continue; }
    if (oc > om) continue;
    var cc = c.copas || 0, cm = mejor.copas || 0;
    if (cc > cm || (cc === cm && c.nombre.toLowerCase() < mejor.nombre.toLowerCase())) mejor = c;
  }
  return mejor;
}

// _adminDocCuentaPrincipal_(persona): la cuenta activa de mayor rango (líder, colíder, veterano, miembro); desempata por nombre. [→ Contexto_Base_Web.md §PF186]
function _adminDocCuentaPrincipal_(persona) {
  var orden = { lider: 1, colider: 2, veterano: 3, miembro: 4 };
  var mejor = null;
  for (var i = 0; i < persona.cuentas.length; i++) {
    var c = persona.cuentas[i];
    if (!c.activo) continue;
    var o = orden[c.rango] || 5;
    var om = mejor ? (orden[mejor.rango] || 5) : 99;
    if (!mejor || o < om || (o === om && c.nombre.toLowerCase() < mejor.nombre.toLowerCase())) mejor = c;
  }
  return mejor;
}

// _adminDocAdminsExtra_(equipo, tagClan): una cuenta de cada administrador real (Admin = Sí) que NO es líder, colíder ni veterano de ese clan. [→ Contexto_Base_Web.md §PF186]
function _adminDocAdminsExtra_(equipo, tagClan) {
  var extra = [];
  for (var k in equipo.personas) {
    var p = equipo.personas[k];
    if (!p.admin) continue;
    if (_adminDocPersonaTieneCuenta_(p, tagClan, ['lider', 'colider', 'veterano'])) continue; // PF188: los veteranos admin ya salen en «Veteranos»
    var mostrar = _adminDocCuentaAMostrar_(equipo, k, tagClan);
    if (mostrar) extra.push({ persona: k, nombre: mostrar.nombre, tag: mostrar.tag }); // PF189: la cuenta final se vuelve a elegir en _adminDocLineas_
  }
  return extra;
}

// _adminDocPersonaTieneCuenta_(persona, tagClan, rangos): true si alguna cuenta activa de la persona tiene uno de esos rangos en ese clan. [→ Contexto_Base_Web.md §PF186]
function _adminDocPersonaTieneCuenta_(persona, tagClan, rangos) {
  for (var i = 0; i < persona.cuentas.length; i++) {
    var c = persona.cuentas[i];
    if (c.activo && c.clanTag === tagClan && rangos.indexOf(c.rango) >= 0) return true;
  }
  return false;
}

// ----- Edición del Doc de toda la familia (Descripción - Comunidad) -----

// _adminDocAplicarFamilia_(body, equipo, clanNombre): en el Doc de la comunidad actualiza «Líder:» de cada clan (se ubica por su #TAG) y la lista «Colíderes:» (colíderes de la familia que no son líderes de ningún clan). Devuelve true si cambió algo. [→ Contexto_Base_Web.md §PF186]
function _adminDocAplicarFamilia_(body, equipo, clanNombre) {
  var cambio = false;
  var n = body.getNumChildren();
  var tagActual = '';
  for (var i = 0; i < n; i++) {
    var el = body.getChild(i);
    if (el.getType() !== DocumentApp.ElementType.PARAGRAPH) continue;
    var par = el.asParagraph();
    var tx = par.getText();

    // Línea del clan: trae su #TAG (por ejemplo «Grupo乂Terna™ #GCRG8L00»).
    var mTag = tx.match(/#[0-9A-Z]{6,10}/);
    if (mTag && equipo.porClan[mTag[0]]) { tagActual = mTag[0]; continue; }

    // Línea «Líder: nombre» del clan que se acaba de ver.
    var mLid = tx.match(/^(\s*L[ií]der:\s*)/);
    if (mLid && tagActual) {
      var lideres = _adminDocLineas_(equipo.porClan[tagActual].lideres, equipo, tagActual);
      if (lideres.length > 0) {
        var nuevo = lideres.join(' / ');
        var actual = tx.substring(mLid[1].length).replace(/\s+/g, ' ').trim();
        if (actual !== nuevo) {
          var t = par.editAsText();
          var largo = tx.length;
          t.insertText(mLid[1].length, nuevo);
          if (largo > mLid[1].length) t.deleteText(mLid[1].length + nuevo.length, mLid[1].length + nuevo.length + (largo - mLid[1].length) - 1);
          cambio = true;
        }
      }
      tagActual = '';
    }
  }

  // Colíderes de toda la familia: personas con cuenta activa de colíder en algún clan oficial y sin ser líder de ninguno.
  var colideres = [];
  for (var k in equipo.personas) {
    var p = equipo.personas[k];
    var esColider = false, esLider = false;
    for (var tg in equipo.porClan) {
      if (_adminDocPersonaTieneCuenta_(p, tg, ['colider'])) esColider = true;
      if (_adminDocPersonaTieneCuenta_(p, tg, ['lider'])) esLider = true;
    }
    if (!esColider || esLider) continue;
    for (var c = 0; c < p.cuentas.length; c++) {
      var cu = p.cuentas[c];
      if (cu.activo && cu.rango === 'colider' && equipo.porClan[cu.clanTag]) colideres.push(cu);
    }
  }
  var nombres = _adminDocLineas_(colideres, equipo, '');
  if (nombres.length === 0) nombres = ['Sin colíderes por el momento'];
  cambio = _adminDocGrupo_(body, 'colideres', nombres, null) || cambio;

  if (cambio) Logger.log('[AdminDoc] Doc de la familia "' + clanNombre + '" actualizado.');
  return cambio;
}


