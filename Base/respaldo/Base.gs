// SUBCARPETAS DE LA CARPETA CSV (12-oct-2026, pedido del usuario) [→ Contexto_Base_Web.md §01B158]
// Cada CSV tiene una subcarpeta asignada. Un nombre sin asignar se queda en la raíz de CSV.
// Si CSV_MOVER_A_SUBCARPETA es true, al guardar un archivo encontrado fuera de su subcarpeta se mueve a ella.
var CSV_MOVER_A_SUBCARPETA = true;
var CSV_SUBCARPETAS_ = ['Background', 'Hojas', 'Informes', 'Tampermonkey', 'Jugador'];
var _CSV_SUBCARPETAS_MEM_ = {};

function _csvSubcarpetaDe_(filename) {
  var n = String(filename || '');
  // Informes: respaldos previos a reparar, reparaciones, limpiezas, revisiones y diagnósticos.
  if (/^Backup_Guerra ANTES de /.test(n) || /^Reparacion_/.test(n) || /^Limpieza_Coliseo_/.test(n) ||
      /^Revision_Guerra/.test(n) || /^Diagnostico_/.test(n) || /^HistorialGuerra_Grupal/.test(n) ||
      /^Correccion_Fecha_/.test(n) || /^Completar_DomingoDesdeJsonRoyaleApi /.test(n) ||
      /^Reparar_SemanaDesdeJsonRoyaleApi /.test(n)) return 'Informes';
  // Tampermonkey: lo que se arma con datos traídos de RoyaleAPI por Tampermonkey.
  if (/^Correcciones_/.test(n) || /^Log_Tampermonkey_/.test(n) || n === 'Backup_Guerra_Semanal.csv') return 'Tampermonkey';
  // Jugador: datos que dependen de cada jugador (no son comportamiento general ni respaldo de una hoja).
  var jugador = ['Backup_Cards_2.csv', 'Backup_Insignias_2.csv', 'Backup_Logros_2.csv', 'Backup_ProgresoEventos.csv',
    'Backup_Battlelogs.csv', 'Backup_PerfilWeb.csv', 'Backup_CaminoLeyendas.csv'];
  if (jugador.indexOf(n) >= 0) return 'Jugador';
  // Background: comportamiento general, sin información personal de un jugador.
  var background = ['Backup_Cards.csv', 'Backup_Cards_3.csv', 'Backup_Modo.csv', 'Backup_Arena.csv',
    'Backup_Insignias.csv', 'Backup_Logros.csv', 'Backup_Cofres.csv', 'Backup_Locations.csv',
    'Backup_Seasons.csv'];
  if (background.indexOf(n) >= 0) return 'Background';
  var hojas = ['Backup_Guerra.csv', 'Backup_Guerra_Logs.csv', 'Backup_Directorio.csv', 'Backup_Inactivos.csv',
    'Backup_Clan.csv', 'Backup_Players.csv', 'Backup_Administradores.csv', 'Backup_Vetados.csv', 'Backup_Nuevos.csv',
    'Backup_Pendientes.csv', 'Backup_Extra.csv', 'Backup_Mensajes.csv', 'Backup_Comentarios.csv',
    'Backup_Calendario_2.csv', 'Backup_T_Lista.csv', 'Backup_T_Asistencia.csv', 'Backup_T_Resoluciones.csv',
    'Backup_S_Lista.csv', 'Backup_S_Asistencia.csv', 'Backup_CR_Lista.csv', 'Backup_Historial_A-D.csv',
    'Backup_Historial_I-S.csv', 'Backup_Grupo_Verificado.csv', 'Backup_Alertas_HistorialGuerra.csv',
    'Alertas_HistorialGuerra.csv', 'Backup_Conflictos.csv', 'Backup_Índice.csv',
    'Backup_Control.csv', 'Backup_Control_2.csv', 'Backup_T_Control.csv', 'Backup_Calendario.csv', 'Backup_Links.csv',
    'Backup_Multicuentas.csv'];
  if (hojas.indexOf(n) >= 0) return 'Hojas';
  // Regla general (21-oct-2026, Contexto_Base_Web.md §PF139 tanda 5): todo informe, plan, aplicado, detalle, resumen o respaldo previo lleva fecha y hora
  // en el nombre (aaaa-mm-dd hh.mm.ss) o termina en (informe), (plan), (aplicado), (detalle) o (resumen): va a Informes aunque su prefijo no esté en la lista de arriba.
  // Así un informe nuevo ya no cae en la raíz de CSV por olvido. Ningún Backup_*.csv de hoja lleva fecha en el nombre.
  if (/ \d{4}-\d{2}-\d{2} \d{2}\.\d{2}\.\d{2}/.test(n) || /\((informe|plan|aplicado|detalle|resumen)\)\.csv$/.test(n)) return 'Informes';
  if (/^(Cotejo_|Cruce_|Informe_|Anomalias_|AplicarTotalesSemana_)/.test(n) || n === 'Cache_TotalesSemana_Objetivos.csv') return 'Informes';
  return ''; // sin asignar: raíz de CSV (hoy ninguno de los que usa el código)
}

/**
 * Mueve a CSV/Informes los informes que ya quedaron sueltos en la raíz de la carpeta CSV (los creados antes de esta corrección no se mueven solos).
 * Solo mueve archivos cuya subcarpeta asignada por _csvSubcarpetaDe_() sea Informes; no toca nada más ni borra nada. Se puede correr las veces que haga falta.
 */
function moverInformesSueltosASubcarpeta() {
  var raiz = _getCsvFolder(), destino = _getCsvSubcarpeta_('Informes', true), it = raiz.getFiles(), movidos = 0, errores = 0;
  while (it.hasNext()) {
    var f = it.next(), nombre = f.getName();
    if (_csvSubcarpetaDe_(nombre) !== 'Informes') continue;
    try { f.moveTo(destino); movidos++; }
    catch (e) { errores++; Logger.log('[Informes] No se pudo mover ' + nombre + ': ' + e.message); }
  }
  Logger.log('[Informes] Movidos a CSV/Informes: ' + movidos + (errores ? ' (con ' + errores + ' error(es), ver arriba)' : '') + '. Lo que no es informe no se toco.');
}

function _getCsvSubcarpeta_(nombre, crear) {
  if (!nombre) return _getCsvFolder();
  if (_CSV_SUBCARPETAS_MEM_[nombre]) return _CSV_SUBCARPETAS_MEM_[nombre];
  var it = _getCsvFolder().getFoldersByName(nombre);
  var carpeta = it.hasNext() ? it.next() : (crear ? _getCsvFolder().createFolder(nombre) : null);
  if (carpeta) _CSV_SUBCARPETAS_MEM_[nombre] = carpeta;
  return carpeta;
}

// Busca un CSV: primero en su subcarpeta, luego en la raíz y al final en las demás subcarpetas.
// Devuelve { file, carpetaNombre } ('' = raíz) o null si no existe.
function _csvBuscarArchivo_(filename) {
  var asignada = _csvSubcarpetaDe_(filename);
  var orden = [asignada];
  if (asignada !== '') orden.push('');
  for (var i = 0; i < CSV_SUBCARPETAS_.length; i++) {
    if (orden.indexOf(CSV_SUBCARPETAS_[i]) < 0) orden.push(CSV_SUBCARPETAS_[i]);
  }
  for (var j = 0; j < orden.length; j++) {
    var carpeta = _getCsvSubcarpeta_(orden[j], false);
    if (!carpeta) continue;
    var files = carpeta.getFilesByName(filename);
    if (files.hasNext()) return { file: files.next(), carpetaNombre: orden[j] };
  }
  return null;
}

function _getSs() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (ss !== null) return ss;
  var id = PropertiesService.getScriptProperties().getProperty('HOJA_ACTIVA_ID');
  if (id) { try { return SpreadsheetApp.openById(id); } catch(e) {} }
  throw new Error('No se encontró hoja activa ni ID de respaldo en Properties.');
}

// _hojaConFilas_(ss, nombre, minFilas): devuelve la hoja si existe y tiene al menos minFilas filas; null si falta, está corta o Sheets lanza error. Permite que los lectores web caigan a su rama de CSV. [→ Contexto_Base_Web.md §PF073]
function _hojaConFilas_(ss, nombre, minFilas) {
  try {
    var sh = ss.getSheetByName(nombre);
    if (sh && sh.getLastRow() >= minFilas) return sh;
  } catch (e) {
    Logger.log('[HojaConFilas] No se pudo leer la hoja "' + nombre + '": ' + e);
  }
  return null;
}

function _desactivarGridlines(sh) {
  try { sh.setHiddenGridlines(true); } catch(e) {}
}

// FALLBACK GENÉRICO SHEET -> CSV [→ Contexto_Base_Web.md §01B150]

/**
 * _armarHeaderIdx(headers) [→ Contexto_Base_Web.md §01B151]
 */
function _armarHeaderIdx(headers) {
  var idx = {};
  for (var c = 0; c < headers.length; c++) {
    idx[String(headers[c] || '').trim()] = c;
  }
  return idx;
}

/**
 * _obtenerFilasConFallbackCSV(ss, nombreHoja, nombreArchivoCsv, totalCols, headerRowsHoja) [→ Contexto_Base_Web.md §01B152]
 */
function _obtenerFilasConFallbackCSV(ss, nombreHoja, nombreArchivoCsv, totalCols, headerRowsHoja) {
  headerRowsHoja = headerRowsHoja || 1;
  // 1) Intentar la hoja primero: sigue siendo la fuente de verdad habitual.
  try {
    var sh = ss.getSheetByName(nombreHoja);
    if (sh && sh.getLastRow() >= headerRowsHoja + 1) {
      var numCols = totalCols || Math.max(sh.getLastColumn(), 1);
      var headers;
      if (headerRowsHoja === 2) {
        headers = _combinarHeaderDosFilas(sh, numCols);
      } else if (headerRowsHoja === 3) {
        headers = _combinarHeaderTresFilas(sh, numCols);
      } else {
        headers = sh.getRange(1, 1, 1, numCols).getValues()[0];
      }
      var primeraFilaDatos = headerRowsHoja + 1;
      var filas = sh.getRange(primeraFilaDatos, 1, sh.getLastRow() - headerRowsHoja, numCols).getValues();
      return {
        filas: filas,
        headers: headers,
        headerIdx: _armarHeaderIdx(headers),
        origen: 'sheet'
      };
    }
  } catch (e) {
    // Sheet no disponible (spreadsheet caído, hoja protegida/corrupta, [→ Contexto_Base_Web.md §01B153]
    Logger.log('[FallbackCSV] No se pudo leer la hoja "' + nombreHoja + '": ' + e);
  }

  // 2) Hoja no encontrada, vacía, o la lectura falló -> redirigir al CSV.
  if (!nombreArchivoCsv) {
    return { filas: [], headers: [], headerIdx: {}, origen: 'vacio' };
  }

  var csvText = _loadCSVFromDrive(nombreArchivoCsv);
  if (!csvText) {
    Logger.log('[FallbackCSV] "' + nombreHoja + '" sin datos en la hoja y sin CSV de respaldo (' + nombreArchivoCsv + ').');
    return { filas: [], headers: [], headerIdx: {}, origen: 'vacio' };
  }

  var parsed = _parseCSV(csvText);
  if (!parsed || parsed.length < 2) {
    return { filas: [], headers: (parsed && parsed[0]) || [], headerIdx: {}, origen: 'vacio' };
  }

  var csvHeaders = parsed[0];
  var csvFilas   = parsed.slice(1);
  if (totalCols) {
    csvFilas = csvFilas.map(function(r) {
      var nueva = r.slice(0, totalCols);
      while (nueva.length < totalCols) nueva.push('');
      return nueva;
    });
  }

  Logger.log('[FallbackCSV] "' + nombreHoja + '" no disponible o vacía: se usó el respaldo ' +
             nombreArchivoCsv + ' (' + csvFilas.length + ' filas).');

  return {
    filas: csvFilas,
    headers: csvHeaders,
    headerIdx: _armarHeaderIdx(csvHeaders),
    origen: 'csv'
  };
}

/**
 * _obtenerMapaPorTagConFallbackCSV(ss, nombreHoja, nombreArchivoCsv, tagColIdx, totalCols) [→ Contexto_Base_Web.md §01B154]
 */
function _obtenerMapaPorTagConFallbackCSV(ss, nombreHoja, nombreArchivoCsv, tagColIdx, totalCols) {
  var resultado = _obtenerFilasConFallbackCSV(ss, nombreHoja, nombreArchivoCsv, totalCols);
  var mapa = {};
  for (var i = 0; i < resultado.filas.length; i++) {
    var tag = String(resultado.filas[i][tagColIdx] || '').trim().toUpperCase();
    if (tag) mapa[tag] = resultado.filas[i];
  }
  return { mapa: mapa, origen: resultado.origen };
}

/**
 * _numDesdeCeldaCSV_(v) [→ Contexto_Base_Web.md §01B155]
 */
function _numDesdeCeldaCSV_(v) {
  if (typeof v === 'number') return v;
  if (v === '' || v === null || v === undefined) return NaN;
  var t = String(v).replace(/\u00a0/g, ' ').trim();
  if (t === '') return NaN;
  if (/^-?\d{1,3}([.,' ]\d{3})+$/.test(t)) t = t.replace(/[.,' ]/g, '');
  return Number(t);
}
// se trae _scriptToken desde 37_Web_API
function _scriptToken(nombrePropiedad) {
  var v = PropertiesService.getScriptProperties().getProperty(nombrePropiedad);
  if (!v) {
    // Corta temprano y con mensaje claro: sin literal de respaldo, un [→ Contexto_Base_Web.md §01B156]
    throw new Error('Falta la Property "' + nombrePropiedad + '" en Propiedades del script. ' +
      'Créala en Configuración del proyecto ▸ Propiedades del script.');
  }
  return v;
}

/**
 * guardarTokensEnScriptProperties() [→ Contexto_Base_Web.md §01B157]
 */
function guardarTokensEnScriptProperties() {
  var props = PropertiesService.getScriptProperties();
  var nombres = [
    'WEB_MEMBER_TOKEN', 'CONTACTOS_TOKEN', 'DASHBOARD_TOKEN',
    'CORRECCION_GUERRA_TOKEN', 'HISTORIAL_GUERRA_TOKEN',
    'NUEVOS_ROYALEAPI_TOKEN', 'VERIFICAR_RIVERRACE_TOKEN', 'CLAVE_ADMIN_PEPPER'
  ];
  var yaExistian = [], fallaron = [];
  for (var i = 0; i < nombres.length; i++) {
    var nombre = nombres[i];
    if (props.getProperty(nombre)) { yaExistian.push(nombre); continue; }
    // Ya no hay literal de respaldo en el código: sin Property, no hay
    // valor que copiar. Hay que crearla a mano en Script Properties.
    fallaron.push(nombre + ' (sin Property y sin literal de respaldo en el código)');
  }
  Logger.log('[Tokens] Ya existían (' + yaExistian.length + '): ' + (yaExistian.join(', ') || '—'));
  if (fallaron.length) Logger.log('[Tokens] Faltan por crear a mano: ' + fallaron.join('; '));
}

