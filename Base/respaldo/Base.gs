/**
 * _reordenarFilasNuevosPorClanYNombre(sh) [→ Contexto_Base_Web.md §14B110]
 */
function _reordenarFilasNuevosPorClanYNombre(sh) {
  var lastRow = sh.getLastRow();
  if (lastRow < NUEVOS_FILA_DATOS_INICIO) return;
  var lastCol = sh.getLastColumn();
  var numFilas = lastRow - NUEVOS_FILA_DATOS_INICIO + 1;
  if (numFilas < 2) return;

  var rango = sh.getRange(NUEVOS_FILA_DATOS_INICIO, 1, numFilas, lastCol);
  var valores = rango.getValues();
  var royaleLinks = sh.getRange(NUEVOS_FILA_DATOS_INICIO, NC.ROYALE_API, numFilas, 1).getRichTextValues();

  var ordenClan = _getOrdenClanHoja(sh.getParent());

  var indices = valores.map(function (_, i) { return i; });
  indices.sort(function (a, b) {
    var clanA = String(valores[a][NC.CLAN - 1] || '').trim().toLowerCase();
    var clanB = String(valores[b][NC.CLAN - 1] || '').trim().toLowerCase();
    var ordA = (clanA && ordenClan[clanA] !== undefined) ? ordenClan[clanA] : 999;
    var ordB = (clanB && ordenClan[clanB] !== undefined) ? ordenClan[clanB] : 999;
    if (ordA !== ordB) return ordA - ordB;

    var nomA = String(valores[a][NC.NOM_MULTI - 1] || valores[a][NC.NOMBRE - 1] || '').trim().toLowerCase();
    var nomB = String(valores[b][NC.NOM_MULTI - 1] || valores[b][NC.NOMBRE - 1] || '').trim().toLowerCase();
    return nomA.localeCompare(nomB, 'es');
  });

  var yaOrdenado = indices.every(function (v, i) { return v === i; });
  if (yaOrdenado) return;

  var valoresOrdenados = indices.map(function (i) { return valores[i]; });
  var linksOrdenados    = indices.map(function (i) { return [royaleLinks[i][0]]; });

  rango.setValues(valoresOrdenados);
  sh.getRange(NUEVOS_FILA_DATOS_INICIO, NC.ROYALE_API, numFilas, 1).setRichTextValues(linksOrdenados);

  var numCol = [];
  for (var n = 0; n < numFilas; n++) numCol.push([n + 1]);
  sh.getRange(NUEVOS_FILA_DATOS_INICIO, NC.NUM, numFilas, 1).setValues(numCol);

  Logger.log('[Nuevos-RoyaleAPI] Filas reordenadas por Clan -> Nombre (' + numFilas + ' fila(s)).');
}

/**
 * _restaurarNuevosDesdeCsvDebug() [→ Contexto_Base_Web.md §14B111]
 */
function _restaurarNuevosDesdeCsvDebug() {
  var csvText = _loadCSVFromDrive(NOMBRE_CSV_DEBUG_NUEVOS);
  if (!csvText) { _borrarProgresoRestaurarNuevos(); return null; }
  var parsed = _parseCSV(csvText);
  if (!parsed || parsed.length < 2) { _borrarProgresoRestaurarNuevos(); return null; }

  var ss = _getSs();
  var dirData = _leerDirectorioFisicoComoDC(ss);
  var dirPorTag = {};
  for (var j = 0; j < dirData.length; j++) {
    var tg = String(dirData[j][DC.TAG - 1] || '').trim().toUpperCase();
    if (tg) dirPorTag[tg] = dirData[j];
  }
  var tz = Session.getScriptTimeZone() || 'GMT-5';

  var filas = parsed.slice(1); // Tag, Temporada, Fecha, Fecha_TS, Clan, Ataques, Fame, Barcos, ClanTag (la 9.ª es de §PF253; los CSV anteriores no la tienen)
  var porTag = {};
  var tagsDescartadosPorMembresia = {};

  // FIX (22-ago-2026): mapa de semanas construido UNA sola vez en vez de [→ Contexto_Base_Web.md §14B112]
  var mapaSemanas = _construirMapaSemanasGuerraTerna();

  for (var i = 0; i < filas.length; i++) {
    var f = filas[i];
    var tag = String(f[0] || '').trim().toUpperCase();
    if (!tag) continue;

    // Filtro de membresía -- "que siguen en el clan" (mismo criterio que
    // _purgarNuevosExpulsados()).
    var dRow = dirPorTag[tag];
    var sigueActivoEnTerna = dRow &&
      String(dRow[DC.ESTADO - 1]) === 'Activo' &&
      CFG.TERNA_TAGS.indexOf(String(dRow[DC.CLAN_TAG - 1])) >= 0;
    if (!sigueActivoEnTerna) { tagsDescartadosPorMembresia[tag] = true; continue; }

    // Filtro de "ya establecido" -- mismo criterio que _purgarNuevosEstablecidos().
    if (_contarSemanasGuerraTerna(tag, mapaSemanas) >= SEMANAS_MIN_PARA_PURGAR_DEBUG_NUEVOS) continue;

    // Fecha_TS (numérico, epoch ms) -- ver docblock de esta función. [→ Contexto_Base_Web.md §14B113]
    var fechaTs = Number(f[3]);
    if (!fechaTs) continue; // fila "placeholder" (tag sin registros) o Fecha_TS ausente (CSV de antes de este fix)

    // Domingo (guardado en Fecha_TS) -> Lunes (formato crudo que espera
    // _parseFechaISONuevos(), que le vuelve a restar 1 día).
    var fechaDomingo = new Date(fechaTs);
    fechaDomingo.setDate(fechaDomingo.getDate() + 1);
    var fechaCruda = Utilities.formatDate(fechaDomingo, tz, 'yyyy-MM-dd');

    if (!porTag[tag]) porTag[tag] = [];
    porTag[tag].push({
      temporada: f[1] || '',
      fecha: fechaCruda,
      clan: f[4] || '',
      ataques: Number(f[5]) || 0,
      fame: Number(f[6]) || 0,
      barcos: Number(f[7]) || 0,
      clanTag: String(f[8] || '').trim().toUpperCase() // §PF253: vacío en los CSV anteriores
    });
  }

  var candidatosPayload = [];
  for (var t in porTag) {
    candidatosPayload.push({ tag: t, registros: porTag[t] });
  }

  var totalDescartados = Object.keys(tagsDescartadosPorMembresia).length;
  if (totalDescartados > 0) {
    Logger.log('[Nuevos-Restaurar] ' + totalDescartados + ' Tag(s) del respaldo NO se restauraron ' +
      'por ya no ser miembros Activos de un clan Terna: ' + Object.keys(tagsDescartadosPorMembresia).join(', ') + '.');
  }
  if (!candidatosPayload.length) {
    Logger.log('[Nuevos-Restaurar] Nada que restaurar desde ' + NOMBRE_CSV_DEBUG_NUEVOS +
      ' (vacío, o ningún Tag califica tras el filtro de membresía/semanas).');
    _borrarProgresoRestaurarNuevos();
    return null;
  }

  // --- Descartar del payload los Tags que un intento anterior YA restauró
  //     (checkpoint) -- ver docblock de esta función.
  var tagsYaRestaurados = _cargarProgresoRestaurarNuevos() || [];
  var yaRestauradoSet = {};
  for (var k = 0; k < tagsYaRestaurados.length; k++) yaRestauradoSet[tagsYaRestaurados[k]] = true;

  var candidatosPendientes = candidatosPayload.filter(function (c) {
    return !yaRestauradoSet.hasOwnProperty(c.tag);
  });

  if (!candidatosPendientes.length) {
    // Todo lo que califica del respaldo ya se restauró en un intento
    // anterior -- checkpoint cumplido, se limpia.
    Logger.log('[Nuevos-Restaurar] Los ' + candidatosPayload.length +
      ' candidato(s) que califican del respaldo ya estaban restaurados (checkpoint). Nada pendiente.');
    _borrarProgresoRestaurarNuevos();
    return { ok: true, procesados: 0, filasNuevas: 0, filasEliminadas: 0, errores: [], completo: true, pendientes: 0 };
  }

  Logger.log('[Nuevos-Restaurar] ' + candidatosPendientes.length + ' candidato(s) pendiente(s) de restaurar desde ' +
    NOMBRE_CSV_DEBUG_NUEVOS + (tagsYaRestaurados.length ? ' (' + tagsYaRestaurados.length + ' ya restaurado(s) en un intento anterior).' : '.'));

  // --- Procesar en sub-lotes acotados por tiempo, guardando checkpoint [→ Contexto_Base_Web.md §14B114]
  var inicio = Date.now();
  var totalProcesados = 0, totalFilasNuevas = 0, totalFilasEliminadas = 0;
  var erroresAcumulados = [];
  var indice = 0;
  var seAgotoElPresupuesto = false;

  while (indice < candidatosPendientes.length) {
    if ((Date.now() - inicio) > NUEVOS_RESTORE_PRESUPUESTO_MS) {
      seAgotoElPresupuesto = true;
      break;
    }

    var subLote = candidatosPendientes.slice(indice, indice + NUEVOS_RESTORE_LOTE_MAX);
    var resultadoSubLote = _aplicarImportacionNuevos(subLote);

    if (resultadoSubLote && resultadoSubLote.ok) {
      totalProcesados += resultadoSubLote.procesados || 0;
      totalFilasNuevas += resultadoSubLote.filasNuevas || 0;
      totalFilasEliminadas += resultadoSubLote.filasEliminadas || 0;
      if (resultadoSubLote.errores && resultadoSubLote.errores.length) {
        erroresAcumulados = erroresAcumulados.concat(resultadoSubLote.errores);
      }
      // Sub-lote aplicado con éxito -- sus Tags pasan a "ya restaurados", [→ Contexto_Base_Web.md §14B115]
      for (var s = 0; s < subLote.length; s++) tagsYaRestaurados.push(subLote[s].tag);
    } else {
      Logger.log('[Nuevos-Restaurar] Sub-lote (' + subLote.length + ' candidato(s)) falló: ' +
        (resultadoSubLote && resultadoSubLote.error || 'respuesta inválida de _aplicarImportacionNuevos()') +
        ' -- se reintentará en la próxima corrida (no se marca como restaurado).');
    }

    indice += NUEVOS_RESTORE_LOTE_MAX;
    _guardarProgresoRestaurarNuevos(tagsYaRestaurados);
  }

  // pendientesReales: cuántos Tags del payload total (que califican por [→ Contexto_Base_Web.md §14B116]
  var pendientesReales = candidatosPayload.length - tagsYaRestaurados.length;
  if (pendientesReales < 0) pendientesReales = 0;

  if (pendientesReales === 0) {
    Logger.log('[Nuevos-Restaurar] Restauración completa: ' + tagsYaRestaurados.length + ' candidato(s) en total.');
    _borrarProgresoRestaurarNuevos();
  } else {
    Logger.log('[Nuevos-Restaurar] Presupuesto de tiempo (' + (NUEVOS_RESTORE_PRESUPUESTO_MS / 1000) +
      's) alcanzado -- ' + tagsYaRestaurados.length + ' candidato(s) restaurado(s) hasta ahora, ' +
      pendientesReales + ' pendiente(s) para la próxima corrida.');
  }

  return {
    ok: true,
    procesados: totalProcesados,
    filasNuevas: totalFilasNuevas,
    filasEliminadas: totalFilasEliminadas,
    errores: erroresAcumulados,
    completo: pendientesReales === 0,
    pendientes: pendientesReales
  };
}

/**
 * _asegurarBloquesParaFechas(sh, fechasNecesarias) [→ Contexto_Base_Web.md §14B117]
 */
/**
 * _seleccionarFechasNuevasNecesariasNuevos(sh, candidatosPayload) [→ Contexto_Base_Web.md §14B118]
 */
function _seleccionarFechasNuevasNecesariasNuevos(sh, candidatosPayload) {
  var bloques = _leerBloquesFechaNuevos(sh);

  function mismoDia(d1, d2) {
    return d1.getFullYear() === d2.getFullYear() && d1.getMonth() === d2.getMonth() && d1.getDate() === d2.getDate();
  }
  function existeBloque(fecha) {
    return bloques.some(function (bk) { return bk.date && mismoDia(bk.date, fecha); });
  }

  // FIX (12-ago-2026): bug reportado — "no está agregando la última semana [→ Contexto_Base_Web.md §14B119]
  var maxFechaExistente = null;
  for (var m = 0; m < bloques.length; m++) {
    if (bloques[m].date && (!maxFechaExistente || bloques[m].date.getTime() > maxFechaExistente.getTime())) {
      maxFechaExistente = bloques[m].date;
    }
  }

  var fechasNuevasNecesarias = [];
  function agregarSiFalta(fecha) {
    var yaEsta = fechasNuevasNecesarias.some(function (f) { return mismoDia(f, fecha); });
    if (!yaEsta) fechasNuevasNecesarias.push(fecha);
  }

  for (var c = 0; c < candidatosPayload.length; c++) {
    var registros = (candidatosPayload[c] || {}).registros || [];

    // Fechas del candidato, parseadas y deduplicadas por día.
    var fechasCand = [];
    for (var r = 0; r < registros.length; r++) {
      var f = _parseFechaISONuevos((registros[r] || {}).fecha);
      if (!f) continue;
      if (!fechasCand.some(function (ff) { return mismoDia(ff, f); })) fechasCand.push(f);
    }
    if (fechasCand.length === 0) continue;

    // a) Semana(s) nueva(s) — más reciente(s) que cualquier bloque ya
    //    existente en la hoja: SIEMPRE se agregan, incondicionalmente.
    var masRecientesQueTodo = fechasCand.filter(function (f) {
      return !maxFechaExistente || f.getTime() > maxFechaExistente.getTime();
    });
    for (var mr = 0; mr < masRecientesQueTodo.length; mr++) {
      agregarSiFalta(masRecientesQueTodo[mr]);
    }

    // b) Resto (nunca más nuevas que lo que ya hay en la hoja): mismo
    //    criterio de mínimo 5 que antes, aplicado solo sobre este subgrupo.
    var candidatasBackfill = fechasCand.filter(function (f) {
      return maxFechaExistente && f.getTime() <= maxFechaExistente.getTime();
    });

    var coincidentes = candidatasBackfill.filter(existeBloque);
    if (coincidentes.length >= GRID_NUM_BLOQUES_NUEVOS) continue; // ya cumple el mínimo: no crea nada más

    var sinBloque = candidatasBackfill.filter(function (f) { return !existeBloque(f); });
    sinBloque.sort(function (a, b) { return b.getTime() - a.getTime(); }); // más reciente primero

    var faltan = GRID_NUM_BLOQUES_NUEVOS - coincidentes.length;
    for (var k = 0; k < sinBloque.length && k < faltan; k++) {
      agregarSiFalta(sinBloque[k]);
    }
  }

  return fechasNuevasNecesarias;
}

// FASE 9 (Consolidado_Cambios_Pendientes_Guerra.md, punto 3): MIGRACIÓN DE [→ Contexto_Base_Web.md §14B120]

/**
 * _fechaATemporadaSemana(fecha) [→ Contexto_Base_Web.md §14B121]
 */
function _fechaATemporadaSemana(fecha) {
  if (!(fecha instanceof Date) || isNaN(fecha.getTime())) return null;
  var ref = CFG.REF_DEFAULT;
  if (!ref || isNaN(ref.getTime())) return null;

  // Mismo ajuste de "mes efectivo" que _calcularMesEfectivoRealDeHoy(), [→ Contexto_Base_Web.md §14B122]
  var anio = fecha.getFullYear();
  var mes  = fecha.getMonth();
  var primerLunesFechaMes = primerLunesDelMes(anio, mes);
  if (fecha < primerLunesFechaMes) {
    mes--;
    if (mes < 0) { mes = 11; anio--; }
  }
  var mesEfectivo = { anio: anio, mes: mes };
  var temporadaPropia = calcTemporadaDesdeMesEfectivo(ref, mesEfectivo);
  if (temporadaPropia < 1) return null; // fecha anterior a CFG.REF_DEFAULT, fuera de rango del proyecto

  var pl = primerLunesTemporada(ref, temporadaPropia);
  if (!pl || isNaN(pl.getTime())) return null;

  var periodIndex = Math.round((fecha.getTime() - pl.getTime()) / 86400000);
  if (periodIndex < 0) return null; // no debería pasar tras el ajuste de mes efectivo, red de seguridad
  var semana = Math.floor(periodIndex / 7) + 1;

  return { temporadaPropia: temporadaPropia, semana: semana, periodIndex: periodIndex };
}

/**
 * _mapaNombreClanATagTerna() [→ Contexto_Base_Web.md §14B123]
 */
function _mapaNombreClanATagTerna() {
  var mapa = {};
  var ss = _getSs();
  var sh = ss.getSheetByName(CFG.SHEETS.CLAN);
  if (sh && sh.getLastRow() >= 2) {
    var data = sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues(); // Orden, ClanTag, Nombre
    for (var i = 0; i < data.length; i++) {
      var tag = String(data[i][1] || '').trim();
      var nombre = String(data[i][2] || '').trim();
      if (nombre && CFG.TERNA_TAGS.indexOf(tag) >= 0) {
        mapa[nombre.toLowerCase()] = tag;
      }
    }
  }
  // Respaldo (hoja Clan sin datos todavía, ej. corrida muy temprana): usa
  // el mismo fallback que _getNombresClanesTernaOrdenados()/_resolverNombreClan().
  if (Object.keys(mapa).length === 0) {
    for (var j = 0; j < CFG.TERNA_TAGS.length; j++) {
      var tagJ = CFG.TERNA_TAGS[j];
      var nombreJ = _resolverNombreClan(tagJ);
      if (nombreJ) mapa[String(nombreJ).trim().toLowerCase()] = tagJ;
    }
  }
  return mapa;
}

/**
 * _migrarNuevosAHistorico(candidatosPayload) [→ Contexto_Base_Web.md §14B124]
 */
function _migrarNuevosAHistorico(candidatosPayload) {
  var statsGlobal = {
    temporadasProcesadas: 0, clavesMigradas: 0, clavesYaExistian: 0,
    descartadosPorMembresia: 0, sinHistorialParaVerificar: 0
  };
  if (!candidatosPayload || !candidatosPayload.length) return statsGlobal;

  var ctxReal = _getCtx();
  var offsetRoyaleApi = _getTemporadaOffsetRoyaleApi();
  var nombreClanATag = _mapaNombreClanATagTerna();
  // FIX (30-ago-2026): verificación cruzada e independiente del nombre de [→ Contexto_Base_Web.md §14B125]
  var ventanasPorTag = _construirVentanasMembresiaTernaPorTag();

  // 1) Agrupar registros -> por Temporada(propia), lista de entradas a
  //    migrar { tag, semana, ataquesSemana, fame, barcos, temporadaRoyaleApi }.
  var porTemporada = {};
  for (var c = 0; c < candidatosPayload.length; c++) {
    var cand = candidatosPayload[c] || {};
    var tag = String(cand.tag || '').trim().toUpperCase();
    if (!tag) continue;
    var registros = cand.registros || [];

    for (var r = 0; r < registros.length; r++) {
      var reg = registros[r] || {};

      // Punto 3: SOLO clanes Terna. reg.clan es el nombre tal cual lo [→ Contexto_Base_Web.md §14B126]
      var clanNombreReg = String(reg.clan || '').trim().toLowerCase();
      var clanTagReg = clanNombreReg ? nombreClanATag[clanNombreReg] : null;
      if (!clanTagReg) continue;

      var fechaReg = _parseFechaISONuevos(reg.fecha);
      if (!fechaReg) continue;

      // FIX (30-ago-2026): el nombre de clan ya no alcanza por sí solo —
      // se cruza contra Historial_I/S antes de aceptar el registro.
      var verificacionMembresia = _tagEstuvoEnTernaEnFecha(tag, fechaReg, ventanasPorTag);
      if (verificacionMembresia === false) {
        statsGlobal.descartadosPorMembresia++;
        Logger.log('[Nuevos-RoyaleAPI] _migrarNuevosAHistorico(): descartado Tag=' + tag +
          ' Fecha=' + fechaReg + ' ClanReportado="' + reg.clan + '" — Historial_I/S confirma que ' +
          'este Tag NO estuvo en ningún clan Terna esa fecha (posible bug de Tampermonkey o ' +
          'coincidencia de nombre con un clan rival). No se reconstruye.');
        continue;
      }
      if (verificacionMembresia === null) statsGlobal.sinHistorialParaVerificar++;

      var ts = _fechaATemporadaSemana(fechaReg);
      if (!ts) continue; // fecha fuera de rango de CFG.REF_DEFAULT, o inválida

      var ataquesVal = (reg.ataques === '' || reg.ataques === null || reg.ataques === undefined) ? null : Number(reg.ataques);
      var fameVal    = (reg.fame    === '' || reg.fame    === null || reg.fame    === undefined) ? null : Number(reg.fame);
      var barcosVal  = (reg.barcos  === '' || reg.barcos  === null || reg.barcos  === undefined) ? null : Number(reg.barcos);
      if (ataquesVal === null && fameVal === null && barcosVal === null) continue; // registro totalmente vacío, nada que migrar

      if (!porTemporada[ts.temporadaPropia]) porTemporada[ts.temporadaPropia] = [];
      porTemporada[ts.temporadaPropia].push({
        tag: tag,
        semana: ts.semana,
        ataquesSemana: ataquesVal || 0,
        fame: fameVal || 0,
        barcos: barcosVal, // null se preserva tal cual -- _reconstruirSemanaDesdeCero() ya sabe tratarlo como "sin dato"
        temporadaRoyaleApi: ts.temporadaPropia + offsetRoyaleApi
      });
    }
  }

  // 2) Por cada temporada distinta presente en el lote: cargar la fuente [→ Contexto_Base_Web.md §14B127]
  var temporadasKeys = Object.keys(porTemporada);
  for (var t = 0; t < temporadasKeys.length; t++) {
    var temporadaPropia = Number(temporadasKeys[t]);
    var entradas = porTemporada[temporadasKeys[t]];

    var fuente = _cargarFuenteGuerraParaTemporada(temporadaPropia, ctxReal.temporada);
    if (!fuente) {
      Logger.log('[Nuevos-RoyaleAPI] _migrarNuevosAHistorico(): no se pudo cargar la fuente de Guerra para temporada ' +
        temporadaPropia + ' (hoja Guerra no encontrada). Se omite esa temporada.');
      continue;
    }

    var offsetsPorClave = _construirOffsetsPorClave(fuente.filas, temporadaPropia);
    var statsLocal = {};
    var huboCambioTemporada = false;

    for (var e = 0; e < entradas.length; e++) {
      var entrada = entradas[e];
      var clave = entrada.tag + '|' + entrada.semana;

      if (offsetsPorClave[clave]) {
        // YA existe -- regla de no pisado (ver docblock de sección arriba): [→ Contexto_Base_Web.md §14B128]
        statsGlobal.clavesYaExistian++;
        continue;
      }

      _aplicarCorreccionAGuerraConReparto(
        fuente, offsetsPorClave, temporadaPropia, entrada.semana, entrada.tag,
        { ataquesSemana: entrada.ataquesSemana, fame: entrada.fame, barcos: entrada.barcos },
        { temporadaRoyaleApi: entrada.temporadaRoyaleApi },
        statsLocal
      );
      huboCambioTemporada = true;
      statsGlobal.clavesMigradas++;
    }

    if (huboCambioTemporada) {
      _guardarFuenteGuerra(fuente);
    }
    statsGlobal.temporadasProcesadas++;
  }

  return statsGlobal;
}

// --- ARCHIVO: 15_DeteccionInfiltrados.gs ---
// 15_DeteccionInfiltrados.gs
// Cruza miembros ACTUALES de los 4 clanes Terna contra los clanes rivales
// de la temporada de guerra vigente (currentriverrace, 09_API_ClashRoyale.gs)
// más una lista MANUAL de clanes en conflicto, mantenida en la hoja
// CFG.SHEETS.CONFLICTOS ('Conflictos', ver _setupConflictos() en
// 02_Setup_Hojas.gs).
// FASE 6 (punto 6 del documento — Detección de infiltrados/sabotaje). [→ Contexto_Base_Web.md §15B001]

// ORDEN DE ESTE ARCHIVO (regla 0.9 de la skill; 27-oct-2026): primero las constantes y variables globales; luego, por partes:
//  Parte 1 — Funciones que no se corren a mano
//    - Infiltrados: búsqueda desde la web de admin (en el orden de la llamada)
// Dentro de cada tema, en el orden en que se espera ejecutarlas. Al reordenar no se cambió el código de ninguna función.

// Columnas de la hoja 'Conflictos' (ver _setupConflictos(), 02_Setup_Hojas.gs). [→ Contexto_Base_Web.md §15B002]
var CFC = { TAG:1, NOMBRE:2, MOTIVO:3 };

var CFC_TOTAL_COLS = 3;

// =============================================================================
// PARTE 1 — FUNCIONES QUE NO SE CORREN A MANO
// =============================================================================

// ----- Infiltrados: búsqueda desde la web de admin (en el orden de la llamada) -----

/**
 * _webAdminBuscarInfiltrado(token, tag) [→ Contexto_Base_Web.md §15B009]
 */
function _webAdminBuscarInfiltrado(token, tag) {
  if (!_webAuthValidar(token)) return { ok: false, error: 'Sesión inválida o vencida. Vuelve a iniciar sesión.' };
  return _buscarInfiltrado(tag);
}

/**
 * _buscarInfiltrado(query) [→ Contexto_Base_Web.md §15B008]
 */
function _buscarInfiltrado(query) {
  var tagNorm = cleanTag(query);
  if (!tagNorm || tagNorm.length < 3) {
    return { ok: false, error: 'Ingresa un Tag de clan o de jugador (con o sin #).' };
  }

  var rivalesYConflicto = _getRivalesYConflicto();

  // 1) Probar como CLAN.
  var clanInfo = null;
  try {
    clanInfo = _apiGet('/clans/' + encodeTag('#' + tagNorm));
  } catch (eClan) {
    Logger.log('[DeteccionInfiltrados] /clans falló para ' + tagNorm + ': ' + eClan.message);
  }

  if (clanInfo && clanInfo.name && clanInfo.memberList) {
    var esRivalClan = !!rivalesYConflicto[tagNorm];
    var coincidenciasClan = [];
    for (var m = 0; m < clanInfo.memberList.length; m++) {
      var miembro = clanInfo.memberList[m];
      var tagMiembro = cleanTag(miembro.tag);
      var matches = _buscarEnRosterTerna(tagMiembro);
      if (matches.length) {
        coincidenciasClan.push({
          tagEnClanRival:    '#' + tagMiembro,
          nombreEnClanRival: miembro.name || '',
          rolEnClanRival:    mapRol(miembro.role),
          coincidencias:     matches
        });
      }
    }
    return {
      ok: true,
      tipo: 'clan',
      clan: { tag: '#' + tagNorm, nombre: clanInfo.name, miembros: clanInfo.memberList.length },
      esRivalTemporada: esRivalClan,
      infoRival: esRivalClan ? rivalesYConflicto[tagNorm] : null,
      coincidencias: coincidenciasClan
    };
  }

  // 2) Probar como JUGADOR.
  var playerInfo = null;
  try {
    playerInfo = _apiGet('/players/' + encodeTag('#' + tagNorm));
  } catch (ePlayer) {
    Logger.log('[DeteccionInfiltrados] /players falló para ' + tagNorm + ': ' + ePlayer.message);
  }

  if (playerInfo && playerInfo.name) {
    var clanActualTag = (playerInfo.clan && playerInfo.clan.tag) ? cleanTag(playerInfo.clan.tag) : '';
    var esRivalJugador = !!(clanActualTag && rivalesYConflicto[clanActualTag]);
    var historial = _buscarEnRosterTerna(tagNorm);
    return {
      ok: true,
      tipo: 'jugador',
      jugador: {
        tag: '#' + tagNorm,
        nombre: playerInfo.name,
        clanActual:    (playerInfo.clan && playerInfo.clan.name) || '',
        clanActualTag: clanActualTag ? '#' + clanActualTag : ''
      },
      esRivalTemporada: esRivalJugador,
      infoRival: esRivalJugador ? rivalesYConflicto[clanActualTag] : null,
      historialTerna: historial
    };
  }

  return { ok: false, error: 'No encontré ningún clan ni jugador con ese Tag. Verifica que esté bien escrito (incluyendo mayúsculas/minúsculas y los caracteres tras el #).' };
}

/**
 * _getRivalesYConflicto() [→ Contexto_Base_Web.md §15B006]
 */
function _getRivalesYConflicto() {
  var automatico = _getClanesRivalesTemporadaActual();
  var manual = _getClanesConflictoManual();

  var combinado = {};
  for (var tagM in manual) combinado[tagM] = manual[tagM];
  for (var tagA in automatico) {
    if (combinado[tagA] && combinado[tagA].fuente === 'manual') {
      combinado[tagA].fuente = 'currentriverrace+manual';
      combinado[tagA].clanTernaTag    = automatico[tagA].clanTernaTag;
      combinado[tagA].clanTernaNombre = automatico[tagA].clanTernaNombre;
      // motivo manual se conserva tal cual ya estaba en combinado[tagA]
    } else {
      combinado[tagA] = automatico[tagA];
    }
  }
  return combinado;
}

/**
 * _getClanesRivalesTemporadaActual() [→ Contexto_Base_Web.md §15B003]
 */
function _getClanesRivalesTemporadaActual() {
  var rivales = {};
  var propiosNorm = {};
  for (var p = 0; p < CFG.CLAN_TAGS.length; p++) {
    propiosNorm[cleanTag(CFG.CLAN_TAGS[p])] = true;
  }

  for (var i = 0; i < CFG.TERNA_TAGS.length; i++) {
    var clanTagPropio = CFG.TERNA_TAGS[i];
    var clanData = _getClanCache(clanTagPropio);
    if (!clanData || !clanData.riverrace) continue;

    var rr = clanData.riverrace;
    var clansRivales = rr.clans; // ver docblock: campo NUEVO, sin uso previo en el proyecto
    if (!clansRivales || !clansRivales.length) continue;

    var nombreClanPropio = (clanData.info && clanData.info.name) || '';

    for (var j = 0; j < clansRivales.length; j++) {
      var rival = clansRivales[j];
      var tagRival = cleanTag(rival && rival.tag);
      if (!tagRival || propiosNorm[tagRival]) continue;
      rivales[tagRival] = {
        tag: '#' + tagRival,
        nombre: (rival && rival.name) || '',
        fuente: 'currentriverrace',
        clanTernaTag: clanTagPropio,
        clanTernaNombre: nombreClanPropio
      };
    }
  }
  return rivales;
}

/**
 * _getClanesConflictoManual() [→ Contexto_Base_Web.md §15B004]
 */
function _getClanesConflictoManual() {
  var manual = {};
  var ss = _getSs();
  var mapaHoja = _leerHojaComoMapaPorTag(ss, CFG.SHEETS.CONFLICTOS, CFC.TAG - 1, CFC_TOTAL_COLS);
  // _leerHojaComoMapaPorTag() solo hace trim()+toUpperCase() sobre la [→ Contexto_Base_Web.md §15B005]
  for (var tagCrudo in mapaHoja) {
    var fila = mapaHoja[tagCrudo];
    var tagNorm = cleanTag(tagCrudo);
    if (!tagNorm) continue;
    manual[tagNorm] = {
      tag: '#' + tagNorm,
      nombre: String(fila[CFC.NOMBRE - 1] || ''),
      fuente: 'manual',
      motivo: String(fila[CFC.MOTIVO - 1] || '')
    };
  }
  return manual;
}

/**
 * _buscarEnRosterTerna(tagNorm) [→ Contexto_Base_Web.md §15B007]
 */
function _buscarEnRosterTerna(tagNorm) {
  if (!tagNorm) return [];
  var ss = _getSs();
  var resultado = [];

  var mapaDirectorio = _leerHojaComoMapaPorTag(ss, CFG.SHEETS.DIRECTORIO, IC.TAG - 1, DIR_SHEET_COLS);
  if (mapaDirectorio[tagNorm]) {
    var filaDir = mapaDirectorio[tagNorm];
    resultado.push({
      origen: 'Directorio',
      tag:    '#' + tagNorm,
      nombre: String(filaDir[IC.NOMBRE - 1] || ''),
      clan:   String(filaDir[IC.CLAN   - 1] || ''),
      razon:  ''
    });
  }

  var mapaInactivos = _leerHojaComoMapaPorTag(ss, CFG.SHEETS.INACTIVOS, IC.TAG - 1, INACTIVOS_TOTAL_COLS);
  if (mapaInactivos[tagNorm]) {
    var filaInact = mapaInactivos[tagNorm];
    resultado.push({
      origen: 'Inactivos',
      tag:    '#' + tagNorm,
      nombre: String(filaInact[IC.NOMBRE - 1] || ''),
      clan:   String(filaInact[IC.CLAN   - 1] || ''),
      razon:  String(filaInact[IC.RAZON  - 1] || '')
    });
  }

  var mapaVetados = _leerHojaComoMapaPorTag(ss, CFG.SHEETS.VETADOS, VC.TAG - 1, VETADOS_TOTAL_COLS);
  if (mapaVetados[tagNorm]) {
    var filaVet = mapaVetados[tagNorm];
    resultado.push({
      origen: 'Vetados',
      tag:    '#' + tagNorm,
      nombre: String(filaVet[VC.NOMBRE - 1] || ''),
      clan:   String(filaVet[VC.CLAN   - 1] || ''),
      razon:  String(filaVet[VC.RAZON  - 1] || '')
    });
  }

  return resultado;
}


// --- ARCHIVO: 16_ContactsSync.gs ---
// ==============================================================================
// 16_ContactsSync.gs
// Sincronizacion del Directorio con Google Contacts.
// ==============================================================================

// ORDEN DE ESTE ARCHIVO (regla 0.9 de la skill; 28-oct-2026): este archivo no tiene constantes ni variables globales y tiene una sola función; por partes:
//  Parte 1 — Funciones que se corren a mano
//    - Sincronización del Directorio con Google Contacts
//  Parte 2 — Funciones que no se corren a mano: ninguna
// Al reordenar no se cambió el código de ninguna función.

// =============================================================================
// PARTE 1 — FUNCIONES QUE SE CORREN A MANO
// =============================================================================

// ----- Sincronización del Directorio con Google Contacts -----

// 16_ContactsSync.gs [→ Contexto_Base_Web.md §16B001]

function SincronizarContactosNube() {
  Logger.log('[ContactsSync] Iniciando Sincronización de Contactos...');
  var startTime = Date.now();
  var MAX_TIME = 200000; // ~3.3 min

  var ss = _getSs();
  var shDir = ss.getSheetByName(CFG.SHEETS.DIRECTORIO);
  if (!shDir || shDir.getLastRow() < 2) {
    Logger.log('[ContactsSync] Directorio vacío o no existe.');
    return;
  }

  // 1. Mapeo DINÁMICO de columnas según la Fila 1
  var headers = shDir.getRange(1, 1, 1, shDir.getLastColumn()).getValues()[0];

  function buscarColumna(nombreCabecera) {
    var idx = headers.findIndex(function(h) {
      return String(h).trim().toLowerCase() === nombreCabecera.toLowerCase();
    });
    if (idx === -1) {
      Logger.log('[ContactsSync] ADVERTENCIA: No se encontró la columna "' + nombreCabecera + '"');
    }
    return idx;
  }

  var C = {
    TAG: buscarColumna('Tag'),
    NOMBRE: buscarColumna('Nombre'),
    JUGADOR: buscarColumna('Jugador'),
    NOM_MULTI: buscarColumna('Nom_Multi'),
    RANGO: buscarColumna('Rango'),
    CLAN: buscarColumna('Clan'),
    PREFIJO: buscarColumna('Prefijo'),
    CELULAR: buscarColumna('Celular'),
    ESTADO: buscarColumna('Estado')
  };

  // Columna con el TAG del clan (ej. "#GCRG8L00"), para el sufijo (C-1,2,3...). [→ Contexto_Base_Web.md §16B002]
  C.CLAN_TAG = buscarColumna('ClanTag');
  if (C.CLAN_TAG === -1) C.CLAN_TAG = buscarColumna('Clan Tag');

  Logger.log('[ContactsSync] Índices mapeados -> CELULAR: ' + C.CELULAR + ', ESTADO: ' + C.ESTADO + ', JUGADOR: ' + C.JUGADOR);

  if (C.CELULAR === -1 || C.ESTADO === -1 || C.JUGADOR === -1) {
    Logger.log('[ContactsSync] Error: Faltan columnas críticas en el Directorio. Abortando.');
    return;
  }

  // 2. Leer todos los datos de la tabla
  var data = shDir.getRange(2, 1, shDir.getLastRow() - 1, headers.length).getValues();
  Logger.log('[ContactsSync] Total filas leídas del Directorio: ' + data.length);

  // 3. Agrupar por teléfono (solo activos)
  var grupos = {};
  var contActivos = 0;
  var contConTelefono = 0;

  for (var i = 0; i < data.length; i++) {
    var f = data[i];
    var estadoCelda = String(f[C.ESTADO] || '').trim().toUpperCase();

    if (estadoCelda !== 'ACTIVO') continue;
    contActivos++;

    // Limpieza de caracteres vacíos u ocultos
    var pref = String(f[C.PREFIJO] || '').replace(/\D/g, '');
    var cel  = String(f[C.CELULAR] || '').replace(/\D/g, '');

    if (!cel || cel === '0' || cel === '') continue;
    contConTelefono++;

    if (!pref) {
      if (cel.length > 9) pref = '';
      else pref = (typeof CFG !== 'undefined' && CFG.PREFIJO_DEFAULT) ? CFG.PREFIJO_DEFAULT : '51';
    }

    var phone = '+' + pref + cel;

    if (!grupos[phone]) {
      grupos[phone] = {
        phone: phone,
        listaJugadores: [], // Aquí acumularemos los textos únicos de la columna Jugador
        nomMulti: String(f[C.NOM_MULTI] || '').trim(),
        nombres: [],
        clan: String(f[C.CLAN] || 'Sin Clan').trim(),
        // NUEVO: acumula TODOS los tags de clan distintos que aparecen en [→ Contexto_Base_Web.md §16B003]
        clanTagsTodos: [],
        rango: String(f[C.RANGO] || '').trim(),
        tags: [],
        // Excepción del fundador: mismo chequeo que _calcJugador() en [→ Contexto_Base_Web.md §16B004]
        esFundador: false
      };
    }
    var g = grupos[phone];
    if (_getFundadorCelular_() && cel === _getFundadorCelular_()) g.esFundador = true;

    // FUENTE DE VERDAD: Extrae y acumula de manera única la celda de la columna Jugador
    var jugadorTexto = String(f[C.JUGADOR] || '').trim();
    if (jugadorTexto && g.listaJugadores.indexOf(jugadorTexto) < 0) {
      g.listaJugadores.push(jugadorTexto);
    }

    var nom = String(f[C.NOMBRE] || '').trim();
    if (nom && g.nombres.indexOf(nom) < 0) g.nombres.push(nom);

    var tag = String(f[C.TAG] || '').trim();
    if (tag && g.tags.indexOf(tag) < 0) g.tags.push(tag);

    var clanTagFila = (C.CLAN_TAG !== -1) ? String(f[C.CLAN_TAG] || '').trim() : '';
    if (clanTagFila && g.clanTagsTodos.indexOf(clanTagFila) < 0) g.clanTagsTodos.push(clanTagFila);
  }

  Logger.log('[ContactsSync] Resumen de lectura: ' + contActivos + ' activos encontrados, ' + contConTelefono + ' con teléfono válido.');

  var totalAgrupados = Object.keys(grupos).length;
  Logger.log('[ContactsSync] Total números de teléfono únicos a procesar: ' + totalAgrupados);

  if (totalAgrupados === 0) {
    Logger.log('[ContactsSync] No hay contactos para sincronizar. Terminando temprano.');
    return;
  }

  // 3.5. Códigos de clan para el sufijo "(C-1,2,3...)" del nombre. [→ Contexto_Base_Web.md §16B005]
  function normalizarClanTag(tag) {
    return String(tag || '')
      .replace(/#/g, '')
      .trim()
      .toUpperCase();
  }

  var FIJOS_CLAN_CODIGO = {};
  FIJOS_CLAN_CODIGO[normalizarClanTag('#GCRG8L00')] = 1;
  FIJOS_CLAN_CODIGO[normalizarClanTag('#GYCU9YRG')] = 2;
  FIJOS_CLAN_CODIGO[normalizarClanTag('#GQQPPJGR')] = 3;
  FIJOS_CLAN_CODIGO[normalizarClanTag('#GG99LCJY')] = 4;

  function obtenerMapaCodigosClan(clanesNormalizadosEncontrados) {
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty('CLAN_CODIGOS_MAP');
    var mapa = raw ? JSON.parse(raw) : {};

    // Sembrar los 4 códigos fijos si todavía no estaban guardados.
    for (var key in FIJOS_CLAN_CODIGO) {
      if (!(key in mapa)) mapa[key] = FIJOS_CLAN_CODIGO[key];
    }

    var usados = {};
    for (var k in mapa) usados[mapa[k]] = true;
    var siguienteLibre = 1;
    function proximoCodigoLibre() {
      while (usados[siguienteLibre]) siguienteLibre++;
      return siguienteLibre;
    }

    var huboNuevo = false;
    clanesNormalizadosEncontrados.forEach(function(clanNorm) {
      if (clanNorm && !(clanNorm in mapa)) {
        var nuevoCodigo = proximoCodigoLibre();
        mapa[clanNorm] = nuevoCodigo;
        usados[nuevoCodigo] = true;
        huboNuevo = true;
        Logger.log('[ContactsSync] Clan nuevo detectado (tag: ' + clanNorm + '), se le asignó el código C-' + nuevoCodigo + ' de forma permanente.');
      }
    });

    if (huboNuevo || !raw) {
      props.setProperty('CLAN_CODIGOS_MAP', JSON.stringify(mapa));
    }
    return mapa;
  }

  // Recolectar, normalizados, todos los tags de clan distintos vistos en
  // esta ejecución (excluyendo vacíos: teléfonos sin clan no llevan código).
  var clanesVistosNormalizados = {};
  for (var phoneKey in grupos) {
    grupos[phoneKey].clanTagsTodos.forEach(function(tagClan) {
      if (tagClan) clanesVistosNormalizados[normalizarClanTag(tagClan)] = true;
    });
  }
  var mapaCodigosClan = obtenerMapaCodigosClan(Object.keys(clanesVistosNormalizados));

  // 4. Cache de Etiquetas (ContactGroups)
  var groupMap = {};
  try {
    var groupsResponse = People.ContactGroups.list();
    var contactGroups = groupsResponse.contactGroups || [];
    for (var i = 0; i < contactGroups.length; i++) {
      groupMap[contactGroups[i].name] = contactGroups[i].resourceName;
    }
  } catch(e) {
    Logger.log('[ContactsSync] Error al listar grupos: ' + e.message);
  }

  function getOrCreateGroup(clanName) {
    if (groupMap[clanName]) return groupMap[clanName];
    try {
      var newGroup = People.ContactGroups.create({
        contactGroup: { name: clanName }
      });
      groupMap[clanName] = newGroup.resourceName;
      return newGroup.resourceName;
    } catch(e) {
      if (e.message && e.message.indexOf('409') !== -1) {
        Utilities.sleep(500);
        var grps = People.ContactGroups.list().contactGroups || [];
        for (var k = 0; k < grps.length; k++) {
          if (grps[k].name === clanName) {
            groupMap[clanName] = grps[k].resourceName;
            return grps[k].resourceName;
          }
        }
      }
      return null;
    }
  }

  // 5. Leer contactos existentes en Google Contacts
  var existingContacts = {};
  var requestParams = {
    personFields: 'names,phoneNumbers,biographies,memberships',
    pageSize: 1000
  };

  try {
    var pageToken = null;
    do {
      if (pageToken) requestParams.pageToken = pageToken;
      var connResponse = People.People.Connections.list('people/me', requestParams);
      var connections = connResponse.connections || [];

      for (var i = 0; i < connections.length; i++) {
        var person = connections[i];
        var bio = (person.biographies && person.biographies.length > 0) ? person.biographies[0].value : '';
        if (bio.indexOf('[CLASH ROYALE DATA]') !== -1) {
          if (person.phoneNumbers && person.phoneNumbers.length > 0) {
            var ph = person.phoneNumbers[0].canonicalForm || person.phoneNumbers[0].value;
            ph = String(ph).replace(/[^\d+]/g, '');
            existingContacts[ph] = person;
          }
        }
      }
      pageToken = connResponse.nextPageToken;
    } while (pageToken);
  } catch(e) {
    Logger.log('[ContactsSync] Error leyendo conexiones: ' + e.message);
  }

  Logger.log('[ContactsSync] Contactos existentes identificados en la nube: ' + Object.keys(existingContacts).length);

  // 6. Crear o Actualizar Contactos
  var creados = 0;
  var actualizados = 0;

  // Acumuladores para el resumen amigable del final. NOTA: "resumen.creados" [→ Contexto_Base_Web.md §16B006]
  var resumen = { creados: [], actualizados: [], fallidos: [] };

  for (var phone in grupos) {
    if (Date.now() - startTime > MAX_TIME) {
      Logger.log('[ContactsSync] Tiempo máximo alcanzado. Saliendo limpiamente.');
      return;
    }

    var g = grupos[phone];

    // DEFINICIÓN DEL NOMBRE: Usa estrictamente los datos de la columna Jugador. [→ Contexto_Base_Web.md §16B007]
    var contactName = g.esFundador
      ? CFG.FUNDADOR.jugador
      : (g.listaJugadores.length > 0 ? g.listaJugadores.join(' / ') : g.nombres.join(' / '));

    // Sufijo "(C-1,2,3...)": un número por cada clan distinto (por tag) en el [→ Contexto_Base_Web.md §16B008]
    var codigosDelTelefono = [];
    g.clanTagsTodos.forEach(function(tagClan) {
      if (!tagClan) return;
      var num = mapaCodigosClan[normalizarClanTag(tagClan)];
      if (num && codigosDelTelefono.indexOf(num) < 0) codigosDelTelefono.push(num);
    });
    codigosDelTelefono.sort(function(a, b) { return a - b; });
    if (codigosDelTelefono.length > 0) {
      contactName = contactName + ' (C-' + codigosDelTelefono.join(',') + ')';
    }

    var bioText = '[CLASH ROYALE DATA]\nTEL: ' + phone + '\nTAGS: ' + g.tags.join(', ') + '\nCLAN: ' + g.clan + '\nRANGO: ' + g.rango;
    var clanGroupRes = getOrCreateGroup(g.clan);

    var personObj = {
      names: [{ givenName: contactName }],
      phoneNumbers: [{ value: phone }],
      biographies: [{ value: bioText }]
    };

    if (clanGroupRes) {
      personObj.memberships = [{ contactGroupMembership: { contactGroupResourceName: clanGroupRes } }];
    }

    try {
      if (existingContacts[phone]) {
        var resourceName = existingContacts[phone].resourceName;
        var etag = existingContacts[phone].etag;
        personObj.etag = etag;
        People.People.updateContact(personObj, resourceName, { updatePersonFields: 'names,phoneNumbers,biographies,memberships' });
        actualizados++;
        resumen.actualizados.push({ nombre: contactName, clan: g.clan });
        // NOTA: ya NO se borra "existingContacts[phone]" aquí. Antes se hacía [→ Contexto_Base_Web.md §16B009]
      } else {
        People.People.createContact(personObj);
        creados++;
        resumen.creados.push({ nombre: contactName, clan: g.clan });
      }
    } catch(e) {
      // Detecta cualquier variante de error de cuota, no solo '429': la API [→ Contexto_Base_Web.md §16B010]
      var msg = String(e.message || '');
      var esErrorDeCuota = /429|quota exceeded|resource_exhausted/i.test(msg);

      if (esErrorDeCuota) {
        var reintentoOk = false;
        // Backoff exponencial: 2s, 4s, 8s. Suficiente para que la cuota "por
        // minuto" se libere sin consumir todo el presupuesto de MAX_TIME.
        for (var intento = 1; intento <= 3 && !reintentoOk; intento++) {
          Utilities.sleep(2000 * intento);
          try {
            if (existingContacts[phone]) {
              People.People.updateContact(personObj, existingContacts[phone].resourceName, { updatePersonFields: 'names,phoneNumbers,biographies,memberships' });
              actualizados++;
              resumen.actualizados.push({ nombre: contactName, clan: g.clan });
            } else {
              People.People.createContact(personObj);
              creados++;
              resumen.creados.push({ nombre: contactName, clan: g.clan });
            }
            reintentoOk = true;
          } catch(e2) {
            msg = String(e2.message || '');
            if (intento === 3) {
              // Explicación en lenguaje simple, pensada para alguien sin [→ Contexto_Base_Web.md §16B011]
              Logger.log('[ContactsSync] No se pudo sincronizar el contacto "' + contactName +
                '" tras 3 intentos. Motivo: Google limita cuántos contactos se pueden crear o ' +
                'actualizar por minuto (una "cuota" de escritura), y ese límite se alcanzó durante ' +
                'esta ejecución. Esto NO significa que el jugador se haya perdido ni que su contacto ' +
                'se vaya a borrar: simplemente esta actualización puntual no se aplicó ahora, y debería ' +
                'corregirse sola en la próxima sincronización.');
              resumen.fallidos.push({ nombre: contactName, clan: g.clan, motivo: 'cuota' });
            }
          }
        }
      } else {
        Logger.log('[ContactsSync] No se pudo sincronizar el contacto "' + contactName +
          '". Motivo: ' + msg + '. Esto no fue un problema de cuota: puede deberse a datos con un ' +
          'formato que Google Contacts no acepta (por ejemplo, un número de teléfono raro) o a un ' +
          'problema temporal del servicio de Google. El jugador tampoco se borra por esto.');
        resumen.fallidos.push({ nombre: contactName, clan: g.clan, motivo: 'otro' });
      }
    }

    // Pausa proactiva entre escrituras (create/update cuentan como "critical [→ Contexto_Base_Web.md §16B012]
    Utilities.sleep(350);
  }

  Logger.log('[ContactsSync] Procesados -> Creados: ' + creados + ', Actualizados: ' + actualizados);

  // 7. Eliminar contactos de jugadores obsoletos [→ Contexto_Base_Web.md §16B013]
  var orphanPhones = [];
  for (var ePhone in existingContacts) {
    if (!grupos[ePhone]) orphanPhones.push(ePhone);
  }

  var eliminados = 0;
  var resumenEliminados = []; // {nombre, clan}, para el resumen final por clan

  for (var oi = 0; oi < orphanPhones.length; oi++) {
    var orphanPhone = orphanPhones[oi];
    var personOrfano = existingContacts[orphanPhone];
    var nombreOrfano = (personOrfano.names && personOrfano.names[0] &&
      (personOrfano.names[0].displayName || personOrfano.names[0].givenName)) || orphanPhone;
    var bioOrfano = (personOrfano.biographies && personOrfano.biographies[0]) ? personOrfano.biographies[0].value : '';
    var clanMatch = bioOrfano.match(/CLAN:\s*(.+)/);
    var clanOrfano = clanMatch ? clanMatch[1].trim() : '';

    try {
      People.People.deleteContact(personOrfano.resourceName);
      eliminados++;
      resumenEliminados.push({ nombre: nombreOrfano, clan: clanOrfano });
    } catch(e) {}
  }

  if (eliminados > 0) {
    Logger.log('[ContactsSync] Eliminados (inactivos antiguos): ' + eliminados);
  }

  // 8. Resumen amigable, agrupado por clan: qué se agregó y qué se eliminó. [→ Contexto_Base_Web.md §16B014]
  function agruparPorClan(lista) {
    var mapa = {};
    var orden = [];
    for (var idx = 0; idx < lista.length; idx++) {
      var item = lista[idx];
      var clanKey = (item.clan && item.clan.trim() && item.clan.trim() !== 'Sin Clan')
        ? item.clan.trim()
        : '__SIN_CLAN__';
      if (!mapa[clanKey]) {
        mapa[clanKey] = [];
        orden.push(clanKey);
      }
      mapa[clanKey].push(item.nombre);
    }
    return { mapa: mapa, orden: orden };
  }

  var aGrp = agruparPorClan(resumen.creados);
  var eGrp = agruparPorClan(resumenEliminados);

  // Unión de clanes reales (sin duplicar), en orden alfabético para que el
  // resumen sea fácil de leer y predecible ejecución tras ejecución.
  var clanesReales = [];
  var vistos = {};
  [aGrp.orden, eGrp.orden].forEach(function(orden) {
    orden.forEach(function(c) {
      if (c !== '__SIN_CLAN__' && !vistos[c]) {
        vistos[c] = true;
        clanesReales.push(c);
      }
    });
  });
  clanesReales.sort();

  var agSinClan = aGrp.mapa['__SIN_CLAN__'] || [];
  var elSinClan = eGrp.mapa['__SIN_CLAN__'] || [];

  Logger.log('--- Resumen de cambios por clan ---');
  if (clanesReales.length === 0 && agSinClan.length === 0 && elSinClan.length === 0) {
    Logger.log('No hubo contactos agregados ni eliminados en esta ejecución.');
  } else {
    clanesReales.forEach(function(clan) {
      var ag = aGrp.mapa[clan] || [];
      var el = eGrp.mapa[clan] || [];
      if (ag.length > 0) Logger.log('[' + clan + '] Agregados: ' + ag.join(', '));
      if (el.length > 0) Logger.log('[' + clan + '] Eliminados: ' + el.join(', '));
    });

    if (agSinClan.length > 0) Logger.log('[Sin clan identificado] Agregados: ' + agSinClan.join(', '));
    if (elSinClan.length > 0) Logger.log('[Sin clan identificado] Eliminados: ' + elSinClan.join(', '));
  }

  // 9. Explicación final, en lenguaje simple, si hubo fallos de sincronización
  if (resumen.fallidos.length > 0) {
    Logger.log('--- Por qué algunos contactos no se pudieron sincronizar ---');
    Logger.log('Hubo ' + resumen.fallidos.length + ' contacto(s) que no se pudieron guardar en Google Contacts ' +
      'en esta ejecución: ' + resumen.fallidos.map(function(f){ return f.nombre; }).join(', ') + '.');
    Logger.log('La causa más común es la cuota de Google: la cuenta solo puede crear o modificar una ' +
      'cierta cantidad de contactos por minuto, y con muchos jugadores sincronizándose de una vez es ' +
      'normal alcanzar ese límite en algún punto del proceso.');
    Logger.log('Estos jugadores NO se eliminan ni se pierden por este motivo: solo quedaron pendientes de ' +
      'actualizar y se corrigen solos en la próxima sincronización automática.');
  }

  Logger.log('[ContactsSync] Sincronización completada en ' + (Date.now() - startTime) + ' ms.');
}


