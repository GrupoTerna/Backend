      var reqMinCRDesc  = bloqueDesc.minCR[rolKey];
      var reqAtaquesDesc = bloqueDesc.ataques[rolKey];
      // 28-sep-2026 (decision del usuario): solo cuentan las semanas completas de ESTE jugador;
