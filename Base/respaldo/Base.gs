    }
    return mapa;
  }

  var h = Math.floor(k / 2);
  var izqIdx = [], derIdx = [];
  for (var u = 0; u < k; u++) { if (u < h) izqIdx.push(u); else derIdx.push(u); }
  function resolver(cats) {
