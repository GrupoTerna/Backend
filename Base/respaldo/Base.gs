      }
      resp.docxBase64 = Utilities.base64Encode(_docxFuenteArial_(respWord.getContent())); // PF230: Google exporta «Arial Unicode MS» en algunos textos; se deja Arial
      resp.nombreArchivo = NOMBRE_DOC_GANADORES_SORTEO + '.docx';
    }
