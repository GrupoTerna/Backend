    var m2 = /^(\d{4})-(\d{2})-(\d{2})(?:[T\s].*)?$/.exec(s);
    if (m1) { d = +m1[1]; mo = +m1[2]; y = +m1[3]; }
    else if (m2) { y = +m2[1]; mo = +m2[2]; d = +m2[3]; }
