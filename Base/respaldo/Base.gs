  { nombre: 'Ataques', ancho: 7, extras: ['Total', '%'] },
  { nombre: 'Puntaje', ancho: 7, extras: ['Prom', '%'] },
  { nombre: 'Barcos',  ancho: 6, extras: ['Total'] }
];

