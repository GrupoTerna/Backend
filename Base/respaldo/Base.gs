// Actualiza el CSV según PLAYERS_API_ENABLED; reusa _mergearCards2CSV() (merge por Tag, nunca vacía). [→ Contexto_Base_Web.md §33B004]
function updateCaminoLeyendasSheet() {
  if (PLAYERS_API_ENABLED === false) {
