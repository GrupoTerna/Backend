// Punto de entrada web (GET, solo lectura) del resumen semanal; cada sección devuelve su propio {ok, ...}. [→ Contexto_Base_Web.md §40B003]
function _webAdminNoticiasSemana(token, lunesIso) {
  if (!_webAuthValidar(token)) return { ok: false, error: 'Sesión inválida o vencida. Vuelve a iniciar sesión.' };

  var lunes = String(lunesIso || '').trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(lunes)) return { ok: false, error: 'Falta elegir la semana.' };

  // La semana debe ser una de las que ya entrega el selector de Torneos/Sorteos
  // (así se obtienen Temporada/Semana reales y el domingo, sin recalcular nada).
  var lista = _webAdminSemanasRecientes(token, '1');
  if (!lista || !lista.ok) return { ok: false, error: (lista && lista.error) || 'No pude leer la lista de semanas.' };
  var semana = null;
  for (var i = 0; i < lista.semanas.length; i++) {
    if (lista.semanas[i].lunesIso === lunes) { semana = lista.semanas[i]; break; }
  }
  if (!semana) return { ok: false, error: 'Esa semana no está en la lista de semanas disponibles.' };

  return {
    ok: true,
    semana: semana,
    barcos: _noticiasSeccion_(function () { return _noticiasBarcos_(semana); }),
    ascensos: _noticiasSeccion_(function () { return _noticiasAscensos_(semana); }),
    posiciones: _noticiasSeccion_(function () { return _noticiasPosiciones_(semana); }),
    guerra: _noticiasSeccion_(function () { return _noticiasGuerra_(semana); }),
    movimientos: _noticiasSeccion_(function () { return _noticiasMovimientos_(semana); })
  };
}

/** Ejecuta una sección; un error en ella NO tumba a las demás. */
function _noticiasSeccion_(fn) {
  try {
    return fn();
  } catch (err) {
    Logger.log('[Noticias] Error en una sección: ' + err.toString());
    return { ok: false, error: 'No se pudo armar esta sección (' + err.message + ').' };
  }
}

/** 'yyyy-MM-dd' + n días -> 'yyyy-MM-dd' (aritmética UTC pura, sin husos). */
function _noticiasSumarDias_(iso, n) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
  var t = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3] + n));
  var p = function (x) { return (x < 10 ? '0' : '') + x; };
  return t.getUTCFullYear() + '-' + p(t.getUTCMonth() + 1) + '-' + p(t.getUTCDate());
}

// -----------------------------------------------------------------------------
// 1) ATAQUES A BARCOS
// -----------------------------------------------------------------------------

// Mes evaluado de una temporada (temporada 1 = mayo 2026, +1 por mes; empieza el primer lunes del mes); null si no es un entero >= 1 (06-oct-2026). [→ Contexto_Base_Web.md §40B004]
function _noticiasMesDeTemporada_(temporada) {
  var t = Number(temporada);
  if (!isFinite(t) || t < 1 || Math.floor(t) !== t) return null;
  var MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  var idx = 4 + (t - 1); // mayo = índice 4 (temporada 1, año 2026)
  var mes = MESES[idx % 12], anio = 2026 + Math.floor(idx / 12);
  return { mes: mes, anio: anio, etiqueta: mes + ' ' + anio };
}

// Etiqueta de un sorteo: temporada evaluada, semanas y mes (ej. «Temporada 5 (septiembre 2026), semanas 1-4») (06-oct-2026). [→ Contexto_Base_Web.md §40B005]
function _noticiasEtiquetaSorteo_(celdaSemanas) {
  var arr = (typeof _parseSemanasSorteo === 'function') ? _parseSemanasSorteo(celdaSemanas) : [];
  if (!arr || !arr.length) return '';
  var porTemp = {};
  arr.forEach(function (a) {
    var t = Number(a.temporada), w = Number(a.semana);
    if (!isFinite(t) || !isFinite(w)) return;
    (porTemp[t] || (porTemp[t] = [])).push(w);
  });
  return Object.keys(porTemp).map(Number).sort(function (a, b) { return a - b; }).map(function (t) {
    var ws = porTemp[t].filter(function (w, i, a) { return a.indexOf(w) === i; }).sort(function (a, b) { return a - b; });
    var tramos = [], ini = ws[0], prev = ws[0];
    for (var i = 1; i <= ws.length; i++) {
      if (i < ws.length && ws[i] === prev + 1) { prev = ws[i]; continue; }
      tramos.push(ini === prev ? String(ini) : ini + '-' + prev);
      ini = prev = ws[i];
    }
    var m = _noticiasMesDeTemporada_(t);
    return 'Temporada ' + t + (m ? ' (' + m.etiqueta + ')' : '') + ', semana' + (ws.length > 1 ? 's ' : ' ') + tramos.join(', ');
  }).join(' + ');
}

// Topes de ataques a barcos por evento de la semana (torneo, sorteo, cambio de rango; suma de la semana; 0 es válido, vacío = sin tope) (05-oct-2026). [→ Contexto_Base_Web.md §40B006]
function _noticiasLimitesBarcos_(semana) {
  var res = [];
  var ss = _getSs();
  var temp = Number(semana.temporada), sem = Number(semana.semana);
  function incluyeSemana(celda) {
    var arr = _parseSemanasSorteo(celda);
    for (var i = 0; i < arr.length; i++) if (arr[i].temporada === temp && arr[i].semana === sem) return true;
    return false;
  }
  function leer(origen, hoja, csv, cols, hdr, C, nombreFn) {
    try {
      var lec = _obtenerFilasConFallbackCSV(ss, hoja, csv, cols, hdr);
      if (!lec || lec.origen === 'vacio') return;
      for (var i = 0; i < lec.filas.length; i++) {
        var f = lec.filas[i];
        if (!incluyeSemana(f[C.SEMANAS - 1])) continue;
        var c = f[C.BARCOS - 1];
        if (c === '' || c === null || c === undefined) continue; // sin tope configurado
        var q = Number(c);
        if (isNaN(q)) continue;
        res.push({ origen: origen, id: String(f[C.ID - 1] || '').trim(), nombre: nombreFn(f), qty: q });
      }
    } catch (e) {
      Logger.log('[Noticias] No pude leer los topes de barcos de ' + origen + ': ' + e.message);
    }
  }
  if (typeof TL !== 'undefined' && typeof _parseSemanasSorteo === 'function') {
    leer('Torneo', CFG.SHEETS.T_LISTA, 'Backup_T_Lista.csv', TL_TOTAL_COLS, 2, TL, function (f) { return String(f[TL.NOMBRE - 1] || '').trim(); });
    leer('Sorteo', CFG.SHEETS.S_LISTA, 'Backup_S_Lista.csv', SL_TOTAL_COLS, 2, SL, function (f) { return _noticiasEtiquetaSorteo_(f[SL.SEMANAS - 1]); });
    leer('Cambio de rango', CFG.SHEETS.CR_LISTA, 'Backup_CR_Lista.csv', CR_TOTAL_COLS, 3, CR, function (f) { return String(f[CR.TIPO - 1] || '').trim(); });
  }
  return res;
}

// Ataques a barcos por jugador y clan en la semana (jueves a domingo) desde Backup_Battlelogs.csv; solo cuentan filas boatBattle con LadoBarco de ataque. [→ Contexto_Base_Web.md §40B007]
function _noticiasBarcos_(semana) {
  if (typeof _blsLeerCsv_ !== 'function' || typeof BLS_HEADERS === 'undefined' || typeof BLS_CSV_NOMBRE === 'undefined' ||
      typeof _blgLimitesDiasGuerra_ !== 'function' || typeof _blgDiaDeBatalla_ !== 'function' ||
      typeof _blgParsearBattleTime_ !== 'function') {
    return { ok: false, error: 'Falta 06_Battlelogs_Siembra.gs o 18_CorreccionGuerra.gs en el proyecto.' };
  }

  var jueves = _noticiasSumarDias_(semana.lunesIso, 3);
  var limites = _blgLimitesDiasGuerra_(jueves, null);
  if (!limites) return { ok: false, error: 'No pude calcular los días de guerra de la semana (' + jueves + ').' };

  var lectura = _blsLeerCsv_(BLS_CSV_NOMBRE, BLS_HEADERS);
  if (!lectura.ok) return { ok: false, error: lectura.error || 'No pude leer Backup_Battlelogs.csv.' };

  var iTag = BLS_HEADERS.indexOf('Tag'), iNombre = BLS_HEADERS.indexOf('Nombre');
  var iTiempo = BLS_HEADERS.indexOf('battleTime'), iTipo = BLS_HEADERS.indexOf('Tipo');
  var iClanTag = BLS_HEADERS.indexOf('ClanTag'), iClanNombre = BLS_HEADERS.indexOf('ClanNombre');
  var iGanado = BLS_HEADERS.indexOf('BarcoGanado'), iLado = BLS_HEADERS.indexOf('LadoBarco');

  var defensas = 0, sinLado = 0, dudosas = 0, filasSemana = 0;
  var clanes = {}; // clave de clan -> { clan, jugadores:{tag->{...}} }

  for (var i = 0; i < lectura.rows.length; i++) {
    var f = lectura.rows[i];
    if (String(f[iTipo] || '').trim() !== 'boatBattle') continue;

    var ms = _blgParsearBattleTime_(f[iTiempo]);
    if (ms === null) continue;
    var dia = _blgDiaDeBatalla_(ms, limites);
    if (dia.estado === 'fuera' || dia.estado === 'invalido') continue;
    if (dia.estado === 'ambiguo' && dia.puedeSerFuera) { dudosas++; continue; }
    filasSemana++;

    var lado = String(f[iLado] === undefined || f[iLado] === null ? '' : f[iLado]).trim().toLowerCase();
    if (lado === 'defender') { defensas++; continue; }
    if (lado === '') { sinLado++; continue; }

    var tag = (typeof _blgNormalizarTag_ === 'function') ? _blgNormalizarTag_(f[iTag]) : String(f[iTag] || '').trim().toUpperCase();
    if (!tag) continue;
    var nombreClan = String(f[iClanNombre] || '').trim();
    var tagClan = String(f[iClanTag] || '').trim().toUpperCase();
    var claveClan = tagClan || nombreClan || 'sin-clan';

    var c = clanes[claveClan] || (clanes[claveClan] = { clan: nombreClan || tagClan || 'Sin clan', jugadores: {} });
    if (nombreClan) c.clan = nombreClan;
    var j = c.jugadores[tag] || (c.jugadores[tag] = { tag: tag, nombre: '', ataques: 0, ganados: 0, perdidos: 0, sinResultado: 0 });
    j.nombre = String(f[iNombre] || '').trim() || j.nombre;
    j.ataques++;
    var g = String(f[iGanado] === undefined || f[iGanado] === null ? '' : f[iGanado]).trim().toLowerCase();
    if (g === 'sí' || g === 'si') j.ganados++;
    else if (g === 'no') j.perdidos++;
    else j.sinResultado++;
  }

  // Topes de la semana: uno por evento (torneo, sorteo, cambio de rango) cuya columna Semanas incluye la semana.
  // Respaldo: si ningún evento la incluye, el tope del torneo VIGENTE (Extra!Torneo_Vigente_ID; si no hay, el más
  // reciente de T_Lista). `limite` (compatibilidad) = el tope más estricto entre los usados, o null si no hay ninguno.
  var limites = _noticiasLimitesBarcos_(semana);
  var origenLimite = limites.length ? 'semana' : 'ninguno';
  if (!limites.length) {
    try {
      var bloque = _getConfigMasRecienteCategoria('Torneo');
      if (bloque && bloque.length && bloque[0].barcos && bloque[0].barcos.activo) {
        var q = Number(bloque[0].barcos.qty);
        if (!isNaN(q)) { limites = [{ origen: 'Torneo vigente', id: String(bloque[0].idFila || '').trim(), nombre: '', qty: q }]; origenLimite = 'vigente'; }
      }
    } catch (eLim) {
      Logger.log('[Noticias] No pude leer el tope de barcos: ' + eLim.message);
    }
  }
  var limite = null;
  limites.forEach(function (l) { if (limite === null || l.qty < limite) limite = l.qty; });

  var orden = [];
  try { orden = (_getNombresClanesTernaOrdenados() || []).map(function (n) { return String(n).trim().toLowerCase(); }); } catch (eOrd) { orden = []; }

  var salida = Object.keys(clanes).map(function (k) {
    var c = clanes[k];
    var jugadores = Object.keys(c.jugadores).map(function (t) {
      var j = c.jugadores[t];
      // Se pasó si supera el tope de CUALQUIER evento de la semana; excedeEn dice de cuáles.
      j.excedeEn = limites.filter(function (l) { return j.ataques > l.qty; }).map(function (l) { return l.origen + (l.nombre ? ' ' + l.nombre : '') + (l.id ? ' (' + l.id + ')' : '') + ': ' + l.qty; });
      j.excede = j.excedeEn.length > 0;
      return j;
    }).sort(function (a, b) { return b.ataques - a.ataques || a.nombre.localeCompare(b.nombre); });
    var total = 0; jugadores.forEach(function (j) { total += j.ataques; });
    return { clan: c.clan, totalAtaques: total, jugadores: jugadores };
  }).sort(function (a, b) {
    var ia = orden.indexOf(a.clan.toLowerCase()), ib = orden.indexOf(b.clan.toLowerCase());
    if (ia < 0) ia = 999; if (ib < 0) ib = 999;
    return ia - ib || a.clan.localeCompare(b.clan);
  });

  return { ok: true, clanes: salida, limite: limite, limites: limites, origenLimite: origenLimite, defensas: defensas, sinLado: sinLado, dudosas: dudosas, filasSemana: filasSemana };
}

// -----------------------------------------------------------------------------
// 2) ASCENSOS Y DESCENSOS DE LA SEMANA
// -----------------------------------------------------------------------------

// Cambios de rango de la semana desde Historial_A/D (fecha en hora de Lima); omite los 'Planificado'. [→ Contexto_Base_Web.md §40B008]
function _noticiasAscensos_(semana) {
  var ss = _getSs();
  var lectura = _obtenerFilasConFallbackCSV(ss, CFG.SHEETS.ASCENSOS, 'Backup_Historial_A-D.csv', ASCENSOS_TOTAL_COLS);
  if (lectura.origen === 'vacio') return { ok: true, cambios: [] };

  var filas = lectura.filas;
  var cambios = [];
  for (var i = 0; i < filas.length; i++) {
    var f = filas[i];
    if (String(f[ASC.ESTADO_PROPUESTA - 1] || '').trim() === 'Planificado') continue;

    var fecha = f[ASC.FECHA - 1];
    if (!(fecha instanceof Date)) fecha = _parseSpanishDate(fecha); // el CSV guarda texto
    if (!(fecha instanceof Date) || isNaN(fecha.getTime())) continue;
    var iso = Utilities.formatDate(fecha, NOTICIAS_TZ, 'yyyy-MM-dd');
    if (iso < semana.lunesIso || iso > semana.domingoIso) continue;

    var tipo = String(f[ASC.TIPO - 1] || '');
    cambios.push({
      tag: String(f[ASC.TAG - 1] || '').trim(),
      nombre: String(f[ASC.NOMBRE - 1] || ''),
      clan: String(f[ASC.CLAN - 1] || ''),
      tipo: tipo,
      esAscensoClan: tipo === 'Ascenso de clan',
      rangoAnterior: String(f[ASC.RANGO - 1] || ''),
      rangoNuevo: String(f[ASC.RANGO_2 - 1] || ''),
      fechaTxt: Utilities.formatDate(fecha, NOTICIAS_TZ, 'dd/MM/yyyy'),
      autor: String(f[ASC.AUTOR - 1] || ''),
      _orden: fecha.getTime()
    });
  }

  cambios.sort(function (a, b) { return a._orden - b._orden; });
  var truncado = cambios.length > NOTICIAS_MAX_ASCENSOS;
  cambios = cambios.slice(0, NOTICIAS_MAX_ASCENSOS).map(function (c) { delete c._orden; return c; });
  return { ok: true, cambios: cambios, truncado: truncado };
}

// -----------------------------------------------------------------------------
// 3) POSICIONES FINALES POR CLAN
// -----------------------------------------------------------------------------

// Posición final, trofeos y avance de cada clan Terna en la semana, y variación contra la semana anterior (reusa _webGuerraLog()). [→ Contexto_Base_Web.md §40B009]
function _noticiasPosiciones_(semana) {
  var log = _webGuerraLog(); // sin tag: todos los clanes Terna
  var clanes = [];
  (log.clanes || []).forEach(function (c) {
    var lista = c.semanas || []; // descendente: la anterior está en idx + 1
    var idx = -1;
    for (var i = 0; i < lista.length; i++) {
      if (Number(lista[i].temporada) === Number(semana.temporada) && Number(lista[i].semana) === Number(semana.semana)) { idx = i; break; }
    }
    if (idx < 0) { clanes.push({ clan: c.clan || c.tag, tag: c.tag, sinDatos: true }); return; }

    var s = lista[idx], ant = lista[idx + 1] || null;
    var puesto = Number(s.rank) || 0;
    var puestoAnt = ant ? (Number(ant.rank) || 0) : 0;
    // Tendencia para el gráfico: hasta 6 semanas terminando en la elegida, de la más
    // vieja a la más nueva (la lista viene descendente, por eso se invierte).
    var tendencia = lista.slice(idx, idx + NOTICIAS_SEMANAS_TENDENCIA).reverse().map(function (x) {
      return { temporada: Number(x.temporada), semana: Number(x.semana), puesto: Number(x.rank) || 0, trofeos: Number(x.trophy) || 0 };
    });
    clanes.push({
      tendencia: tendencia,
      clan: c.clan || c.tag,
      tag: c.tag,
      sinDatos: false,
      puesto: puesto,                       // 0 = sin dato
      puestoEstimado: !!s.rankEstimado,
      trofeos: Number(s.trophy) || 0,
      variacionTrofeos: Number(s.trophyDelta) || 0,
      barco: Number(s.boat) || 0,
      coliseo: !!s.coliseo,
      puestoAnterior: puestoAnt,
      variacionPuesto: (puesto > 0 && puestoAnt > 0) ? (puestoAnt - puesto) : null
    });
  });
  return { ok: true, clanes: clanes };
}

// -----------------------------------------------------------------------------
// 4) PARTICIPACIÓN Y FAME DE GUERRA (noticia nueva)
// -----------------------------------------------------------------------------

/** Número desde una celda de la hoja o del respaldo CSV ("31,200" -> 31200). 0 si no es número. */
function _noticiasNum_(v) {
  if (typeof v === 'number') return isNaN(v) ? 0 : v;
  var t = String(v === undefined || v === null ? '' : v).replace(/ /g, ' ').trim();
  if (!t) return 0;
  if (/^-?\d{1,3}([.,' ]\d{3})+$/.test(t)) t = t.replace(/[.,' ]/g, '');
  var n = Number(t);
  return isNaN(n) ? 0 : n;
}

// Por clan Terna: fame total, ataques usados vs posibles, jugadores sin ataque y completos; solo días exigidos (CAMBIO 05-oct-2026); fuente hoja Guerra o Backup_Guerra.csv. [→ Contexto_Base_Web.md §40B010]
function _noticiasGuerra_(semana) {
  var ss = _getSs();
  var lectura = _obtenerFilasConFallbackCSV(ss, CFG.SHEETS.GUERRA, 'Backup_Guerra.csv', GUERRA_TOTAL_COLS);
  if (lectura.origen === 'vacio') return { ok: true, clanes: [], topFame: [], faltaDato: true };

  var baseP = (Number(semana.semana) - 1) * 7 + 3;
  var nombresTerna = [];
  try { nombresTerna = (_getNombresClanesTernaOrdenados() || []).map(function (n) { return String(n).trim().toLowerCase(); }); } catch (eN) { nombresTerna = []; }

  var LETRAS = ['j', 'v', 's', 'd'];
  var jug = {};      // 'clan|tag' -> { tag, nombre, clan, ataques:[4], fame:[4 o null], presente:[4 bool] }
  var clanDias = {}; // clan -> filas vistas por día (0 = el clan no tiene datos ese día)
  for (var i = 0; i < lectura.filas.length; i++) {
    var f = lectura.filas[i];
    if (String(f[GC.TEMPORADA - 1] || '') !== String(semana.temporada)) continue;
    if (Number(f[GC.SEMANA - 1]) !== Number(semana.semana)) continue;
    var off = (Number(f[GC.PERIOD_IDX - 1]) || 0) - baseP;
    if (off < 0 || off > 3) continue; // solo jueves a domingo: el entrenamiento no cuenta

    var clan = String(f[GC.CLAN - 1] || '').trim();
    if (!clan) continue;
    if (nombresTerna.length && nombresTerna.indexOf(clan.toLowerCase()) < 0) continue;
    var tag = String(f[GC.TAG - 1] || '').trim().toUpperCase();
    if (!tag) continue;

    var cdias = clanDias[clan] || (clanDias[clan] = [0, 0, 0, 0]);
    cdias[off]++;
    var k = clan + '|' + tag;
    var j = jug[k] || (jug[k] = { tag: tag, nombre: '', clan: clan, ataques: [0, 0, 0, 0], fame: [null, null, null, null], presente: [false, false, false, false] });
    j.presente[off] = true; // hay fila ese día: el jugador estaba en el clan (sin fila = no estaba, celda vacía)
    j.nombre = String(f[GC.NOMBRE - 1] || '').trim() || j.nombre;
    j.ataques[off] = Math.max(j.ataques[off], _noticiasNum_(f[GC.ATAQUES_HOY - 1]));
    var fm = _noticiasNum_(f[GC.FAME - 1]);
    j.fame[off] = Math.max(j.fame[off] === null ? 0 : j.fame[off], fm);
  }

  // Días OPCIONALES por clan (meta ya cruzada al empezar el día): atacar no se exige. Misma regla que el
  // Control y el perfil (_clanYaCruzoMetaEnPeriodo(), 22_ControlCalendario.gs), pero aquí se evalúan viernes, sábado y domingo
  // (criterio unificado 07-oct-2026; Supercell no confirma desde qué día se puede cruzar la meta): el jueves no puede ser opcional; coliseo tampoco.
  var opcPorClan = {};
  function opcionales(clan) {
    if (opcPorClan[clan]) return opcPorClan[clan];
    var r = [false, false, false, false];
    // Criterio unificado (07-oct-2026): índices 1..3 (viernes, sábado, domingo). Que solo se haya visto cruzar el domingo no es
    // una regla confirmada por Supercell. «Ganar al terminar el sábado» y «meta ya cruzada» son lo mismo.
    for (var d = 1; d < 4; d++) {
      if (!clanDias[clan] || !clanDias[clan][d]) continue;
      try {
        if (typeof _clanYaCruzoMetaEnPeriodo === 'function' &&
            _clanYaCruzoMetaEnPeriodo(clan, baseP + d, String(semana.temporada), false)) r[d] = true;
      } catch (eO) { Logger.log('[Noticias] meta cruzada (' + clan + ', día ' + d + '): ' + eO.message); }
    }
    return (opcPorClan[clan] = r);
  }

  var clanes = {};
  var todos = [];
  Object.keys(jug).forEach(function (k) {
    var j = jug[k];
    var opc = opcionales(j.clan);
    // Fame acumulada: null hasta el primer día con fila; después, si un día no tiene fila, se arrastra la anterior.
    var acum = [], ult = null;
    for (var d = 0; d < 4; d++) { if (j.fame[d] !== null) ult = Math.max(ult === null ? 0 : ult, j.fame[d]); acum.push(ult); }
    // Ataques solo de los días en que estuvo (tope 4 por día). Los días opcionales no se exigen: se separan.
    var exigidos = 0, usadosExig = 0, usadosOpc = 0, usadosTotal = 0;
    for (var d3 = 0; d3 < 4; d3++) {
      if (!j.presente[d3]) continue;
      var a = Math.min(j.ataques[d3], 4);
      usadosTotal += a;
      if (opc[d3]) usadosOpc += a; else { exigidos += 4; usadosExig += a; }
    }
    j.ataquesTotal = Math.min(usadosTotal, NOTICIAS_ATAQUES_MAX_SEMANA);
    j.fameTotal = acum[3] === null ? 0 : acum[3];
    j.fameDias = acum;
    var c = clanes[j.clan] || (clanes[j.clan] = {
      clan: j.clan, jugadores: 0, ataques: 0, ataquesPosibles: 0, ataquesEnOpcionales: 0, fame: 0,
      fameSuma: [0, 0, 0, 0], sinAtaques: [], completos: 0
    });
    c.jugadores++;
    c.ataques += usadosExig;           // solo ataques de días exigidos (coherente con ataquesPosibles)
    c.ataquesPosibles += exigidos;     // 4 por cada día en que estuvo y no era opcional
    c.ataquesEnOpcionales += usadosOpc;
    c.fame += j.fameTotal;
    for (var d2 = 0; d2 < 4; d2++) c.fameSuma[d2] += (acum[d2] === null ? 0 : acum[d2]);
    if (exigidos > 0 && usadosExig === 0) c.sinAtaques.push({ tag: j.tag, nombre: j.nombre || j.tag });
    if (exigidos > 0 && usadosExig >= exigidos) c.completos++;
    todos.push(j);
  });

  var salida = Object.keys(clanes).map(function (nombre) {
    var c = clanes[nombre];
    // Día sin ninguna fila del clan -> null (no 0): la pantalla lo deja en blanco.
    c.fameDias = c.fameSuma.map(function (v, d) { return (clanDias[nombre] && clanDias[nombre][d]) ? v : null; });
    delete c.fameSuma;
    var opc = opcionales(nombre);
    c.diasOpcionales = LETRAS.filter(function (l, d) { return opc[d]; });
    c.diasConDato = LETRAS.filter(function (l, d) { return clanDias[nombre] && clanDias[nombre][d] > 0; });
    c.participacion = c.ataquesPosibles ? Math.round(c.ataques * 1000 / c.ataquesPosibles) / 10 : 0; // %, 1 decimal
    c.sinAtaquesTotal = c.sinAtaques.length;
    c.sinAtaques = c.sinAtaques.slice(0, NOTICIAS_MAX_NOMBRES_LISTA);
    return c;
  });
  var orden = nombresTerna;
  salida.sort(function (a, b) {
    var ia = orden.indexOf(a.clan.toLowerCase()), ib = orden.indexOf(b.clan.toLowerCase());
    if (ia < 0) ia = 999; if (ib < 0) ib = 999;
    return ia - ib || a.clan.localeCompare(b.clan);
  });

  todos.sort(function (a, b) { return b.fameTotal - a.fameTotal; });
  var topFame = todos.slice(0, NOTICIAS_TOP_FAME).filter(function (j) { return j.fameTotal > 0; }).map(function (j) {
    return { tag: j.tag, nombre: j.nombre || j.tag, clan: j.clan, fame: j.fameTotal, ataques: j.ataquesTotal };
  });

  return { ok: true, clanes: salida, topFame: topFame, ataquesMaxJugador: NOTICIAS_ATAQUES_MAX_SEMANA };
}

// -----------------------------------------------------------------------------
// 5) INGRESOS Y SALIDAS (noticia nueva)
// -----------------------------------------------------------------------------

// Ingresos, reingresos, salidas y expulsiones de la semana desde Historial_I/S, contados por clan y con lista. [→ Contexto_Base_Web.md §40B011]
function _noticiasMovimientos_(semana) {
  var ss = _getSs();
  var lectura = _obtenerFilasConFallbackCSV(ss, CFG.SHEETS.HISTORIAL, 'Backup_Historial_I-S.csv', 7);
  if (lectura.origen === 'vacio') return { ok: true, clanes: [], lista: [] };

  var clanes = {}, lista = [];
  for (var i = 0; i < lectura.filas.length; i++) {
    var f = lectura.filas[i];
    var fecha = f[1];
    if (!(fecha instanceof Date)) fecha = _parseSpanishDate(fecha); // el CSV guarda texto
    if (!(fecha instanceof Date) || isNaN(fecha.getTime())) continue;
    var iso = Utilities.formatDate(fecha, NOTICIAS_TZ, 'yyyy-MM-dd');
    if (iso < semana.lunesIso || iso > semana.domingoIso) continue;

    var mov = String(f[4] || '').trim();
    if (['Ingreso', 'Reingreso', 'Salida', 'Expulsión'].indexOf(mov) < 0) continue;
    var clan = String(f[5] || '').trim() || 'Sin clan';
    var c = clanes[clan] || (clanes[clan] = { clan: clan, ingresos: 0, reingresos: 0, salidas: 0, expulsiones: 0 });
    if (mov === 'Ingreso') c.ingresos++;
    else if (mov === 'Reingreso') c.reingresos++;
    else if (mov === 'Salida') c.salidas++;
    else c.expulsiones++;
    lista.push({
      tag: String(f[2] || '').trim(), nombre: String(f[3] || ''), movimiento: mov, clan: clan,
      fechaTxt: Utilities.formatDate(fecha, NOTICIAS_TZ, 'dd/MM/yyyy'), _orden: fecha.getTime()
    });
  }

  var orden = [];
  try { orden = (_getNombresClanesTernaOrdenados() || []).map(function (n) { return String(n).trim().toLowerCase(); }); } catch (eO) { orden = []; }
  var salida = Object.keys(clanes).map(function (k) {
    var c = clanes[k];
    c.neto = (c.ingresos + c.reingresos) - (c.salidas + c.expulsiones);
    return c;
  }).sort(function (a, b) {
    var ia = orden.indexOf(a.clan.toLowerCase()), ib = orden.indexOf(b.clan.toLowerCase());
    if (ia < 0) ia = 999; if (ib < 0) ib = 999;
    return ia - ib || a.clan.localeCompare(b.clan);
  });

  lista.sort(function (a, b) { return a._orden - b._orden; });
  var total = lista.length;
  lista = lista.slice(0, NOTICIAS_MAX_NOMBRES_LISTA).map(function (m) { delete m._orden; return m; });
  return { ok: true, clanes: salida, lista: lista, total: total };
}

// --- ARCHIVO: 41_Web_ActualizarRoster.gs ---
// ==============================================================================
// 41_Web_ActualizarRoster.gs
// Actualización manual pedida desde la web por un admin (creado 05-oct-2026). Hasta el 22-oct-2026 corría runPendientesYMensajes(); desde esa fecha corre la CADENA CORTA (Clanes, Directorio, Nuevos y Guerra) y, si otra ejecución tiene el candado, espera su turno en vez de rechazar. [→ Contexto_Base_Web.md §PF166]
// ==============================================================================
//
// Permiso 'Actualizar roster', acciones POST/GET, estados, reglas para proteger la API y la captura de guerra, y AVISOS 1-5 (sin probar en Apps Script real; AVISO 5 PENDIENTE DE DEFINIR: invalidar la cache de webAdminContenido). [→ Contexto_Base_Web.md §41B002]
//
// FLUJO (PF166): la web pide -> estado 'pendiente' + disparador de un solo uso (WEB_ACTROSTER_HANDLER) -> ese handler intenta tomar el
// candado global de ejecución. Si no puede (runGuerra u otra tarea lo tiene), el estado sigue 'pendiente' con el mensaje «Esperando turno»
// y el handler se reprograma cada WEB_ACTROSTER_TURNO_REINTENTO_MS hasta WEB_ACTROSTER_TURNO_MAX_MS. Si lo toma, pasa a 'ejecutando' y
// corre los pasos de _webActRosterPasos_() con _ejecutarPorTandas() (continuaciones en WEB_ACTROSTER_HANDLER_CONTINUAR).
// ==============================================================================

// ORDEN DE ESTE ARCHIVO (regla 0.9 de la skill; 28-oct-2026): primero las constantes y variables globales; luego, por partes:
//  Parte 1 — Funciones que se corren a mano: ninguna (la actualización la pide un admin desde la web y la corre un disparador de un solo uso)
//  Parte 2 — Funciones que no se corren a mano
//    - Acciones web: iniciar la actualización y consultar su estado
//    - Ejecución por disparador: arranque con reintentos de turno, tandas de la cadena (_webActualizarRosterContinuar justo después de su principal) y recalentado de la web
//    - Pasos de la cadena: tipo de actualización, lista de pasos y sus nombres
//    - Permiso y estado de la solicitud
//    - Bloqueo, candado y textos para el admin
//    - Cierre de la solicitud: cachés, estado final y limpieza de la cadena
// Dentro de cada tema, en el orden en que se espera ejecutarlas. Al reordenar no se cambió el código de ninguna función.

var WEB_ACTROSTER_PROP_ESTADO = 'WEB_ACTROSTER_ESTADO';
var WEB_ACTROSTER_HANDLER = '_webActualizarRosterEjecutar';             // arranque y reintentos de turno
var WEB_ACTROSTER_HANDLER_CONTINUAR = '_webActualizarRosterContinuar';  // tandas de la cadena (las programa _ejecutarPorTandas)
var WEB_ACTROSTER_ID_TANDAS = 'ACTROSTER';                              // prefijo de ACTROSTER_PASO/ACTROSTER_REINTENTO y nombre con el que se toma el candado global
var WEB_ACTROSTER_ESPERA_MS = 3 * 60 * 1000;               // tiempo de espera entre el fin de una actualización y el inicio de la siguiente
var WEB_ACTROSTER_TURNO_MAX_MS = 10 * 60 * 1000;           // cuánto espera un turno (candado ocupado) antes de rendirse
var WEB_ACTROSTER_TURNO_REINTENTO_MS = 30 * 1000;          // cada cuánto reintenta tomar el candado mientras espera
var WEB_ACTROSTER_PENDIENTE_MAX_MS = 12 * 60 * 1000;       // un 'pendiente' más viejo que esto se da por fallido (mayor que TURNO_MAX)
var WEB_ACTROSTER_EJECUTANDO_MAX_MS = 15 * 60 * 1000;      // un 'ejecutando' más viejo que esto se da por fallido (la cadena puede usar varias tandas)
var WEB_ACTROSTER_ARRANQUE_MS = 5 * 1000;                  // retraso del disparador de un solo uso
var WEB_ACTROSTER_CACHES_A_BORRAR = ['web_ingresos_recientes_v1', 'web_roster_v1']; // §PF180: lo que lee Ingresos recientes de directorio.html (cacheado 60 s); se borra al terminar para que la recarga del botón «Actualizar» no reciba datos de hasta 60 s antes

// §PF181: la misma cola de turno sirve para regenerar solo Pendientes y Mensajes de guerra (boton «Regenerar ahora» de guerra.html): tipo 'mensajes' = los mismos pasos que runPendientesYMensajes() manual (clanes frescos de la API, Pendientes, Mensajes, indice).
var WEB_ACTROSTER_NOMBRES_PASOS_MENSAJES = [
  'Clanes: pedir a la API datos frescos → datos de clanes cargados',
  'Hoja Pendientes: actualizar → hoja Pendientes al día',
  'Hoja Mensajes: generar a partir de Pendientes → hoja Mensajes al día',
  'Índice de contenido: actualizar tras Pendientes → índice al día'
];

var WEB_ACTROSTER_NOMBRES_PASOS = [
  'Clanes: pedir a la API los datos básicos de los clanes, sin /players → datos de clanes cargados',
  'Hoja Directorio: actualizar → hoja Directorio al día',
  'Nuevos (formato y purgado): aplicar → hoja Nuevos con su formato y purgada',
  'Nuevos (columnas fijas): refrescar → columnas fijas de Nuevos al día',
  'Nuevos (orden y formato condicional): aplicar → hoja Nuevos ordenada y con su formato condicional',
  'Hoja Guerra: actualizar → hoja Guerra al día (puede necesitar varias tandas)'
];

// =============================================================================
// PARTE 2 — FUNCIONES QUE NO SE CORREN A MANO
// =============================================================================

// ---------------------------------------------------------------------------
// Acciones web
// ---------------------------------------------------------------------------

// Inicia de forma asíncrona la actualización manual (valida sesión, permiso y que se pueda iniciar). Si otra ejecución tiene el candado, la solicitud queda en cola. [→ Contexto_Base_Web.md §41B003]
function _webAdminActualizarRoster(token, tipo) {
  var acceso = _webActRosterExigirFuncion_(token);
  if (!acceso.ok) return acceso;
  var admin = acceso.admin;

  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    return { ok: false, error: 'El sistema está ocupado en este momento. Intenta de nuevo en unos segundos.' };
  }
  try {
    var ahora = Date.now();
    var est = _webActRosterEstadoVigente_(ahora);
    var bloqueo = _webActRosterBloqueo_(est, ahora);
    if (bloqueo.bloqueado) {
      return { ok: false, error: bloqueo.motivo, bloqueo: { motivo: bloqueo.motivo, esperaSeg: bloqueo.esperaSeg } };
    }

    // PF166: si otra tarea tiene el candado, la solicitud se acepta igual y espera su turno.
    var otra = _webActRosterEjecucionEnCurso_(ahora);
    var tipoSol = _webActRosterTipo_(tipo); // §PF181
    var nombreAccion = tipoSol === 'mensajes' ? 'la regeneración de Pendientes y Mensajes' : 'la actualización';
    var nuevo = {
      id: Utilities.formatDate(new Date(ahora), 'UTC', 'yyyyMMddHHmmss') + '-' + Math.floor(Math.random() * 1000),
      estado: 'pendiente',
      tipo: tipoSol,
      solicitadoPor: String(admin.nomMulti || admin.nombre || 'Admin'),
      solicitadoTs: ahora,
      inicioTs: 0,
      finTs: 0,
      intentosTurno: 0,
      mensaje: otra
        ? 'Solicitada. El sistema está ejecutando ' + _webActRosterNombreTarea_(otra) + '; ' + nombreAccion + ' empezará sola cuando termine.'
        : 'Solicitada. Empieza en unos segundos.'
    };
    _webActRosterGuardarEstado_(nuevo);

    try {
      _borrarTriggersDeContinuacion(WEB_ACTROSTER_HANDLER);
      ScriptApp.newTrigger(WEB_ACTROSTER_HANDLER).timeBased().after(WEB_ACTROSTER_ARRANQUE_MS).create();
    } catch (eTrig) {
      Logger.log('[ActRoster] No se pudo programar el disparador: ' + eTrig);
      nuevo.estado = 'error';
      nuevo.finTs = Date.now();
      nuevo.mensaje = 'No se pudo programar la actualización. Intenta de nuevo; si se repite, avisa al administrador.';
      _webActRosterGuardarEstado_(nuevo);
      return { ok: false, error: nuevo.mensaje };
    }

    Logger.log('[ActRoster] Solicitud ' + nuevo.id + ' (' + tipoSol + ') registrada por ' + nuevo.solicitadoPor + (otra ? ' (candado ocupado por ' + otra + ': queda en cola)' : '') + '.');
    return {
      ok: true,
      estado: 'pendiente',
      tipo: tipoSol,
      id: nuevo.id,
      solicitadoLima: _webActRosterFechaLima_(nuevo.solicitadoTs),
      enCola: !!otra,
      mensaje: nuevo.mensaje
    };
  } finally {
    lock.releaseLock();
  }
}

// Estado de la última actualización pedida desde la web y si se puede iniciar otra ahora. [→ Contexto_Base_Web.md §41B004]
function _webAdminEstadoActualizacion(token) {
  var acceso = _webActRosterExigirFuncion_(token);
  if (!acceso.ok) return acceso;

  var ahora = Date.now();
  var est = _webActRosterEstadoVigente_(ahora);
  var bloqueo = _webActRosterBloqueo_(est, ahora);
  var otra = _webActRosterEjecucionEnCurso_(ahora);

  var salida = {
    ok: true,
    estado: est ? est.estado : 'ninguna',
    tipo: est ? _webActRosterTipo_(est.tipo) : null, // §PF181: 'roster' o 'mensajes'
    id: est ? est.id : null,
    solicitadoPor: est ? est.solicitadoPor : null,
    solicitadoLima: est && est.solicitadoTs ? _webActRosterFechaLima_(est.solicitadoTs) : null,
    inicioLima: est && est.inicioTs ? _webActRosterFechaLima_(est.inicioTs) : null,
    finLima: est && est.finTs ? _webActRosterFechaLima_(est.finTs) : null,
    duracionSeg: est && est.inicioTs && est.finTs ? Math.round((est.finTs - est.inicioTs) / 1000) : null,
    mensaje: est ? est.mensaje : 'Todavía no se ha pedido ninguna actualización manual.',
    puedeIniciar: !bloqueo.bloqueado,
    motivoBloqueo: bloqueo.bloqueado ? bloqueo.motivo : null,
    esperaSeg: bloqueo.esperaSeg || 0,
    webRecalentada: est && typeof est.webRecalentada === 'boolean' ? est.webRecalentada : null,
    // PF166: tarea ajena que tiene el candado ahora (la solicitud esperaría su turno) y avance de la cadena propia.
    ocupadoPor: otra && otra !== WEB_ACTROSTER_ID_TANDAS ? _webActRosterNombreTarea_(otra) : null,
    paso: null,
    pasosTotal: _webActRosterNombresPasos_(est && est.tipo).length,
    pasoNombre: null,
    tiempos: null
  };
  if (est && est.estado === 'ejecutando') {
    var pasoHecho = parseInt(PropertiesService.getScriptProperties().getProperty(WEB_ACTROSTER_ID_TANDAS + '_PASO') || '0', 10) || 0;
    salida.paso = Math.min(pasoHecho + 1, salida.pasosTotal);
    salida.pasoNombre = _webActRosterNombresPasos_(est.tipo)[Math.min(pasoHecho, salida.pasosTotal - 1)] || null;
  }
  // NUEVO (05-oct-2026): horas de actualizacion para mostrarlas junto al boton. Un fallo aqui no debe romper el estado.
  try { salida.tiempos = _tiemposActualizacionWeb_(); }
  catch (eTiempos) { Logger.log('[ActRoster] No se pudieron armar las horas de actualizacion: ' + eTiempos.message); }
  return salida;
}

// ---------------------------------------------------------------------------
// Ejecucion (la dispara el activador de un solo uso)
// ---------------------------------------------------------------------------

// Handler del disparador de un solo uso (arranque y reintentos de turno): toma el candado global o, si está ocupado, se reprograma; al tomarlo lanza la cadena. [→ Contexto_Base_Web.md §41B005, PF166]
function _webActualizarRosterEjecutar() {
  _borrarTriggersDeContinuacion(WEB_ACTROSTER_HANDLER);

  var est = _webActRosterLeerEstado_();
  if (!est || est.estado !== 'pendiente') {
    Logger.log('[ActRoster] El disparador arrancó pero no hay solicitud pendiente (estado: ' + (est ? est.estado : 'ninguno') + '). No se hace nada.');
    return;
  }

  var ahora = Date.now();
  if (CFG.VENTANA_GUERRA_BLOQUEAR_OTROS && _estadoVentanaGuerra_(new Date(ahora)).protegida) {
    _webActRosterCerrar_(est, 'omitido', _webActRosterTextoVentana_() + ' Intenta de nuevo más tarde.');
    return;
  }

  if (!_adquirirLockEjecucion(WEB_ACTROSTER_ID_TANDAS)) {
    var esperadoMs = ahora - est.solicitadoTs;
    var otra = _webActRosterEjecucionEnCurso_(ahora);
    if (esperadoMs < WEB_ACTROSTER_TURNO_MAX_MS) {
      est.intentosTurno = (est.intentosTurno || 0) + 1;
      est.mensaje = 'Esperando turno: el sistema está ejecutando ' + _webActRosterNombreTarea_(otra || 'otra tarea') + '. Empieza sola cuando termine.';
      _webActRosterGuardarEstado_(est);
      try {
        ScriptApp.newTrigger(WEB_ACTROSTER_HANDLER).timeBased().after(WEB_ACTROSTER_TURNO_REINTENTO_MS).create();
      } catch (eTrig) {
        Logger.log('[ActRoster] No se pudo reprogramar el reintento de turno: ' + eTrig);
        _webActRosterCerrar_(est, 'error', 'No se pudo seguir esperando el turno. Intenta de nuevo; si se repite, avisa al administrador.');
        return;
      }
      Logger.log('[ActRoster] Candado ocupado por ' + (otra || '?') + ': reintento ' + est.intentosTurno + ' en ' + Math.round(WEB_ACTROSTER_TURNO_REINTENTO_MS / 1000) + ' s.');
      return;
    }
    _webActRosterCerrar_(est, 'omitido', 'No hubo turno en ' + Math.round(WEB_ACTROSTER_TURNO_MAX_MS / 60000) + ' minutos: el sistema siguió ocupado con ' +
      _webActRosterNombreTarea_(otra || 'otra tarea') + '. Intenta de nuevo más tarde.');
    return;
  }

  est.estado = 'ejecutando';
  est.inicioTs = Date.now();
  est.mensaje = _webActRosterTipo_(est.tipo) === 'mensajes'
    ? 'Regenerando Pendientes y Mensajes de guerra...'
    : 'Actualizando clanes, Directorio, Nuevos y Guerra...';
  _webActRosterGuardarEstado_(est);
  Logger.log('[ActRoster] INICIO de la solicitud ' + est.id + ' (' + _webActRosterTipo_(est.tipo) + ', pedida por ' + est.solicitadoPor + ', esperó ' + Math.round((est.inicioTs - est.solicitadoTs) / 1000) + ' s).');

  var props = PropertiesService.getScriptProperties();
  props.setProperty(WEB_ACTROSTER_ID_TANDAS + '_PASO', '0');
  props.deleteProperty(WEB_ACTROSTER_ID_TANDAS + '_REINTENTO');
  _webActualizarRosterContinuar();
}

// Una tanda de la cadena: la llama el handler de arranque y los disparadores de continuación que programa _ejecutarPorTandas(). Cierra el estado al terminar, abortar o fallar. [→ Contexto_Base_Web.md §PF166]
function _webActualizarRosterContinuar() {
  var t0 = Date.now();
  var props = PropertiesService.getScriptProperties();

  var est = _webActRosterLeerEstado_();
  if (!est || est.estado !== 'ejecutando') {
    Logger.log('[ActRoster] Continuación sin solicitud en ejecución (estado: ' + (est ? est.estado : 'ninguno') + '). Se descarta; no se toca el candado.');
    _borrarTriggersDeContinuacion(WEB_ACTROSTER_HANDLER_CONTINUAR);
    return;
  }

  // Si la cadena perdió el candado (venció y otra tarea lo tomó), no se sigue escribiendo hojas encima de esa tarea.
  var infoLock = _webActRosterInfoCandado_();
  if (!infoLock || infoLock.fn !== WEB_ACTROSTER_ID_TANDAS) {
    Logger.log('[ActRoster] El candado ya no es de esta cadena (' + (infoLock ? infoLock.fn : 'libre') + '). Se corta sin liberarlo.');
    _webActRosterLimpiarCadena_(false);
    _webActRosterCerrar_(est, 'omitido', 'La actualización perdió su turno porque otra tarea tomó el sistema. Intenta de nuevo.');
    return;
  }

  var tipo = _webActRosterTipo_(est.tipo); // §PF181
  var nombresPasos = _webActRosterNombresPasos_(tipo);
  if (tipo === 'roster') SUPRIMIR_PLAYERS_TEMPORAL = true; // variable global en memoria: se pone en cada tanda (ver runGuerraRapido); Pendientes/Mensajes no usan /players
  var completo;
  try {
    completo = _ejecutarPorTandas(WEB_ACTROSTER_ID_TANDAS, _webActRosterPasos_(tipo), CFG.RUNGUERRARAPIDO_PRESUPUESTO_MS,
      WEB_ACTROSTER_HANDLER_CONTINUAR, nombresPasos);
  } catch (e) {
    SUPRIMIR_PLAYERS_TEMPORAL = false;
    Logger.log('[ActRoster] ERROR en la solicitud ' + est.id + ': ' + e + (e && e.stack ? ' | ' + e.stack : ''));
    _webActRosterLimpiarCadena_(true);
    _webActRosterCerrar_(est, 'error', (tipo === 'mensajes' ? 'La regeneración falló' : 'La actualización falló') + '. Intenta de nuevo; si se repite, avisa al administrador.');
    return;
  }

  if (completo && tipo === 'mensajes') {
    // §PF181: si Pendientes abortó (faltó /currentriverrace de algún clan Terna en día de guerra) NO se generaron mensajes nuevos: se conserva lo anterior y se avisa.
    var abortoTs = Number(props.getProperty('PENDIENTES_ABORT_TS')) || 0;
    _webActRosterInvalidarCachesWeb_(tipo);
    _liberarLockEjecucion();
    if (abortoTs >= est.inicioTs) {
      _webActRosterCerrar_(est, 'ok_parcial', 'No se pudieron regenerar: faltaron datos de guerra de la API. Se conservan los mensajes anteriores; intenta de nuevo en unos minutos.');
    } else {
      _webActRosterCerrar_(est, 'ok', 'Pendientes y Mensajes de guerra regenerados.');
    }
    return;
  }

  if (completo) {
    SUPRIMIR_PLAYERS_TEMPORAL = false;
    // Recalentar la cache de la web ANTES de cerrar el estado (sigue en 'ejecutando'), para que cuando el frontend vea 'ok' ya encuentre los datos nuevos (AVISO 4).
    est.mensaje = 'Datos actualizados. Actualizando la web...';
    _webActRosterGuardarEstado_(est);
    _webActRosterInvalidarCachesWeb_(tipo);
    est.webRecalentada = _webActRosterRecalentarWeb_(t0);
    _liberarLockEjecucion();
    _webActRosterCerrar_(est, 'ok', 'Clanes, Directorio, Nuevos y Guerra actualizados.' +
      (est.webRecalentada ? '' : ' La web puede tardar unos minutos en mostrar los datos nuevos.'));
    return;
  }

  // No completo: o quedó una continuación programada (la propiedad de paso sigue) o _ejecutarPorTandas() abortó y la borró (ventana protegida).
  var pasoRestante = props.getProperty(WEB_ACTROSTER_ID_TANDAS + '_PASO');
  if (pasoRestante === null) {
    SUPRIMIR_PLAYERS_TEMPORAL = false;
    _webActRosterCerrar_(est, 'omitido', _webActRosterTextoVentana_() + ' Intenta de nuevo más tarde.');
    return;
  }
  est.mensaje = (tipo === 'mensajes' ? 'Regenerando... (' : 'Actualizando... (') + (parseInt(pasoRestante, 10) || 0) + ' de ' + nombresPasos.length + ' pasos hechos)';
  _webActRosterGuardarEstado_(est);
  Logger.log('[ActRoster] Tanda terminada con la cadena a medias (paso ' + pasoRestante + '/' + nombresPasos.length + '); sigue en la continuación.');
}

// Recalienta la cache de guerra.html con los datos recién escritos si queda margen de tiempo EN ESTA EJECUCIÓN; nunca lanza error; true si se guardó. inicioEjecucionTs = inicio de la tanda actual (PF166: antes era el inicio de toda la solicitud). [→ Contexto_Base_Web.md §41B006, PF166]
function _webActRosterRecalentarWeb_(inicioEjecucionTs) {
  try {
    if (typeof _calentarCacheGuerraEnVivo_ !== 'function') {
      Logger.log('[ActRoster] _calentarCacheGuerraEnVivo_ no está disponible: no se recalienta la web.');
      return false;
    }
    var restanteMs = CFG.PLATAFORMA_LIMITE_EJECUCION_MS - (Date.now() - inicioEjecucionTs);
    if (restanteMs < CFG.RUNGUERRA_SYNC_CSV_MARGEN_MIN_MS) {
      Logger.log('[ActRoster] Recalentado de la web SALTADO: quedan solo ' + Math.round(restanteMs / 1000) + ' s en esta ejecución.');
      return false;
    }
    var ttl = _estadoVentanaGuerra_(new Date()).enVentana
      ? WEB_GUERRA_VIVO_TTL_CALENTADO_VENTANA_SEG
      : WEB_GUERRA_VIVO_TTL_CALENTADO_FUERA_SEG;
    return _calentarCacheGuerraEnVivo_(ttl) === true;
  } catch (e) {
    Logger.log('[ActRoster] No se pudo recalentar la cache de la web: ' + e.message);
    return false;
  }
}

// ---------------------------------------------------------------------------
// Pasos de la cadena
// ---------------------------------------------------------------------------

// §PF181: 'mensajes' solo si se pidió exactamente así; cualquier otro valor (o ninguno) es la cadena corta de roster de siempre.
function _webActRosterTipo_(valor) {
  return String(valor || '').trim() === 'mensajes' ? 'mensajes' : 'roster';
}

// Pasos de la cadena corta (PF166): los mismos 6 primeros de runGuerraRapido (Clanes, Directorio, Nuevos x3, Guerra) y NADA más: sin Control, Control_2, Pendientes, Mensajes ni Índice. Se arma al llamarla (no al cargar el archivo) para no depender del orden de carga de los .gs. [→ Contexto_Base_Web.md §PF166]
function _webActRosterPasos_(tipo) {
  if (_webActRosterTipo_(tipo) === 'mensajes') return _webActRosterPasosMensajes_();
  return [
    function () {
      SUPRIMIR_PLAYERS_TEMPORAL = true; // el Directorio de esta cadena no pide /players (igual que runGuerraRapido)
      forzarRosterFrescoAhora();
      capturarApiClanes_(CFG.CLANES_PROGRESO_MAX_EDAD_MS, 'actualizarRosterWeb paso 0');
    },
    function () { updateDirectorioSheet(); },
    function () {
      try { _refrescarColumnasFijasNuevos_Paso1_FormatoYPurgado(); }
      catch (eNuevos1) { Logger.log('[ActRoster] _refrescarColumnasFijasNuevos_Paso1_FormatoYPurgado() falló: ' + eNuevos1.message); }
    },
    function () {
      try { _refrescarColumnasFijasNuevos_Paso2_ColumnasFijas(); }
      catch (eNuevos2) { Logger.log('[ActRoster] _refrescarColumnasFijasNuevos_Paso2_ColumnasFijas() falló: ' + eNuevos2.message); }
    },
    function () {
      try { _refrescarColumnasFijasNuevos_Paso3_OrdenYFormato(); }
      catch (eNuevos3) { Logger.log('[ActRoster] _refrescarColumnasFijasNuevos_Paso3_OrdenYFormato() falló: ' + eNuevos3.message); }
    },
    function () { return updateGuerraSheet(); } // false = incompleta: _ejecutarPorTandas() reintenta el mismo paso en la continuación
  ];
}

// §PF181: pasos de la regeneracion de Pendientes y Mensajes (mismos cuerpos que runPendientesYMensajes() manual y _pendientesYMensajesNucleo_(false)); NO toca Directorio, Nuevos ni Guerra.
function _webActRosterPasosMensajes_() {
  return [
    function () {
      forzarRosterFrescoAhora();
      capturarApiClanes_(CFG.CLANES_PROGRESO_MAX_EDAD_MS, 'regenerarMensajesWeb paso 0');
    },
    function () { updatePendientesSheet(); },
    function () { runGenerarMensajes(); },
    function () { _actualizarIndiceTrasPendientes_(); }
  ];
}

function _webActRosterNombresPasos_(tipo) {
  return _webActRosterTipo_(tipo) === 'mensajes' ? WEB_ACTROSTER_NOMBRES_PASOS_MENSAJES : WEB_ACTROSTER_NOMBRES_PASOS;
}

// ---------------------------------------------------------------------------
// Permiso y estado de la solicitud
// ---------------------------------------------------------------------------

/** Sesion valida + Funcion 'Actualizar roster' (releida de la hoja). Devuelve { ok:true, admin } o { ok:false, error }. */
function _webActRosterExigirFuncion_(token) {
  var msgSesion = 'Sesión inválida o vencida. Vuelve a iniciar sesión.';
  if (!_webAuthValidar(token)) return { ok: false, error: msgSesion };
  var admin = _webAuthObtenerAdmin(token);
  if (!admin) return { ok: false, error: msgSesion };
  var fresco = _webBuscarAdminPorCelular(admin.celular);
  if (!fresco || !_webAdminTieneFuncion(fresco.funciones, WEB_FUNCION_ACTUALIZAR_ROSTER)) {
    return { ok: false, error: 'No tienes permiso para actualizar el roster.' };
  }
  return { ok: true, admin: admin };
}

// Lee el estado y pasa a 'error' el que quedó trabado ('pendiente' más allá de la espera de turno o 'ejecutando' más allá del máximo de la cadena). [→ Contexto_Base_Web.md §41B007, PF166]
function _webActRosterEstadoVigente_(ahora) {
  var est = _webActRosterLeerEstado_();
  if (!est) return null;
  var cambio = false;
  var liberar = false;
  if (est.estado === 'pendiente' && (ahora - est.solicitadoTs) > WEB_ACTROSTER_PENDIENTE_MAX_MS) {
    est.estado = 'error';
    est.finTs = ahora;
    est.mensaje = 'La actualización no llegó a empezar. Intenta de nuevo; si se repite, avisa al administrador.';
    cambio = true;
  } else if (est.estado === 'ejecutando' && (ahora - est.inicioTs) > WEB_ACTROSTER_EJECUTANDO_MAX_MS) {
    est.estado = 'error';
    est.finTs = ahora;
    est.mensaje = 'La actualización se cortó por tiempo. Revisa los datos e intenta de nuevo.';
    cambio = true;
    liberar = true;
  }
  if (cambio) {
    _webActRosterGuardarEstado_(est);
    _webActRosterLimpiarCadena_(liberar);
  }
  return est;
}

function _webActRosterLeerEstado_() {
  try {
    var raw = PropertiesService.getScriptProperties().getProperty(WEB_ACTROSTER_PROP_ESTADO);
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    Logger.log('[ActRoster] Estado guardado ilegible, se ignora: ' + e.message);
    return null;
  }
}

function _webActRosterGuardarEstado_(est) {
  PropertiesService.getScriptProperties().setProperty(WEB_ACTROSTER_PROP_ESTADO, JSON.stringify(est));
}

// ---------------------------------------------------------------------------
// Bloqueo, candado y textos para el admin
// ---------------------------------------------------------------------------

// Decide si se puede iniciar ahora: devuelve {bloqueado, motivo, esperaSeg}; orden: ventana protegida, otra solicitud propia, tiempo de espera. PF166: que OTRA tarea tenga el candado YA NO bloquea (la solicitud espera su turno). [→ Contexto_Base_Web.md §41B008, PF166]
function _webActRosterBloqueo_(est, ahora) {
  if (CFG.VENTANA_GUERRA_BLOQUEAR_OTROS && _estadoVentanaGuerra_(new Date(ahora)).protegida) {
    return { bloqueado: true, motivo: _webActRosterTextoVentana_(), esperaSeg: 0 };
  }
  if (est && (est.estado === 'pendiente' || est.estado === 'ejecutando')) {
    return { bloqueado: true, esperaSeg: 0,
      motivo: 'Ya hay una actualización en curso, pedida por ' + (est.solicitadoPor || 'otro admin') + '. Espera a que termine.' };
  }
  if (est && est.solicitadoTs && est.estado !== 'omitido') {
    // PF166: la espera se cuenta desde que terminó (la cadena puede durar más que la espera misma), o desde que se pidió si no hay fin.
    var desde = est.finTs || est.solicitadoTs;
    var faltaMs = WEB_ACTROSTER_ESPERA_MS - (ahora - desde);
    if (faltaMs > 0) {
      var seg = Math.ceil(faltaMs / 1000);
      return { bloqueado: true, esperaSeg: seg,
        motivo: 'Se actualizó hace poco. Podrás volver a actualizar en ' + seg + ' s.' };
    }
  }
  return { bloqueado: false, motivo: '', esperaSeg: 0 };
}

/** Texto para cuando la cadena no empezó o se cortó por la ventana protegida. */
function _webActRosterTextoVentana_() {
  var fmt = function (minUtc) {
    var m = (((minUtc - 300) % 1440) + 1440) % 1440; // Lima = UTC-5
    var h = Math.floor(m / 60), mm = m % 60;
    var h12 = h % 12 === 0 ? 12 : h % 12;
    return h12 + ':' + (mm < 10 ? '0' + mm : mm) + (h < 12 ? ' a.m.' : ' p.m.');
  };
  var ini = CFG.VENTANA_GUERRA_INI_UTC_MIN - (CFG.VENTANA_GUERRA_PRE_MARGEN_MIN || 0);
  return 'No disponible entre las ' + fmt(ini) + ' y las ' + fmt(CFG.VENTANA_GUERRA_FIN_UTC_MIN) +
    ' (hora Lima): en ese rato el sistema solo captura la guerra.';
}

/** Datos del candado global vigente ({fn, inicio}) o null si no hay ninguno o ya venció. */
function _webActRosterInfoCandado_() {
  try {
    var raw = PropertiesService.getScriptProperties().getProperty('EJECUCION_EN_CURSO');
    if (!raw) return null;
    var info = JSON.parse(raw);
    if ((Date.now() - info.inicio) < CFG.LOCK_MAX_DURACION_MS) return info;
  } catch (e) { /* propiedad corrupta: se ignora */ }
  return null;
}

/** Nombre de la ejecucion pesada que tiene el candado global vigente, o '' si no hay ninguna. */
function _webActRosterEjecucionEnCurso_(ahora) {
  try {
    var raw = PropertiesService.getScriptProperties().getProperty('EJECUCION_EN_CURSO');
    if (!raw) return '';
    var info = JSON.parse(raw);
    if ((ahora - info.inicio) < CFG.LOCK_MAX_DURACION_MS) return String(info.fn || 'otra ejecucion');
  } catch (e) { /* propiedad corrupta: se ignora */ }
  return '';
}

/** Nombre legible (para el admin) de la tarea que tiene el candado. Los nombres en mayúsculas son los que deja _refrescarLockEjecucion() en las cadenas por tandas. */
function _webActRosterNombreTarea_(fn) {
  var nombres = {
    runGuerra: 'la actualización de guerra',
    runGuerraCola: 'el respaldo de guerra',
    runGuerraRapido: 'la actualización rápida de guerra',
    RUNGUERRARAPIDO: 'la actualización rápida de guerra',
    runUpdate: 'la actualización periódica',
    RUNUPDATE: 'la actualización periódica',
    runAll: 'la actualización completa',
    RUNALL: 'la actualización completa',
    runPendientesYMensajes: 'Pendientes y Mensajes',
    ACTROSTER: 'otra actualización manual'
  };
  return nombres[fn] || ('otra tarea (' + String(fn) + ')');
}

/** 'dd/MM/yyyy HH:mm:ss' en hora de Lima. */
function _webActRosterFechaLima_(ms) {
  return Utilities.formatDate(new Date(ms), 'America/Lima', 'dd/MM/yyyy HH:mm:ss');
}

// ---------------------------------------------------------------------------
// Cierre de la solicitud
// ---------------------------------------------------------------------------

// §PF180: borra las cachés de 60 s que lee Ingresos recientes (webIngresosRecientes y webRoster) al terminar la cadena en 'ok'. §PF181: con tipo 'mensajes' borra en cambio las de webAdminContenido de las categorías generadas (Mensaje de Guerra, Celular, Etiqueta de miembro). Nunca lanza error.
function _webActRosterInvalidarCachesWeb_(tipo) {
  try {
    var claves = WEB_ACTROSTER_CACHES_A_BORRAR;
    if (_webActRosterTipo_(tipo) === 'mensajes') {
      claves = TIEMPOS_CATEGORIAS_MENSAJES_GENERADOS.map(function (c) { return 'web_admin_contenido_v1_' + c; });
    }
    CacheService.getScriptCache().removeAll(claves);
  } catch (e) {
    Logger.log('[ActRoster] No se pudieron borrar las caches web: ' + e.message);
  }
}

/** Cierra la solicitud con un estado final ('ok', 'omitido', 'error'), la guarda y la deja en el registro. */
function _webActRosterCerrar_(est, estado, mensaje) {
  est.finTs = Date.now();
  est.estado = estado;
  est.mensaje = mensaje;
  _webActRosterGuardarEstado_(est);
  Logger.log('[ActRoster] FIN de la solicitud ' + est.id + ' -> ' + estado + (est.inicioTs ? ' (' + Math.round((est.finTs - est.inicioTs) / 1000) + ' s).' : ' (no llegó a ejecutarse).'));
}

/** Borra el avance y los disparadores de la cadena; con liberarCandado=true libera también el candado global, pero SOLO si es de esta cadena. */
function _webActRosterLimpiarCadena_(liberarCandado) {
  var props = PropertiesService.getScriptProperties();
  props.deleteProperty(WEB_ACTROSTER_ID_TANDAS + '_PASO');
  props.deleteProperty(WEB_ACTROSTER_ID_TANDAS + '_REINTENTO');
  try {
    _borrarTriggersDeContinuacion(WEB_ACTROSTER_HANDLER);
    _borrarTriggersDeContinuacion(WEB_ACTROSTER_HANDLER_CONTINUAR);
  } catch (e) { /* sin accion */ }
  if (liberarCandado) {
    var info = _webActRosterInfoCandado_();
    if (info && info.fn === WEB_ACTROSTER_ID_TANDAS) _liberarLockEjecucion();
  }
}


// --- ARCHIVO: 42_Web_TiemposActualizacion.gs ---
// 42_Web_TiemposActualizacion.gs
// Horas de actualización que debe mostrar la web (creado 05-oct-2026, pedido del usuario). [→ Contexto_Base_Web.md §42B001]
//
// Qué horas hay (web, API de clanes, mensajes), objeto de _tiemposActualizacionWeb_(), función manual y AVISOS ABIERTOS (4 pendientes de definir). [→ Contexto_Base_Web.md §42B002]

// ORDEN DE ESTE ARCHIVO (regla 0.9 de la skill; 27-oct-2026): primero las constantes y variables globales; luego, por partes:
//  Parte 1 — Funciones que se corren a mano
//    - Tiempos de actualización: ver en el registro
//  Parte 2 — Funciones que no se corren a mano
//    - Tiempos de actualización: registrar (los llaman la API de clanes y los mensajes)
//    - Tiempos de actualización: armar el objeto para la web
// Dentro de cada tema, en el orden en que se espera ejecutarlas. Al reordenar no se cambió el código de ninguna función.

var TIEMPOS_PROP_API = 'TIEMPOS_API_CLANES';

var TIEMPOS_PROP_MENSAJES = 'TIEMPOS_MENSAJES';

// Categorias de la hoja Mensajes que reconstruye generarTodosMensajes() (el resto sale de plantillas de Drive y su
// "hora de elaboracion" no aplica). El frontend las usa para decidir si muestra la hora junto al contenido.
var TIEMPOS_CATEGORIAS_MENSAJES_GENERADOS = ['Mensaje de Guerra', 'Celular', 'Etiqueta de miembro'];

// =============================================================================
// PARTE 1 — FUNCIONES QUE SE CORREN A MANO
// =============================================================================

// ----- Tiempos de actualización: ver en el registro -----

/** Manual: imprime el objeto completo en el log. */
function verTiemposActualizacion() {
  Logger.log(JSON.stringify(_tiemposActualizacionWeb_(), null, 2));
}

// =============================================================================
// PARTE 2 — FUNCIONES QUE NO SE CORREN A MANO
// =============================================================================

// ----- Tiempos de actualización: registrar (los llaman la API de clanes y los mensajes) -----

// Registro (lo llaman el bot, nunca la web)

// Registra la consulta a la API de clanes; nunca lanza error. [→ Contexto_Base_Web.md §42B003]
function _registrarConsultaApiClanes_(completa) {
  try {
    var props = PropertiesService.getScriptProperties();
    var ahora = Date.now();
    var previo = _tiemposLeerProp_(TIEMPOS_PROP_API) || {};
    var nuevo = {
      intentoTs: ahora,
      completa: completa === true,
      completaTs: completa === true ? ahora : (Number(previo.completaTs) || 0)
    };
    props.setProperty(TIEMPOS_PROP_API, JSON.stringify(nuevo));
  } catch (e) {
    Logger.log('[Tiempos] No se pudo registrar la consulta a la API: ' + e.message);
  }
}

// Registra la hora de elaboración de los mensajes; nunca lanza error. [→ Contexto_Base_Web.md §42B004]
function _registrarGeneracionMensajes_(ts, cantidad) {
  try {
    PropertiesService.getScriptProperties().setProperty(
      TIEMPOS_PROP_MENSAJES,
      JSON.stringify({ ts: Number(ts) || Date.now(), cantidad: Number(cantidad) || 0 })
    );
  } catch (e) {
    Logger.log('[Tiempos] No se pudo registrar la elaboracion de mensajes: ' + e.message);
  }
}

// ----- Tiempos de actualización: armar el objeto para la web -----

// Lectura (la usan los endpoints web)

// Arma el objeto completo de horas; nunca lanza error, deja en null lo que no pudo armar. [→ Contexto_Base_Web.md §42B005]
function _tiemposActualizacionWeb_(generadoTs) {
  var gen = Number(generadoTs) || Date.now();
  return {
    generadoTs: gen,
    generadoLima: _tiemposFechaLima_(gen),
    api: _tiemposApiWeb_(),
    mensajes: _tiemposMensajesWeb_()
  };
}

/** Bloque api.* del objeto de horas. */
function _tiemposApiWeb_() {
  var salida = {
    ultimaConsultaTs: null, ultimaConsultaLima: null,
    completa: null,
    ultimaCompletaTs: null, ultimaCompletaLima: null,
    origen: null
  };
  try {
    var reg = _tiemposLeerProp_(TIEMPOS_PROP_API);
    var intento = reg ? (Number(reg.intentoTs) || 0) : 0;
    var completaTs = reg ? (Number(reg.completaTs) || 0) : 0;
    var completa = reg ? (reg.completa === true) : null;
    var origen = intento ? 'registro' : null;

    // Respaldo mientras no haya registro: hora del checkpoint de clanes en Drive (solo existe si la ultima captura
    // fue completa y no lo borro runAll()/runUpdate()).
    if (!intento && typeof _leerProgresoClanesConEdad_ === 'function') {
      var cp = _leerProgresoClanesConEdad_();
      if (cp && cp.ts > 0) {
        intento = cp.ts;
        completaTs = cp.ts;
        completa = true;
        origen = 'respaldo';
      }
    }

    if (intento) {
      salida.ultimaConsultaTs = intento;
      salida.ultimaConsultaLima = _tiemposFechaLima_(intento);
      salida.completa = completa;
      salida.origen = origen;
    }
    if (completaTs) {
      salida.ultimaCompletaTs = completaTs;
      salida.ultimaCompletaLima = _tiemposFechaLima_(completaTs);
    }
  } catch (e) {
    Logger.log('[Tiempos] No se pudo leer la hora de la API: ' + e.message);
  }
  return salida;
}

/** Bloque mensajes.* del objeto de horas. Se usa tambien en _webAdminContenido() (37_Web_API.gs). */
function _tiemposMensajesWeb_() {
  var salida = { generadosTs: null, generadosLima: null, cantidad: null, origen: null };
  try {
    var reg = _tiemposLeerProp_(TIEMPOS_PROP_MENSAJES);
    var ts = reg ? (Number(reg.ts) || 0) : 0;
    var cantidad = reg ? (Number(reg.cantidad) || 0) : null;
    var origen = ts ? 'registro' : null;

    // Respaldo mientras no haya registro: columna Fecha de la primera fila de la hoja Mensajes (todas las filas de una
    // misma generacion llevan la misma hora).
    if (!ts && typeof MC !== 'undefined' && typeof CFG !== 'undefined' && CFG.SHEETS && CFG.SHEETS.MENSAJES) {
      var sh = _getSs().getSheetByName(CFG.SHEETS.MENSAJES);
      if (sh && sh.getLastRow() >= 2) {
        var v = sh.getRange(2, MC.FECHA).getValue();
        if (v instanceof Date && !isNaN(v.getTime())) {
          ts = v.getTime();
          origen = 'respaldo';
        }
      }
    }

    if (ts) {
      salida.generadosTs = ts;
      salida.generadosLima = _tiemposFechaLima_(ts);
      salida.cantidad = cantidad;
      salida.origen = origen;
    }
  } catch (e) {
    Logger.log('[Tiempos] No se pudo leer la hora de los mensajes: ' + e.message);
  }
  return salida;
}

/** true si la categoria es de las que reconstruye generarTodosMensajes() (la hora de elaboracion le aplica). */
function _tiemposCategoriaEsGenerada_(categoria) {
  return TIEMPOS_CATEGORIAS_MENSAJES_GENERADOS.indexOf(String(categoria || '').trim()) !== -1;
}

// Helpers internos

function _tiemposLeerProp_(nombre) {
  try {
    var raw = PropertiesService.getScriptProperties().getProperty(nombre);
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    Logger.log('[Tiempos] Propiedad ' + nombre + ' ilegible, se ignora: ' + e.message);
    return null;
  }
}

/** 'dd/MM/yyyy HH:mm:ss' en hora de Lima; null si ms no es una hora valida. */
function _tiemposFechaLima_(ms) {
  var n = Number(ms);
  if (!n || n <= 0) return null;
  return Utilities.formatDate(new Date(n), 'America/Lima', 'dd/MM/yyyy HH:mm:ss');
}


// --- ARCHIVO: 43_Menu_Dinamico.gs ---
// 43_Menu_Dinamico.gs
// Índice de contenido del bot y del panel web (reemplaza la hoja Menú): Docs de Drive (Estático) + Información sobre el clan y Mensajes (Dinámico); se guarda en Drive y caché. [→ Contexto_Base_Web.md §43B001]

// ORDEN DE ESTE ARCHIVO (regla 0.9 de la skill; 27-oct-2026): primero las constantes y variables globales; luego, por partes:
//  Parte 1 — Funciones que se corren a mano
//    - Menú dinámico: refrescar, sincronizar plantillas y reconstruir el índice
//  Parte 2 — Funciones que no se corren a mano
//    - Menú dinámico: actualizar
//    - Índice de contenido: actualizar, reconstruir, leer y guardar
//    - Índice de contenido: entradas estáticas, dinámicas y orden
// Dentro de cada tema, en el orden en que se espera ejecutarlas. Al reordenar no se cambió el código de ninguna función.

// ==============================================================================
// ÍNDICE DE CONTENIDO
// ------------------------------------------------------------------------------
// Dónde vive el índice (caché 6 h → Indice_Contenido.json en Drive → reconstrucción) y qué entradas guarda; ver AVISOS ABIERTOS / FASE B en 09_API_ClashRoyale.gs. [→ Contexto_Base_Web.md §43B009]
// ==============================================================================
var INDICE_CONTENIDO_FILE       = 'Indice_Contenido.json';

var INDICE_CONTENIDO_CACHE_META = 'IDX_CONT_META';

var INDICE_CONTENIDO_CACHE_TTL  = 21600; // 6 h, máximo de CacheService

var INDICE_CONTENIDO_CHUNK      = 24000; // caracteres por parte (peor caso UTF-8: 96 KB)

// =============================================================================
// PARTE 1 — FUNCIONES QUE SE CORREN A MANO
// =============================================================================

// ----- Menú dinámico: refrescar, sincronizar plantillas y reconstruir el índice -----

// Wrapper manual: refresca el índice con syncPlantillasDesdeDrive() y _actualizarMenuDinamico(); ya no escribe ninguna hoja. [→ Contexto_Base_Web.md §43B002]
function actualizarMenuSheet() {
  syncPlantillasDesdeDrive();
  _actualizarMenuDinamico();
}

// ---------------------------------------------------------------------------
// Sincronización de plantillas desde Drive (carpeta raíz + 5 subcarpetas) al índice; nombre de Doc "Categoría - Subcategoría - Clan"; renombrado automático del formato antiguo. [→ Contexto_Base_Web.md §43B003]
// ---------------------------------------------------------------------------
function syncPlantillasDesdeDrive() {
  var ss = _getSs();

  var est = _leerEntradasEstaticasDrive(ss);
  if (!est) return;

  function clave(cat, sub, clan) { return cat + '||' + sub + '||' + clan; }
  var entradas = est.entradas;
  var orden    = est.orden;

  var totalDocsValidos = orden.length;
  if (totalDocsValidos === 0) {
    Logger.log('[Plantillas] Sin documentos válidos encontrados.');
  }

  // Preservar las entradas Dinámico ya guardadas (no se relee Mensajes aquí).
  var preservadas = _leerEntradasIndiceGuardadoPorTipo('Dinámico');
  for (var p = 0; p < preservadas.length; p++) {
    var e  = preservadas[p];
    var k2 = clave(e.categoria, e.subcategoria, e.clan);
    if (!entradas[k2]) {
      entradas[k2] = e;
      orden.push(k2);
    }
  }

  _actualizarIndiceContenido(ss, entradas, orden);
  Logger.log('[Plantillas] Sincronizados ' + totalDocsValidos + ' documentos desde Drive hacia el índice de contenido.');
}

// Manual: fuerza la reconstrucción del índice desde Drive, Clan y Mensajes (ejecutar una vez tras instalar esta versión). [→ Contexto_Base_Web.md §43B016]
function inicializarIndiceContenido() {
  var idx = _reconstruirIndiceContenido();
  Logger.log('[Índice] Listo: ' + idx.length + ' entradas.');
}

// =============================================================================
// PARTE 2 — FUNCIONES QUE NO SE CORREN A MANO
// =============================================================================

// ----- Menú dinámico: actualizar -----

// Refresca las entradas Dinámico (Mensajes + hoja Clan) preservando las Estático; se ejecuta tras runPendientesYMensajes(). [→ Contexto_Base_Web.md §43B005]
function _actualizarMenuDinamico() {
  var ss = _getSs();

  function clave(cat, sub, clan) { return cat + '||' + sub + '||' + clan; }

  var entradas = {};
  var orden    = [];

  // 1) Entradas Estático ya frescas en el índice (prioridad, igual que antes).
  var estaticas = _leerEntradasIndiceGuardadoPorTipo('Estático');
  if (estaticas.length === 0) {
    Logger.log('[Índice] No hay entradas Estático guardadas: se reconstruye todo el índice.');
    _reconstruirIndiceContenido();
    return;
  }
  for (var e0 = 0; e0 < estaticas.length; e0++) {
    var e  = estaticas[e0];
    var k0 = clave(e.categoria, e.subcategoria, e.clan);
    if (!entradas[k0]) {
      entradas[k0] = e;
      orden.push(k0);
    }
  }

  // 2) y 3) Información sobre el clan + Mensajes.
  _agregarEntradasDinamicas(ss, entradas, orden);

  _actualizarIndiceContenido(ss, entradas, orden);
}

// ----- Índice de contenido: actualizar, reconstruir, leer y guardar -----

// Núcleo compartido: ordena las entradas ya resueltas por Extra y hoja Clan y las guarda como índice (Drive + caché). [→ Contexto_Base_Web.md §43B004]
function _actualizarIndiceContenido(ss, entradas, orden) {
  if (orden.length === 0) {
    Logger.log('[Índice] Sin datos — índice sin cambios.');
    return [];
  }
  var lista = _ordenarEntradasIndice(ss, orden.map(function(k) { return entradas[k]; }));
  var indice = [];
  for (var i = 0; i < lista.length; i++) {
    var e = lista[i];
    indice.push({
      categoria:    e.categoria,
      subcategoria: e.subcategoria,
      clan:         e.clan,
      tipo:         e.tipo,
      contenido:    (e.contenido !== undefined) ? e.contenido : '',
      docId:        e.docId || ''
    });
  }
  _guardarIndiceContenido(indice);
  Logger.log('[Índice] Guardado con ' + indice.length + ' entradas.');
  return indice;
}

// Reconstruye el índice desde las fuentes reales; prioridad Estático > Información sobre el clan > Mensajes. [→ Contexto_Base_Web.md §43B013]
function _reconstruirIndiceContenido() {
  var ss = _getSs();
  var est = _leerEntradasEstaticasDrive(ss);
  if (!est) {
    Logger.log('[Índice] Sin acceso a las carpetas de Drive: no se reconstruye el índice.');
    return _leerIndiceGuardado() || [];
  }
  var entradas = est.entradas;
  var orden    = est.orden;
  _agregarEntradasDinamicas(ss, entradas, orden);
  return _actualizarIndiceContenido(ss, entradas, orden);
}

// Devuelve el índice completo: caché → Drive → reconstrucción desde las fuentes. [→ Contexto_Base_Web.md §43B010]
function _getIndiceContenido() {
  var idx = _leerIndiceContenidoDeCache();
  if (idx && idx.length) return idx;

  idx = _leerIndiceContenidoDeDrive();
  if (idx && idx.length) {
    _guardarIndiceContenidoEnCache(JSON.stringify(idx));
    return idx;
  }

  Logger.log('[Índice] No hay índice en caché ni en Drive: se reconstruye desde las fuentes.');
  return _reconstruirIndiceContenido();
}

function _leerIndiceContenidoDeCache() {
  try {
    var cache = CacheService.getScriptCache();
    var meta = cache.get(INDICE_CONTENIDO_CACHE_META);
    if (!meta) return null;
    var m = JSON.parse(meta);
    var claves = [];
    for (var i = 0; i < m.n; i++) claves.push('IDX_CONT_' + m.ts + '_' + i);
    var got = cache.getAll(claves);
    var partes = [];
    for (var j = 0; j < claves.length; j++) {
      var v = got[claves[j]];
      if (v === undefined || v === null) return null; // alguna parte venció
      partes.push(v);
    }
    return JSON.parse(partes.join(''));
  } catch (e) {
    return null;
  }
}

function _leerIndiceContenidoDeDrive() {
  try {
    var folder = DriveApp.getFolderById(DRIVE_FOLDER_ID_OTROS);
    var files = folder.getFilesByName(INDICE_CONTENIDO_FILE);
    if (!files.hasNext()) return null;
    var parsed = JSON.parse(files.next().getBlob().getDataAsString('UTF-8'));
    return (parsed && parsed.entradas instanceof Array) ? parsed.entradas : null;
  } catch (e) {
    Logger.log('[Índice] Error leyendo el índice desde Drive: ' + e.message);
    return null;
  }
}

// Devuelve el índice guardado (caché → Drive) sin reconstruir; null si no existe. [→ Contexto_Base_Web.md §43B014]
function _leerIndiceGuardado() {
  var idx = _leerIndiceContenidoDeCache();
  if (idx && idx.length) return idx;
  idx = _leerIndiceContenidoDeDrive();
  if (idx && idx.length) return idx;
  return null;
}

// Persiste el índice en Drive y caché; nunca lanza error. [→ Contexto_Base_Web.md §43B012]
function _guardarIndiceContenido(lista) {
  try {
    var folder = DriveApp.getFolderById(DRIVE_FOLDER_ID_OTROS);
    var files = folder.getFilesByName(INDICE_CONTENIDO_FILE);
    var contenido = JSON.stringify({ _ts: Date.now(), entradas: lista });
    if (files.hasNext()) {
      files.next().setContent(contenido);
      while (files.hasNext()) files.next().setTrashed(true); // duplicados
    } else {
      folder.createFile(INDICE_CONTENIDO_FILE, contenido, MimeType.PLAIN_TEXT);
    }
  } catch (e) {
    Logger.log('[Índice] Error guardando el índice en Drive: ' + e.message);
  }
  _guardarIndiceContenidoEnCache(JSON.stringify(lista));
}

function _guardarIndiceContenidoEnCache(json) {
  try {
    var cache = CacheService.getScriptCache();
    var ts = String(Date.now());
    var n = Math.max(1, Math.ceil(json.length / INDICE_CONTENIDO_CHUNK));
    var partes = {};
    for (var i = 0; i < n; i++) {
      partes['IDX_CONT_' + ts + '_' + i] = json.substr(i * INDICE_CONTENIDO_CHUNK, INDICE_CONTENIDO_CHUNK);
    }
    cache.putAll(partes, INDICE_CONTENIDO_CACHE_TTL);
    cache.put(INDICE_CONTENIDO_CACHE_META, JSON.stringify({ ts: ts, n: n }), INDICE_CONTENIDO_CACHE_TTL);
  } catch (e) {
    Logger.log('[Índice] No se pudo guardar el índice en caché: ' + e.message);
  }
}

// Entradas del índice de un tipo ('Estático' o 'Dinámico'); reconstruye el índice si no existe. [→ Contexto_Base_Web.md §43B011]
function _leerEntradasIndicePorTipo(tipo) {
  var todo = _getIndiceContenido();
  var out = [];
  for (var i = 0; i < todo.length; i++) {
    if (todo[i].tipo === tipo) out.push(todo[i]);
  }
  return out;
}

// Como _leerEntradasIndicePorTipo() pero sin reconstruir: devuelve [] si no hay índice guardado. [→ Contexto_Base_Web.md §43B015]
function _leerEntradasIndiceGuardadoPorTipo(tipo) {
  var todo = _leerIndiceGuardado() || [];
  var out = [];
  for (var i = 0; i < todo.length; i++) {
    if (todo[i].tipo === tipo) out.push(todo[i]);
  }
  return out;
}

// ----- Índice de contenido: entradas estáticas, dinámicas y orden -----

// Lee los Docs de la carpeta raíz de plantillas y subcarpetas; devuelve {entradas, orden} o null si no pudo abrir ninguna carpeta. [→ Contexto_Base_Web.md §43B017]
function _leerEntradasEstaticasDrive(ss) {
  // Carpeta raíz "Plantillas" + sus 5 subcarpetas (Torneos y sorteos, Otras,
  // Mazos, Descripciones, Bienvenidas). Una carpeta que falle al abrirse se
  // omite (con log) sin cortar el resto — ver _getCarpetasPlantillas().
  var carpetas = _getCarpetasPlantillas();
  if (carpetas.length === 0) {
    Logger.log('[Plantillas] No se pudo abrir ninguna carpeta (ni la raíz ni las subcarpetas). Se omite la sincronización.');
    return null;
  }

  // Junta los Google Docs de la raíz + las 5 subcarpetas en un solo array
  // antes de procesarlos, para que el resto de la función (parseo,
  // renombrado automático, etc.) no cambie: sigue siendo un único recorrido
  // secuencial, solo que la fuente ahora son varias carpetas en vez de una.
  var todosLosArchivos = [];
  for (var c = 0; c < carpetas.length; c++) {
    var iterArchivos = carpetas[c].getFilesByType(MimeType.GOOGLE_DOCS);
    while (iterArchivos.hasNext()) todosLosArchivos.push(iterArchivos.next());
  }

  function clave(cat, sub, clan) { return cat + '||' + sub + '||' + clan; }
  var entradas = {};
  var orden    = [];

  for (var idxArch = 0; idxArch < todosLosArchivos.length; idxArch++) {
    var f = todosLosArchivos[idxArch];
    var nombre = f.getName();

    // Detectar y migrar formato antiguo "Clan - Categoría" (exactamente 1 separador " - ")
    var partes = nombre.split(' - ');
    if (partes.length === 2) {
      // Formato antiguo: intentar renombrar buscando subcategoría en el índice
      var nuevoNombre = _renombrarDocFormatoAntiguo(ss, f, partes[0].trim(), partes[1].trim());
      if (nuevoNombre) {
        nombre = nuevoNombre;
        partes = nombre.split(' - ');
      }
    }

    if (partes.length < 3) {
      Logger.log('[Plantillas] Ignorado (no cumple estructura "Categoría - Subcategoría - Clan"): ' + nombre);
      continue;
    }

    var categoria    = partes[0].trim();
    var subcategoria = partes[1].trim();
    var clan         = partes.slice(2).join(' - ').trim(); // por si el clan tiene " - "

    if (!categoria || !subcategoria || !clan) {
      Logger.log('[Plantillas] Ignorado (parte vacía): ' + nombre);
      continue;
    }

    var contenido = '';
    try {
      var docPlantilla = DocumentApp.openById(f.getId());
      // PF186 (23-oct-2026, pedido de la usuaria): en los Docs de Bienvenida y Descripción, el bloque Líder / Colíderes / Administradores se reescribe con los datos reales de Directorio antes de leer el texto; solo se guarda el Doc si algo cambió. [→ Contexto_Base_Web.md §PF186]
      try {
        if (_adminDocActualizar_(docPlantilla, categoria, clan)) {
          docPlantilla.saveAndClose();
          docPlantilla = DocumentApp.openById(f.getId());
        }
      } catch (eAdm) {
        Logger.log('[Plantillas] No se pudo actualizar la administración de "' + nombre + '": ' + eAdm.message);
      }
      contenido = docPlantilla.getBody().getText().trim();
    } catch(e2) {
      Logger.log('[Plantillas] Error leyendo "' + nombre + '": ' + e2.message);
      continue;
    }
    if (!contenido) continue;

    // Prioridad: el primer Doc de una misma clave gana; se guardan contenido y docId (permite al panel web armar el link de exportación a PDF). [→ Contexto_Base_Web.md §43B018]
    var k = clave(categoria, subcategoria, clan);
    if (!entradas[k]) {
      entradas[k] = { categoria: categoria, subcategoria: subcategoria, clan: clan, tipo: 'Estático', contenido: contenido, docId: f.getId() };
      orden.push(k);
    }
  }

  return { entradas: entradas, orden: orden };
}

// Intenta renombrar un Doc de formato antiguo "Clan - Categoría" a "Categoría - Subcategoría - Clan"; devuelve el nombre nuevo o null. [→ Contexto_Base_Web.md §43B006]
function _renombrarDocFormatoAntiguo(ss, file, clan, categoria) {
  var catNorm  = categoria.trim().toLowerCase();
  var clanNorm = clan.trim().toLowerCase();
  var subcategoria = null;

  // 1. Intentar buscar en el índice guardado (sin reconstruir: esta función corre DENTRO de la lectura
  // de Drive que usa la reconstrucción del índice).
  var guardado = _leerIndiceGuardado() || [];
  for (var i = 0; i < guardado.length; i++) {
    if (String(guardado[i].categoria || '').trim().toLowerCase() === catNorm &&
        String(guardado[i].clan || '').trim().toLowerCase() === clanNorm) {
      subcategoria = String(guardado[i].subcategoria || '').trim();
      break;
    }
  }

  // 2. Fallback: mapa estático basado en la estructura conocida del sistema
  //    Clan específico → Subcategoría = 'Particular'
  //    Clan familia/comunidad → Subcategoría según Categoría
  if (!subcategoria) {
    var CLANES_PARTICULARES = [
      'grupo乂terna™', 'grupoxterna™2', 'grupoxterna™3', 'mini乂ternas™'
    ];
    var CLANES_COMUNIDAD = [
      'ᴳ乂ᵀ ⚜️ familia terna', 'familia terna'
    ];
    var MAPA_SUBCATEGORIA_FALLBACK = {
      'bienvenida':          { particular: 'Particular', comunidad: 'Particular' },
      'descripción':         { particular: 'Particular', comunidad: 'Chat General',
                               comunidades: { 'Comunidad': true, 'Detectives': true, 'RoyaleAPI': true } },
      'defensas de barcos':  { particular: 'Comunidad', comunidad: 'Comunidad' },
      'día de guerra':       { particular: 'Comunidad', comunidad: 'Comunidad' },
      'etiqueta de miembro': { particular: 'Particular', comunidad: 'Comunidad' },
      'celular':             { particular: 'Particular', comunidad: 'Chat General' },
      'mensaje de guerra':   { particular: 'Particular', comunidad: 'Chat General' },
      'información del clan':{ particular: 'Terna',      comunidad: 'Vetado' },
      'información sobre mí':{ particular: 'Terna',      comunidad: 'Terna' },
    };

    var esParticular = CLANES_PARTICULARES.indexOf(clanNorm) >= 0;
    var entrada = MAPA_SUBCATEGORIA_FALLBACK[catNorm];
    if (entrada) {
      subcategoria = esParticular ? entrada.particular : entrada.comunidad;
    }
    // Para Descripción con subcategorías múltiples, intentar inferir por nombre del clan
    if (catNorm === 'descripción' && !esParticular) {
      var clanLow = clanNorm;
      if (clanLow.indexOf('detective') >= 0)      subcategoria = 'Detectives';
      else if (clanLow.indexOf('royale') >= 0)    subcategoria = 'RoyaleAPI';
      else if (clanLow.indexOf('comunidad') >= 0) subcategoria = 'Comunidad';
      else                                         subcategoria = 'Chat General';
    }
  }

  if (!subcategoria) {
    Logger.log('[Plantillas] No se pudo determinar subcategoría para renombrar: "' + clan + ' - ' + categoria + '"');
    return null;
  }

  var nuevoNombre = categoria + ' - ' + subcategoria + ' - ' + clan;
  try {
    file.setName(nuevoNombre);
    Logger.log('[Plantillas] Renombrado: "' + clan + ' - ' + categoria + '" → "' + nuevoNombre + '"');
    return nuevoNombre;
  } catch(e) {
    Logger.log('[Plantillas] Error al renombrar "' + file.getName() + '": ' + e.message);
    return null;
  }
}

// Agrega las entradas Dinámico (Información sobre el clan y Mensajes) a entradas/orden sin pisar claves ya presentes. [→ Contexto_Base_Web.md §43B019]
function _agregarEntradasDinamicas(ss, entradas, orden) {
  function clave(cat, sub, clan) { return cat + '||' + sub + '||' + clan; }

  // Paso 2: Información sobre el clan se construye directo desde la hoja Clan (hasta el 19/08/2026 lo armaba generarTodosMensajes()). [→ Contexto_Base_Web.md §43B020]
  var clanOrdenInfo        = _getOrdenClanHoja(ss);
  var nombresClanTernaInfo = _getNombresClanesOrdenados(ss, clanOrdenInfo);
  var dataClanInfo         = _getDatosClanHoja(ss);
  for (var ci1 = 0; ci1 < nombresClanTernaInfo.length; ci1++) {
    var clanNombreInfo = nombresClanTernaInfo[ci1];
    var infoClan = dataClanInfo[clanNombreInfo.toLowerCase()];
    if (!infoClan) continue;
    var k1 = clave('Información sobre el clan', infoClan.subcategoria || 'Terna', clanNombreInfo);
    if (!entradas[k1]) {
      entradas[k1] = {
        categoria:    'Información sobre el clan',
        subcategoria: infoClan.subcategoria || 'Terna',
        clan:         clanNombreInfo,
        tipo:         'Dinámico',
        contenido:    _formatearInfoClan(infoClan)
      };
      orden.push(k1);
    }
  }

  // Paso 3: Mensajes fresco → Dinámico solo si la clave no está cubierta; FIX 28-sep-2026: el contenido se lee con MC (Mensajes pasó a 15 columnas) en vez de índice fijo. [→ Contexto_Base_Web.md §43B021]
  var shMsg = ss.getSheetByName(CFG.SHEETS.MENSAJES);
  if (shMsg && shMsg.getLastRow() >= 2) {
    var dataMsg = shMsg.getRange(2, 1, shMsg.getLastRow() - 1, MENSAJES_TOTAL_COLS).getValues();
    for (var j = 0; j < dataMsg.length; j++) {
      var cat2  = String(dataMsg[j][MC.CATEGORIA    - 1] || '').trim();
      var sub2  = String(dataMsg[j][MC.SUBCATEGORIA - 1] || '').trim();
      var clan2 = String(dataMsg[j][MC.CLAN         - 1] || '').trim();
      var cont2 = String(dataMsg[j][MC.CONTENIDO    - 1] || '').trim();
      if (!cat2 || !sub2 || !clan2) continue;
      var k2 = clave(cat2, sub2, clan2);
      if (!entradas[k2]) {
        entradas[k2] = { categoria: cat2, subcategoria: sub2, clan: clan2, tipo: 'Dinámico', contenido: cont2 };
        orden.push(k2);
      }
    }
  }

}

// Ordena una lista de entradas por Extra (Categoría → Subcategoría) y hoja Clan; devuelve la misma lista ordenada. [→ Contexto_Base_Web.md §43B022]
function _ordenarEntradasIndice(ss, lista) {
  var categoriaOrden    = _getOrdenExtra(ss, 'categoria');
  var subcategoriaOrden = _getOrdenExtra(ss, 'subcategoria');
  var clanOrden         = _getOrdenClanHoja(ss);

  // Ordenar respetando Extra (Categoría → Subcategoría) y hoja Clan
  lista.sort(function(a, b) {
    var oCatA = categoriaOrden[a.categoria.toLowerCase()];
    var oCatB = categoriaOrden[b.categoria.toLowerCase()];
    if (oCatA === undefined) oCatA = 9999;
    if (oCatB === undefined) oCatB = 9999;
    if (oCatA !== oCatB) return oCatA - oCatB;

    var oSubA = subcategoriaOrden[a.subcategoria.toLowerCase()];
    var oSubB = subcategoriaOrden[b.subcategoria.toLowerCase()];
    if (oSubA === undefined) oSubA = 9999;
    if (oSubB === undefined) oSubB = 9999;
    if (oSubA !== oSubB) return oSubA - oSubB;

    var oClanA = clanOrden[a.clan.toLowerCase()];
    var oClanB = clanOrden[b.clan.toLowerCase()];
    if (oClanA === undefined) oClanA = 9999;
    if (oClanB === undefined) oClanB = 9999;
    return oClanA - oClanB;
  });
  return lista;
}

// Lee la hoja Extra y devuelve { valorLower -> índice } para 'categoria' o 'subcategoria'. [→ Contexto_Base_Web.md §43B007]
function _getOrdenExtra(ss, tipo) {
  var sh = ss.getSheetByName(CFG.SHEETS.EXTRA);
  var mapa = {};
  if (!sh || sh.getLastRow() < 2) return mapa;
  var colIdx = (tipo === 'subcategoria') ? 12 : 11; // 0-based
  var data = sh.getRange(2, 1, sh.getLastRow() - 1, 13).getValues();
  var orden = 0;
  for (var i = 0; i < data.length; i++) {
    var v = String(data[i][colIdx] || '').trim();
    if (v && mapa[v.toLowerCase()] === undefined) {
      mapa[v.toLowerCase()] = orden++;
    }
  }
  return mapa;
}

// Lee la hoja Clan y devuelve { nombreClanLower -> índice } según el orden de filas. [→ Contexto_Base_Web.md §43B008]
function _getOrdenClanHoja(ss) {
  var sh = ss.getSheetByName(CFG.SHEETS.CLAN);
  var mapa = {};
  if (!sh || sh.getLastRow() < 2) return mapa;
  var data = sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues();
  for (var i = 0; i < data.length; i++) {
    var v = String(data[i][2] || '').trim();
    if (v) mapa[v.toLowerCase()] = i;
  }
  return mapa;
}


