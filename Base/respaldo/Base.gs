  CARPETA_HISTORIAL_ID: '1T8PhxVVRZ-p7o2A_U6ARP-LsC3Zg7ObL',
  CARPETA_INFORMES_ID: '17Mv2oQFTMIdSKlGyHNnrBiApYoHfHg4X',
  ARCHIVO_BACKUP: 'Backup_Guerra.csv',
