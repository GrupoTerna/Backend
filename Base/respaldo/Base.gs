    var der = grupo(derIdx, cats);
    var mej = null;
    var clavesIzq = Object.keys(izq);
    for (var w = 0; w < clavesIzq.length; w++) {
      var li = izq[clavesIzq[w]];
      var rd = der[(A - li.a) + ',' + (B - li.b) + ',' + (F - li.f)];
      if (!rd) continue;
